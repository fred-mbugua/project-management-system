# SaaS PM & ERP - Environment Configuration
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# Application
NODE_ENV=development
PORT=3000
APP_NAME=""
APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=""

# Session
SESSION_SECRET=pm-erp-super-secret-session-key-change-in-production-2026
SESSION_MAX_AGE=86400000

# JWT (for API tokens & client portal links)
JWT_SECRET=pm-erp-jwt-secret-key-change-in-production-2026
JWT_EXPIRES_IN=24h

# Safaricom Daraja API (Platform-Level - Super Admin Billing)
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=your_platform_consumer_key
DARAJA_CONSUMER_SECRET=your_platform_consumer_secret
DARAJA_PASSKEY=your_platform_passkey
DARAJA_SHORTCODE=174379
DARAJA_SHORTCODE_TYPE=PAYBILL
DARAJA_CALLBACK_URL=http://localhost:3000/api/mpesa/callback

# Email (Nodemailer - SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=""

# SMS (Africa's Talking)
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=sandbox
AT_SENDER_ID=PMERP

# Redis (BullMQ Job Queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# File Uploads
UPLOAD_DIR=public/uploads
MAX_FILE_SIZE=10485760

# Encryption Key (for tenant Daraja credentials at rest)
ENCRYPTION_KEY=pm-erp-aes-256-encryption-key-change-me
ENCRYPTION_IV=pm-erp-iv-16bytes
