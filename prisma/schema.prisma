// ══════════════════════════════════════════════════════════════════════
// PM & ERP SaaS - Multi-Tenant Database Schema
// PostgreSQL with Prisma ORM - Strict Row-Level Tenant Isolation
// ══════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  TENANT_OWNER
  PROJECT_MANAGER
  ACCOUNTANT
  TEAM_MEMBER
  CLIENT_PORTAL
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  BLOCKED
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  VOID
}

enum PaymentMethod {
  MPESA_STK
  MPESA_C2B
  MPESA_B2C
  BANK_TRANSFER
  CASH
  CHEQUE
  CARD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum TaxType {
  VAT_16
  ZERO_RATED
  EXEMPT
  WITHHOLDING_3
  WITHHOLDING_5
  CUSTOM
}

enum ExpenseCategory {
  MATERIALS
  LABOUR
  TRANSPORT
  EQUIPMENT
  SUBCONTRACTOR
  UTILITIES
  OFFICE
  MARKETING
  INSURANCE
  LICENSE_PERMITS
  MISCELLANEOUS
}

enum MaintenanceFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  BIANNUAL
  ANNUAL
}

enum MaintenanceStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum SubscriptionTier {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIAL
}

enum DarajaShortcodeType {
  PAYBILL
  TILL
}

enum PayoutType {
  SALARY
  WAGE
  EXPENSE_CLAIM
  BONUS
  COMMISSION
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PAYMENT
  EXPORT
  IMPORT
  SETTINGS_CHANGE
}

// ──────────────────────────────────────────────
// PLATFORM-LEVEL MODELS
// ──────────────────────────────────────────────

model SubscriptionPlan {
  id                String             @id @default(uuid())
  name              String             // e.g. "Starter", "Professional", "Enterprise"
  tier              SubscriptionTier
  monthlyPrice      Decimal            @db.Decimal(12, 2)
  annualPrice       Decimal            @db.Decimal(12, 2)
  maxUsers          Int
  maxProjects       Int
  maxStorageMb      Int                @default(500)
  features          Json?              // Feature flags JSON
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  subscriptions     TenantSubscription[]

  @@map("subscription_plans")
}

// ──────────────────────────────────────────────
// TENANT & USER MODELS
// ──────────────────────────────────────────────

model Tenant {
  id                  String              @id @default(uuid())
  name                String              // Company name
  slug                String              @unique // URL-safe identifier
  email               String
  phone               String?
  address             String?
  city                String?
  country             String              @default("Kenya")

  // KRA Tax Details
  kraPin              String?             // KRA PIN (e.g. P051234567X)
  vatRegistered       Boolean             @default(false)
  defaultTaxType      TaxType             @default(VAT_16)

  // Branding
  logoUrl             String?
  primaryColor        String              @default("#4F46E5")  // Indigo
  secondaryColor      String              @default("#1E293B")  // Slate
  accentColor         String              @default("#06B6D4")  // Cyan

  // Invoice Configuration
  invoicePrefix       String              @default("INV")
  quotePrefix         String              @default("QUO")
  invoiceNotes        String?             // Default footer notes
  paymentTerms        String?             // e.g. "Net 30"
  bankDetails         String?             // Bank account details text

  // Daraja M-Pesa Configuration (Tenant-Level)
  darajaConsumerKey   String?
  darajaConsumerSecret String?
  darajaPasskey       String?
  darajaShortcode     String?
  darajaShortcodeType DarajaShortcodeType @default(PAYBILL)
  darajaEnvironment   String              @default("sandbox")

  // Status
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  // Relations
  users               User[]
  clients             Client[]
  projects            Project[]
  quotations          Quotation[]
  invoices            Invoice[]
  payments            Payment[]
  expenses            Expense[]
  teamPayouts         TeamPayout[]
  maintenanceSchedules MaintenanceSchedule[]
  auditLogs           AuditLog[]
  subscription        TenantSubscription?
  tasks               Task[]

  @@map("tenants")
}

model TenantSubscription {
  id              String             @id @default(uuid())
  tenantId        String             @unique
  planId          String
  status          SubscriptionStatus @default(TRIAL)
  billingCycle    String             @default("monthly") // "monthly" | "annual"
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  autoRenew       Boolean            @default(true)
  mpesaReceiptNo  String?            // Last subscription payment receipt
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan            SubscriptionPlan   @relation(fields: [planId], references: [id])

  @@map("tenant_subscriptions")
}

model User {
  id              String      @id @default(uuid())
  tenantId        String?     // Null for SUPER_ADMIN
  email           String      @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  nationalId      String?     // Kenyan National ID
  role            UserRole    @default(TEAM_MEMBER)

  // Team/Contractor Payment Details
  mpesaNumber     String?     // M-Pesa registered number for B2C payouts
  bankName        String?
  bankAccount     String?
  hourlyRate      Decimal?    @db.Decimal(10, 2)
  fixedRate       Decimal?    @db.Decimal(12, 2) // Per-project fixed rate

  avatarUrl       String?
  isActive        Boolean     @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  tenant          Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedTasks   Task[]      @relation("TaskAssignee")
  projectMembers  ProjectMember[]
  payouts         TeamPayout[]
  auditLogs       AuditLog[]

  @@index([tenantId])
  @@map("users")
}

// ──────────────────────────────────────────────
// CLIENT MODELS
// ──────────────────────────────────────────────

model Client {
  id              String      @id @default(uuid())
  tenantId        String
  name            String      // Company or individual name
  contactPerson   String?
  email           String?
  phone           String?
  address         String?
  city            String?
  country         String      @default("Kenya")
  kraPin          String?     // Client's KRA PIN
  notes           String?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projects        Project[]
  quotations      Quotation[]
  invoices        Invoice[]
  maintenanceSchedules MaintenanceSchedule[]

  @@index([tenantId])
  @@map("clients")
}

// ──────────────────────────────────────────────
// PROJECT MODELS
// ──────────────────────────────────────────────

model Project {
  id              String          @id @default(uuid())
  tenantId        String
  clientId        String?
  name            String
  code            String          // e.g. "PRJ-001"
  description     String?
  status          ProjectStatus   @default(PLANNING)
  budget          Decimal?        @db.Decimal(14, 2)
  startDate       DateTime?
  endDate         DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client          Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tasks           Task[]
  members         ProjectMember[]
  quotations      Quotation[]
  invoices        Invoice[]
  expenses        Expense[]
  maintenanceSchedules MaintenanceSchedule[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("projects")
}

model ProjectMember {
  id              String      @id @default(uuid())
  projectId       String
  userId          String
  roleInProject   String?     // e.g. "Lead Engineer", "Electrician"
  rateType        String      @default("hourly") // "hourly" | "fixed"
  rate            Decimal?    @db.Decimal(10, 2)
  joinedAt        DateTime    @default(now())

  // Relations
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Task {
  id              String       @id @default(uuid())
  tenantId        String
  projectId       String
  assignedToId    String?
  title           String
  description     String?
  status          TaskStatus   @default(TODO)
  priority        TaskPriority @default(MEDIUM)
  estimatedHours  Decimal?     @db.Decimal(8, 2)
  actualHours     Decimal?     @db.Decimal(8, 2)
  dueDate         DateTime?
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo      User?        @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([projectId])
  @@map("tasks")
}

// ──────────────────────────────────────────────
// QUOTATION MODELS
// ──────────────────────────────────────────────

model Quotation {
  id              String            @id @default(uuid())
  tenantId        String
  clientId        String
  projectId       String?
  quotationNumber String            // e.g. "QUO-2026-0001"
  title           String?
  status          QuotationStatus   @default(DRAFT)
  issueDate       DateTime          @default(now())
  validUntil      DateTime
  subtotal        Decimal           @db.Decimal(14, 2) @default(0)
  taxAmount       Decimal           @db.Decimal(14, 2) @default(0)
  discountAmount  Decimal           @db.Decimal(14, 2) @default(0)
  totalAmount     Decimal           @db.Decimal(14, 2) @default(0)
  notes           String?
  terms           String?
  convertedInvoiceId String?        // Links to generated invoice
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project         Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items           QuotationItem[]

  @@unique([tenantId, quotationNumber])
  @@index([tenantId])
  @@map("quotations")
}

model QuotationItem {
  id              String      @id @default(uuid())
  quotationId     String
  description     String
  quantity        Decimal     @db.Decimal(10, 2) @default(1)
  unitPrice       Decimal     @db.Decimal(12, 2)
  discountPercent Decimal     @db.Decimal(5, 2) @default(0)
  taxType         TaxType     @default(VAT_16)
  taxRate         Decimal     @db.Decimal(5, 2) @default(16)
  lineTotal       Decimal     @db.Decimal(14, 2)
  lineTax         Decimal     @db.Decimal(14, 2) @default(0)
  sortOrder       Int         @default(0)

  // Relations
  quotation       Quotation   @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_items")
}

// ──────────────────────────────────────────────
// INVOICE MODELS
// ──────────────────────────────────────────────

model Invoice {
  id              String          @id @default(uuid())
  tenantId        String
  clientId        String
  projectId       String?
  quotationId     String?         // Source quotation if converted
  invoiceNumber   String          // e.g. "INV-2026-0001"
  title           String?
  status          InvoiceStatus   @default(DRAFT)
  issueDate       DateTime        @default(now())
  dueDate         DateTime
  subtotal        Decimal         @db.Decimal(14, 2) @default(0)
  taxAmount       Decimal         @db.Decimal(14, 2) @default(0)
  discountAmount  Decimal         @db.Decimal(14, 2) @default(0)
  totalAmount     Decimal         @db.Decimal(14, 2) @default(0)
  amountPaid      Decimal         @db.Decimal(14, 2) @default(0)
  balanceDue      Decimal         @db.Decimal(14, 2) @default(0)
  notes           String?
  terms           String?
  template        String          @default("modern") // "modern" | "classic" | "minimalist" | "corporate"

  // KRA / eTIMS Compliance
  etimsVerificationHash String?   // SHA-256 hash for eTIMS verification
  etimsQrPayload       String?   // QR code data payload
  tenantKraPin         String?   // Snapshot of tenant KRA PIN at time of issue
  clientKraPin         String?   // Snapshot of client KRA PIN at time of issue

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items           InvoiceItem[]
  payments        Payment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id              String      @id @default(uuid())
  invoiceId       String
  description     String
  quantity        Decimal     @db.Decimal(10, 2) @default(1)
  unitPrice       Decimal     @db.Decimal(12, 2)
  discountPercent Decimal     @db.Decimal(5, 2) @default(0)
  taxType         TaxType     @default(VAT_16)
  taxRate         Decimal     @db.Decimal(5, 2) @default(16)
  lineTotal       Decimal     @db.Decimal(14, 2)
  lineTax         Decimal     @db.Decimal(14, 2) @default(0)
  sortOrder       Int         @default(0)

  // Relations
  invoice         Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

// ──────────────────────────────────────────────
// PAYMENT MODELS
// ──────────────────────────────────────────────

model Payment {
  id                  String          @id @default(uuid())
  tenantId            String
  invoiceId           String
  amount              Decimal         @db.Decimal(14, 2)
  paymentMethod       PaymentMethod   @default(MPESA_STK)
  status              PaymentStatus   @default(PENDING)
  paymentDate         DateTime        @default(now())

  // M-Pesa Specific Fields
  mpesaReceiptNumber  String?         @unique // Daraja TransID - unique constraint for idempotency
  mpesaPhoneNumber    String?
  mpesaTransactionDate String?
  mpesaCheckoutRequestId String?      // STK Push CheckoutRequestID
  mpesaMerchantRequestId String?      // STK Push MerchantRequestID

  // General Payment Fields
  referenceNumber     String?         // Bank ref, cheque number, etc.
  notes               String?
  rawCallbackData     Json?           // Full Daraja callback JSON for audit

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  // Relations
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice             Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@map("payments")
}

// ──────────────────────────────────────────────
// EXPENSE MODELS
// ──────────────────────────────────────────────

model Expense {
  id              String            @id @default(uuid())
  tenantId        String
  projectId       String?
  category        ExpenseCategory   @default(MISCELLANEOUS)
  description     String
  amount          Decimal           @db.Decimal(14, 2)
  vatAmount       Decimal           @db.Decimal(14, 2) @default(0)
  taxDeductible   Boolean           @default(false)
  billable        Boolean           @default(false)
  receiptUrl      String?
  expenseDate     DateTime          @default(now())
  vendor          String?
  referenceNo     String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project         Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([projectId])
  @@map("expenses")
}

// ──────────────────────────────────────────────
// TEAM PAYOUT MODELS
// ──────────────────────────────────────────────

model TeamPayout {
  id                    String          @id @default(uuid())
  tenantId              String
  userId                String
  amount                Decimal         @db.Decimal(14, 2)
  payoutType            PayoutType      @default(SALARY)
  paymentMethod         PaymentMethod   @default(MPESA_B2C)
  status                PayoutStatus    @default(PENDING)
  payoutDate            DateTime        @default(now())

  // M-Pesa B2C Fields
  mpesaConversationId   String?
  mpesaOriginatorConversationId String?
  mpesaTransactionId    String?
  mpesaRecipientNumber  String?

  // General Fields
  referenceNumber       String?
  description           String?
  rawResponseData       Json?

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Relations
  tenant                Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("team_payouts")
}

// ──────────────────────────────────────────────
// MAINTENANCE SCHEDULE MODELS
// ──────────────────────────────────────────────

model MaintenanceSchedule {
  id              String                @id @default(uuid())
  tenantId        String
  projectId       String?
  clientId        String
  title           String
  description     String?
  frequency       MaintenanceFrequency  @default(MONTHLY)
  status          MaintenanceStatus     @default(ACTIVE)
  chargeAmount    Decimal               @db.Decimal(14, 2)
  taxType         TaxType               @default(VAT_16)
  startDate       DateTime
  nextDueDate     DateTime
  lastCompletedDate DateTime?
  autoInvoice     Boolean               @default(true)
  notifyDaysBefore Int                  @default(3)
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  // Relations
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project         Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client          Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([nextDueDate])
  @@map("maintenance_schedules")
}

// ──────────────────────────────────────────────
// AUDIT LOG
// ──────────────────────────────────────────────

model AuditLog {
  id              String       @id @default(uuid())
  tenantId        String?      // Null for platform-level actions
  userId          String?
  action          AuditAction
  entityType      String       // e.g. "Invoice", "Payment", "Project"
  entityId        String?
  description     String
  ipAddress       String?
  userAgent       String?
  metadata        Json?        // Additional context
  createdAt       DateTime     @default(now())

  // Relations
  tenant          Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([createdAt])
  @@map("audit_logs")
}
