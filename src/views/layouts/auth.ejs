<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Sign in to your PM & ERP workspace">
  <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %><%= appName %></title>

  <!-- PWA & Mobile Meta -->
  <meta name="theme-color" content="#e8650a">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="PM & ERP">
  <meta name="application-name" content="PM & ERP">

  <!-- Manifest -->
  <link rel="manifest" href="/manifest.json">

  <!-- Favicon & Touch Icons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192x192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="/icons/icon-512x512.png">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Unicons (Iconscout) -->
  <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.8/css/line.css">

  <!-- Stylesheets (Zero Inline Style Constraint) -->
  <link rel="stylesheet" href="/css/app.css?v=2.2">
  <link rel="stylesheet" href="/css/components.css?v=2.2">
  <link rel="stylesheet" href="/css/dashboard.css?v=2.2">

  <%- style %>
</head>
<body class="auth-body">
  <div class="auth-container">
    <!-- Left Panel - Branding -->
    <div class="auth-brand-panel">
      <div class="auth-brand-content">
        <div class="auth-brand-logo">
          <div class="auth-logo-badge">
            <i class="uil uil-layer-group"></i>
          </div>
          <span class="auth-brand-name"><%= appName %></span>
        </div>
        <h1 class="auth-brand-headline">Manage Projects.<br>Track Finances.<br>Grow Faster.</h1>
        <p class="auth-brand-subtext">Enterprise-grade project management, invoicing, and financial tracking with M-Pesa integration — built for African businesses.</p>
        <div class="auth-brand-features">
          <div class="auth-feature">
            <span class="auth-feature-icon"><i class="uil uil-folder-check"></i></span>
            <span>Project Tracking</span>
          </div>
          <div class="auth-feature">
            <span class="auth-feature-icon"><i class="uil uil-invoice"></i></span>
            <span>Professional Invoicing</span>
          </div>
          <div class="auth-feature">
            <span class="auth-feature-icon"><i class="uil uil-credit-card"></i></span>
            <span>M-Pesa Payments</span>
          </div>
          <div class="auth-feature">
            <span class="auth-feature-icon"><i class="uil uil-analytics"></i></span>
            <span>Financial Reports</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Panel - Auth Form -->
    <div class="auth-form-panel">
      <!-- Flash Messages -->
      <%- include('../partials/alerts') %>

      <%- body %>

      <div class="auth-footer">
        <p>&copy; <%= currentYear %> <%= appName %>. All rights reserved.</p>
        <p class="auth-footer-attribution" style="margin-top: 4px; font-size: 0.78rem; color: var(--text-tertiary);">
          Platform built and maintained by 
          <a href="https://freestylecodetechnologies.com/" target="_blank" rel="noopener noreferrer" style="color: var(--text-secondary); text-decoration: underline;">Free Style Code Technologies</a>
        </p>
      </div>
    </div>
  </div>

  <!-- PWA Install Prompt Banner -->
  <%- include('../partials/pwa-install') %>

  <!-- Scripts (Zero Inline Script Constraint) -->
  <script src="/js/app.js?v=2.2"></script>
  <!-- PWA Lifecycle, Service Worker & Install Prompt -->
  <script src="/js/pwa.js?v=2.2"></script>
  <%- script %>
</body>
</html>
