<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Enterprise Project Management, Invoicing & ERP System">

  <!-- PWA Meta Tags -->
  <meta name="theme-color" content="#e8650a">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="PM">
  <meta name="application-name" content="PM & ERP SaaS">
  <meta name="msapplication-TileColor" content="#e8650a">
  <meta name="msapplication-TileImage" content="/icons/icon-144x144.png">

  <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %><%= appName %></title>

  <!-- Favicon & Icons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/icons/icon-96x96.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png">

  <!-- PWA Manifest -->
  <link rel="manifest" href="/manifest.json">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Unicons (Iconscout) -->
  <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.8/css/line.css">

  <!-- Stylesheets (Zero Inline Style Constraint) -->
  <link rel="stylesheet" href="/css/app.css?v=2.2">
  <link rel="stylesheet" href="/css/components.css?v=2.2">
  <link rel="stylesheet" href="/css/dashboard.css?v=2.2">

  <!-- Flatpickr Date Picker Library -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/airbnb.css">

  <%- style %>
</head>
<body class="app-body">
  <!-- Sidebar Navigation -->
  <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
    <%- include('../partials/sidebar') %>
  <% } %>

  <!-- Main Content Wrapper -->
  <div class="main-wrapper<%= (typeof isAuthenticated !== 'undefined' && isAuthenticated) ? ' has-sidebar' : '' %>">
    <!-- Top Navbar -->
    <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
      <%- include('../partials/navbar') %>
    <% } %>

    <!-- Flash Messages -->
    <%- include('../partials/alerts') %>

    <!-- Page Content -->
    <main class="main-content" id="main-content">
      <%- body %>
    </main>

    <!-- Application Footer -->
    <%- include('../partials/footer') %>
  </div>

  <!-- PWA Install Prompt Banner -->
  <%- include('../partials/pwa-install') %>

  <!-- Flatpickr & Application Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
  <script src="/js/app.js?v=2.2"></script>

  <!-- PWA Lifecycle, Service Worker & Install Prompt -->
  <script src="/js/pwa.js?v=2.2"></script>

  <%- script %>
</body>
</html>

