<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Enterprise Project Management, Invoicing & ERP System">
  <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %><%= appName %></title>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Unicons (Iconscout) -->
  <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.8/css/line.css">

  <!-- Stylesheets (Zero Inline Style Constraint) -->
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/dashboard.css">

  <%- style %>
</head>
<body class="app-body">
  <!-- Sidebar Navigation -->
  <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
    <%- include('../partials/sidebar') %>
  <% } %>

  <!-- Main Content Wrapper -->
  <div class="main-wrapper<%= (typeof isAuthenticated !== 'undefined' && isAuthenticated) ? ' has-sidebar' : '' %>">
    <!-- Top Navbar -->
    <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
      <%- include('../partials/navbar') %>
    <% } %>

    <!-- Flash Messages -->
    <%- include('../partials/alerts') %>

    <!-- Page Content -->
    <main class="main-content" id="main-content">
      <%- body %>
    </main>
  </div>

  <!-- Scripts (Zero Inline Script Constraint) -->
  <script src="/js/app.js"></script>
  <%- script %>
</body>
</html>
