<!-- ═══════════════════════════════════════════════════════════════════
     System Error Diagnostics View
     Super Admin Inspection of Server & Client Application Exceptions
     ═══════════════════════════════════════════════════════════════════ -->

<div class="error-logs-page">
  <div class="page-header">
    <div class="page-title-group">
      <h1 class="page-title">System Error Diagnostics</h1>
      <p class="page-subtitle">Real-time error logs, unhandled exceptions, and request tracing</p>
    </div>
  </div>

  <!-- Filters Toolbar -->
  <div class="card mb-6">
    <div class="card-body py-4">
      <form method="GET" action="/admin/error-logs" class="filter-toolbar">
        <div class="filter-group">
          <select name="level" class="form-select filter-select" onchange="this.form.submit()">
            <option value="">All Severity Levels</option>
            <option value="ERROR" <%= selectedLevel === 'ERROR' ? 'selected' : '' %>>ERROR (5xx)</option>
            <option value="WARN" <%= selectedLevel === 'WARN' ? 'selected' : '' %>>WARN (4xx / Operational)</option>
            <option value="FATAL" <%= selectedLevel === 'FATAL' ? 'selected' : '' %>>FATAL (Process Crashes)</option>
          </select>
        </div>

        <button type="submit" class="btn btn-secondary">
          <i class="uil uil-filter"></i>
          <span>Filter</span>
        </button>

        <% if (selectedLevel) { %>
          <a href="/admin/error-logs" class="btn btn-subtle" title="Clear filter">
            <i class="uil uil-times"></i>
            <span>Clear</span>
          </a>
        <% } %>
      </form>
    </div>
  </div>

  <!-- Error Logs Table -->
  <div class="card">
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Timestamp</th>
            <th>Severity</th>
            <th>HTTP Request</th>
            <th>Error Message</th>
            <th>Client Context</th>
            <th>Diagnostic Stack</th>
          </tr>
        </thead>
        <tbody>
          <% if (typeof errorLogs !== 'undefined' && errorLogs.length > 0) { %>
            <% errorLogs.forEach(function(item) { %>
              <tr>
                <td class="text-xs text-muted font-mono whitespace-nowrap">
                  <%= new Date(item.createdAt).toLocaleString('en-KE', { 
                    year: 'numeric', month: 'short', day: 'numeric', 
                    hour: '2-digit', minute: '2-digit', second: '2-digit' 
                  }) %>
                </td>
                <td>
                  <% if (item.level === 'FATAL') { %>
                    <span class="badge badge-danger font-bold"><i class="uil uil-skull"></i> FATAL</span>
                  <% } else if (item.level === 'ERROR') { %>
                    <span class="badge badge-danger"><i class="uil uil-exclamation-triangle"></i> ERROR</span>
                  <% } else { %>
                    <span class="badge badge-warning"><i class="uil uil-info-circle"></i> <%= item.level %></span>
                  <% } %>
                </td>
                <td>
                  <span class="badge badge-subtle font-mono text-xs"><%= item.method || 'N/A' %></span>
                  <code class="text-xs text-primary font-mono ml-1"><%= item.path || '/' %></code>
                  <span class="badge <%= item.statusCode >= 500 ? 'badge-danger' : 'badge-warning' %> ml-1">
                    <%= item.statusCode %>
                  </span>
                </td>
                <td>
                  <span class="text-sm font-semibold text-danger block"><%= item.message %></span>
                  <% if (item.metadata && item.metadata.errorReference) { %>
                    <span class="text-2xs text-muted font-mono">Ref: <%= item.metadata.errorReference %></span>
                  <% } %>
                </td>
                <td class="text-xs text-muted">
                  <span class="block">IP: <code><%= item.ipAddress || 'Internal' %></code></span>
                  <% if (item.userId) { %>
                    <span class="block">User: <code class="text-xs font-mono"><%= item.userId.substring(0, 8) %>...</code></span>
                  <% } %>
                </td>
                <td>
                  <% if (item.stack) { %>
                    <details class="text-xs cursor-pointer">
                      <summary class="text-primary hover:underline">View Trace</summary>
                      <pre class="bg-tertiary p-2 rounded mt-1 font-mono text-2xs overflow-auto max-h-48 whitespace-pre-wrap"><%= item.stack %></pre>
                    </details>
                  <% } else { %>
                    <span class="text-xs text-muted">No trace captured</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center py-12">
                <div class="empty-state">
                  <div class="empty-state-icon">
                    <i class="uil uil-shield-check text-success"></i>
                  </div>
                  <h3 class="empty-state-title">No System Errors Logged</h3>
                  <p class="empty-state-description">Your application is running smoothly with zero recorded exceptions.</p>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (typeof pagination !== 'undefined' && pagination.totalPages > 1) { %>
      <div class="card-footer">
        <%- include('../../partials/pagination') %>
      </div>
    <% } %>
  </div>
</div>
