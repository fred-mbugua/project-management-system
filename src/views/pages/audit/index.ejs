<!-- ═══════════════════════════════════════════════════════════════════
     Action & Audit Trail View
     Comprehensive activity log across tenant operations
     ═══════════════════════════════════════════════════════════════════ -->

<div class="audit-page">
  <div class="page-header">
    <div class="page-title-group">
      <h1 class="page-title">Action & Audit Logs</h1>
      <p class="page-subtitle">Track operational changes, user activities, document modifications, and security events</p>
    </div>
  </div>

  <!-- Filters & Search Toolbar -->
  <div class="card mb-6">
    <div class="card-body py-4">
      <form method="GET" action="/audit-logs" class="filter-toolbar">
        <div class="search-input-group flex-1">
          <i class="uil uil-search search-icon"></i>
          <input 
            type="text" 
            name="search" 
            class="form-input" 
            placeholder="Search action descriptions..."
            value="<%= typeof search !== 'undefined' ? search : '' %>"
          >
        </div>

        <div class="filter-group">
          <select name="action" class="form-select filter-select" onchange="this.form.submit()">
            <option value="">All Actions</option>
            <option value="CREATE" <%= selectedAction === 'CREATE' ? 'selected' : '' %>>CREATE</option>
            <option value="UPDATE" <%= selectedAction === 'UPDATE' ? 'selected' : '' %>>UPDATE</option>
            <option value="DELETE" <%= selectedAction === 'DELETE' ? 'selected' : '' %>>DELETE</option>
            <option value="LOGIN" <%= selectedAction === 'LOGIN' ? 'selected' : '' %>>LOGIN</option>
            <option value="LOGOUT" <%= selectedAction === 'LOGOUT' ? 'selected' : '' %>>LOGOUT</option>
            <option value="SETTINGS_CHANGE" <%= selectedAction === 'SETTINGS_CHANGE' ? 'selected' : '' %>>SETTINGS CHANGE</option>
            <option value="PAYMENT" <%= selectedAction === 'PAYMENT' ? 'selected' : '' %>>PAYMENT</option>
          </select>
        </div>

        <button type="submit" class="btn btn-secondary">
          <i class="uil uil-filter"></i>
          <span>Filter</span>
        </button>

        <% if ((typeof search !== 'undefined' && search) || selectedAction) { %>
          <a href="/audit-logs" class="btn btn-subtle" title="Clear filters">
            <i class="uil uil-times"></i>
            <span>Clear</span>
          </a>
        <% } %>
      </form>
    </div>
  </div>

  <!-- Logs Table -->
  <div class="card">
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Timestamp</th>
            <th>User</th>
            <th>Action</th>
            <th>Target Module</th>
            <th>Description</th>
            <th>Network / Origin</th>
          </tr>
        </thead>
        <tbody>
          <% if (typeof logs !== 'undefined' && logs.length > 0) { %>
            <% logs.forEach(function(log) { %>
              <tr>
                <td class="text-xs text-muted font-mono whitespace-nowrap">
                  <%= new Date(log.createdAt).toLocaleString('en-KE', { 
                    year: 'numeric', month: 'short', day: 'numeric', 
                    hour: '2-digit', minute: '2-digit', second: '2-digit' 
                  }) %>
                </td>
                <td>
                  <div class="flex-align-center gap-2">
                    <span class="avatar-initials avatar-xs">
                      <%= (log.userName || 'System').split(' ').map(function(n) { return n[0]; }).join('').substring(0, 2).toUpperCase() %>
                    </span>
                    <div>
                      <strong class="text-sm block"><%= log.userName || 'System' %></strong>
                      <span class="text-xs text-muted block"><%= log.userEmail || 'Automated Task' %></span>
                    </div>
                  </div>
                </td>
                <td>
                  <% if (log.action === 'CREATE') { %>
                    <span class="badge badge-success"><i class="uil uil-plus-circle"></i> CREATE</span>
                  <% } else if (log.action === 'UPDATE') { %>
                    <span class="badge badge-primary"><i class="uil uil-edit-alt"></i> UPDATE</span>
                  <% } else if (log.action === 'DELETE') { %>
                    <span class="badge badge-danger"><i class="uil uil-trash-alt"></i> DELETE</span>
                  <% } else if (log.action === 'LOGIN') { %>
                    <span class="badge badge-info"><i class="uil uil-signin"></i> LOGIN</span>
                  <% } else if (log.action === 'LOGOUT') { %>
                    <span class="badge badge-secondary"><i class="uil uil-signout"></i> LOGOUT</span>
                  <% } else if (log.action === 'SETTINGS_CHANGE') { %>
                    <span class="badge badge-warning"><i class="uil uil-setting"></i> SETTINGS</span>
                  <% } else { %>
                    <span class="badge badge-subtle"><%= log.action %></span>
                  <% } %>
                </td>
                <td>
                  <span class="font-mono text-xs text-primary font-semibold"><%= log.entityType %></span>
                  <% if (log.entityId) { %>
                    <span class="text-xs text-muted block font-mono">ID: <%= log.entityId.substring(0, 8) %>...</span>
                  <% } %>
                </td>
                <td>
                  <span class="text-sm font-medium"><%= log.description %></span>
                  <% if (log.metadata && Object.keys(log.metadata).length > 0) { %>
                    <details class="text-xs text-muted mt-1 cursor-pointer">
                      <summary class="text-primary hover:underline">View Metadata</summary>
                      <pre class="bg-tertiary p-2 rounded mt-1 font-mono text-2xs overflow-auto max-h-32"><%= JSON.stringify(log.metadata, null, 2) %></pre>
                    </details>
                  <% } %>
                </td>
                <td class="text-xs text-muted font-mono whitespace-nowrap">
                  <%= log.ipAddress || 'Internal' %>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center py-12">
                <div class="empty-state">
                  <div class="empty-state-icon">
                    <i class="uil uil-history"></i>
                  </div>
                  <h3 class="empty-state-title">No Audit Logs Found</h3>
                  <p class="empty-state-description">User and system actions will appear here automatically.</p>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (typeof pagination !== 'undefined' && pagination.totalPages > 1) { %>
      <div class="card-footer">
        <%- include('../../partials/pagination') %>
      </div>
    <% } %>
  </div>
</div>
