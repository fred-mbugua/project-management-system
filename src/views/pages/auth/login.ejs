<!-- ═══════════════════════════════════════════════════════════════════
     Login Page
     ═══════════════════════════════════════════════════════════════════ -->

<div class="auth-form-wrapper">
  <div class="auth-form-header">
    <h1 class="auth-form-title">Welcome back</h1>
    <p class="auth-form-subtitle">Sign in to your workspace</p>
  </div>

  <form class="auth-form" action="/auth/login" method="POST" id="loginForm">
    <div class="form-group">
      <label class="form-label" for="email">Email Address</label>
      <div class="input-wrapper">
        <i class="uil uil-envelope input-icon"></i>
        <input type="email" class="form-input" id="email" name="email" placeholder="you@company.com" required autocomplete="email" autofocus>
      </div>
    </div>

    <div class="form-group">
      <div class="form-label-row">
        <label class="form-label" for="password">Password</label>
      </div>
      <div class="input-wrapper">
        <i class="uil uil-lock-alt input-icon"></i>
        <input type="password" class="form-input" id="password" name="password" placeholder="Enter your password" required autocomplete="current-password">
        <button type="button" class="input-toggle-password" aria-label="Toggle password visibility" data-target="password">
          <i class="uil uil-eye eye-open"></i>
          <i class="uil uil-eye-slash eye-closed"></i>
        </button>
      </div>
    </div>

    <button type="submit" class="btn btn-primary btn-block" id="loginBtn">
      <span class="btn-text">Sign In</span>
      <span class="btn-loader">
        <i class="uil uil-spinner-alt spinner"></i>
      </span>
    </button>
  </form>

  <div class="auth-form-footer">
    <p>Don't have an account? <a href="/auth/register" class="auth-link">Create workspace</a></p>
  </div>
</div>
