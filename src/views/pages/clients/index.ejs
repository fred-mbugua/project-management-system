<!-- ═══════════════════════════════════════════════════════════════════
     Clients Directory View
     ═══════════════════════════════════════════════════════════════════ -->

<div class="clients-page">
  <div class="page-header">
    <div class="page-title-group">
      <h1 class="page-title">Clients Directory</h1>
      <p class="page-subtitle">Customer contacts, company tax details, and billing accounts.</p>
    </div>
    <div class="page-actions">
      <a href="/clients/new" class="btn btn-primary" id="btn-add-client">
        <i class="uil uil-plus"></i>
        <span>Add Client</span>
      </a>
    </div>
  </div>

  <!-- Search & Date Filter Section -->
  <div class="search-filter-section">
    <form action="/clients" method="GET" class="filter-form">
      <div class="search-input-wrapper">
        <i class="uil uil-search"></i>
        <input type="text" name="q" class="form-input" placeholder="Search client name, contact, email, phone, KRA PIN..." value="<%= (typeof filters !== 'undefined' && filters.search) ? filters.search : '' %>">
      </div>

      <div class="date-filter-group">
        <div class="date-filter-item">
          <span>From:</span>
          <input type="date" name="startDate" class="form-input" placeholder="e.g. 2026-09-01" value="<%= (typeof filters !== 'undefined' && filters.startDate) ? filters.startDate : '' %>">
        </div>
        <div class="date-filter-item">
          <span>To:</span>
          <input type="date" name="endDate" class="form-input" placeholder="e.g. 2026-09-30" value="<%= (typeof filters !== 'undefined' && filters.endDate) ? filters.endDate : '' %>">
        </div>
      </div>

      <div class="filter-actions">
        <button type="submit" class="btn btn-sm btn-primary">
          <i class="uil uil-filter"></i>
          <span>Filter</span>
        </button>
        <% if (typeof filters !== 'undefined' && (filters.search || filters.startDate || filters.endDate)) { %>
          <a href="/clients" class="btn btn-sm btn-secondary" title="Clear all filters">
            <i class="uil uil-times"></i>
            <span>Clear</span>
          </a>
        <% } %>
      </div>
    </form>
  </div>

  <div class="card">
    <div class="card-header">
      <div class="card-title-group">
        <div class="card-title-icon">
          <i class="uil uil-users-alt"></i>
        </div>
        <div>
          <div class="flex-align-center gap-2">
            <h2 class="card-title">All Registered Clients</h2>
            <span class="badge badge-subtle"><%= clients ? clients.length : 0 %> Listed</span>
          </div>
          <p class="card-subtitle">Corporate and individual client accounts, billing profiles, and contacts</p>
        </div>
      </div>
      <div class="flex-align-center gap-2">
        <a href="/clients/new" class="btn btn-sm btn-primary">
          <i class="uil uil-user-plus"></i>
          <span>Add Client</span>
        </a>
      </div>
    </div>
    <div class="card-body-table">
      <div class="table-scroll-hint">Swipe horizontally to view all columns &rarr;</div>
      <% if (clients && clients.length > 0) { %>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Client Name</th>
                <th>Contact Person</th>
                <th>Email & Phone</th>
                <th>Location</th>
                <th>KRA PIN</th>
                <th>Projects</th>
                <th>Invoices</th>
              </tr>
            </thead>
            <tbody>
              <% clients.forEach(function(c) { %>
                <tr>
                  <td>
                    <strong><%= c.name %></strong>
                  </td>
                  <td><%= c.contact_person || '—' %></td>
                  <td>
                    <div><%= c.email || '—' %></div>
                    <small class="text-xs text-muted"><%= c.phone || 'No phone' %></small>
                  </td>
                  <td><%= c.city || 'Nairobi' %>, <%= c.country %></td>
                  <td><code><%= c.kra_pin || '—' %></code></td>
                  <td><span class="badge badge-subtle"><%= c.project_count %></span></td>
                  <td><span class="badge badge-subtle"><%= c.invoice_count %></span></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <% if (typeof pagination !== 'undefined' && pagination) { %>
          <%- include('../../partials/pagination') %>
        <% } %>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-state-icon">
            <i class="uil uil-users-alt"></i>
          </div>
          <h4 class="empty-state-title">No clients found</h4>
          <p class="empty-state-text">Click "Add Client" above to create a new client account.</p>
        </div>
      <% } %>
    </div>
  </div>
</div>
