<!-- ═══════════════════════════════════════════════════════════════════
     Add Client Form View
     ═══════════════════════════════════════════════════════════════════ -->

<div class="new-client-page">
  <div class="page-header">
    <div class="page-title-group">
      <a href="/clients" class="btn btn-sm btn-secondary mb-2">
        <i class="uil uil-arrow-left"></i>
        <span>Back to Clients</span>
      </a>
      <h1 class="page-title">Add New Client</h1>
      <p class="page-subtitle">Register a corporate or individual client account.</p>
    </div>
  </div>

  <div class="card max-w-wide">
    <div class="card-header">
      <h3 class="card-title">Client Information</h3>
      <p class="text-xs text-muted">Primary contact, billing details, and tax credentials</p>
    </div>
    <div class="card-body">
      <form action="/clients/new" method="POST" class="form-stack">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="name">Company / Client Name *</label>
            <input type="text" class="form-input" id="name" name="name" required placeholder="e.g. Kenya Airways">
          </div>
          <div class="form-group">
            <label class="form-label" for="contactPerson">Primary Contact Person</label>
            <input type="text" class="form-input" id="contactPerson" name="contactPerson" placeholder="e.g. Mary Njeri">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="email">Email Address</label>
            <input type="email" class="form-input" id="email" name="email" placeholder="billing@client.com">
          </div>
          <div class="form-group">
            <label class="form-label" for="phone">Phone Number</label>
            <input type="tel" class="form-input" id="phone" name="phone" placeholder="+254 700 123 456">
          </div>
        </div>

        <div class="form-row-2-1-1">
          <div class="form-group">
            <label class="form-label" for="address">Address</label>
            <input type="text" class="form-input" id="address" name="address" placeholder="Physical or postal address">
          </div>
          <div class="form-group">
            <label class="form-label" for="city">City</label>
            <input type="text" class="form-input" id="city" name="city" value="Nairobi">
          </div>
          <div class="form-group">
            <label class="form-label" for="kraPin">KRA PIN</label>
            <input type="text" class="form-input" id="kraPin" name="kraPin" placeholder="P051234567X">
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="notes">Internal Notes</label>
          <textarea class="form-input" id="notes" name="notes" rows="3" placeholder="Contract details, billing terms, special handling..."></textarea>
        </div>

        <div class="form-actions">
          <a href="/clients" class="btn btn-secondary">Cancel</a>
          <button type="submit" class="btn btn-primary" id="btn-save-client">
            <i class="uil uil-check"></i>
            <span>Save Client</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
