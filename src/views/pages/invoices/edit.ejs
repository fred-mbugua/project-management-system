<!-- ═══════════════════════════════════════════════════════════════════
     Edit Invoice Form View
     ═══════════════════════════════════════════════════════════════════ -->

<div class="edit-invoice-page">
  <div class="page-header">
    <div class="page-title-group">
      <a href="/invoices/<%= invoice.id %>" class="btn btn-sm btn-secondary mb-2">
        <i class="uil uil-arrow-left"></i>
        <span>Back to Invoice</span>
      </a>

      <h1 class="page-title">Edit Invoice <%= invoice.invoice_number %></h1>
      <p class="page-subtitle">Update commercial terms, line items, VAT settings, or payment due dates.</p>
    </div>
    <div class="page-actions">
      <a href="/invoices/<%= invoice.id %>" class="btn btn-secondary">
        <i class="uil uil-times"></i>
        <span>Cancel</span>
      </a>
    </div>
  </div>

  <% if (typeof sourceQuotation !== 'undefined' && sourceQuotation) { %>
    <!-- Notice for Invoices Converted from Quotations -->
    <div class="alert alert-warning mb-4" style="background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.3); border-left: 4px solid var(--amber-500, #f59e0b); padding: 18px 22px; border-radius: 8px;">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
        <div style="display: flex; align-items: flex-start; gap: 12px; max-width: 650px;">
          <i class="uil uil-exclamation-triangle" style="font-size: 1.6rem; color: #d97706;"></i>
          <div>
            <strong style="color: #b45309; font-size: 1rem;">Invoice Generated from Quotation <%= sourceQuotation.quotation_number %></strong>
            <p style="font-size: 0.88rem; color: var(--text-secondary); margin: 4px 0 0 0; line-height: 1.5;">
              This invoice originated from an approved quotation. Per ERP governance rules, modifying an invoice that has progressed requires editing the source quotation first. Changes saved to the quotation will automatically synchronize and update this invoice.
            </p>
          </div>
        </div>
        <div>
          <a href="/quotations/<%= sourceQuotation.id %>/edit" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 6px;">
            <i class="uil uil-edit"></i>
            <span>Edit Quotation <%= sourceQuotation.quotation_number %></span>
          </a>
        </div>
      </div>
    </div>
  <% } %>

  <div class="card max-w-wide">
    <div class="card-body">
      <% if (typeof sourceQuotation !== 'undefined' && sourceQuotation) { %>
        <!-- Readonly summary if quotation-derived -->
        <div style="padding: 10px 0;">
          <p class="text-sm text-muted mb-4">
            Direct edits on this invoice are locked to prevent desynchronization with Quotation <strong><%= sourceQuotation.quotation_number %></strong>. Click below to edit the quotation, which automatically updates this invoice's items and totals:
          </p>
          <a href="/quotations/<%= sourceQuotation.id %>/edit" class="btn btn-primary">
            <i class="uil uil-edit"></i>
            <span>Proceed to Edit Source Quotation</span>
          </a>
        </div>
      <% } else { %>
        <!-- Editable Form for Standalone Invoices -->
        <form action="/invoices/<%= invoice.id %>/edit" method="POST" class="form-stack">
          <div class="form-row-3">
            <div class="form-group">
              <label class="form-label" for="invoiceNumber">Invoice Number</label>
              <input type="text" class="form-input" id="invoiceNumber" value="<%= invoice.invoice_number %>" readonly disabled style="background: var(--bg-tertiary);">
            </div>
            <div class="form-group">
              <label class="form-label" for="clientId">Client *</label>
              <select class="form-select" id="clientId" name="clientId" required>
                <option value="">-- Select Client --</option>
                <% if (clients && clients.length > 0) { %>
                  <% clients.forEach(function(c) { %>
                    <option value="<%= c.id %>" <%= invoice.client_id === c.id ? 'selected' : '' %>>
                      <%= c.name %> (<%= c.kra_pin || 'No PIN' %>)
                    </option>
                  <% }); %>
                <% } %>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label" for="projectId">Associated Project</label>
              <select class="form-select" id="projectId" name="projectId">
                <option value="">-- None / General --</option>
                <% if (projects && projects.length > 0) { %>
                  <% projects.forEach(function(p) { %>
                    <option value="<%= p.id %>" <%= invoice.project_id === p.id ? 'selected' : '' %>>
                      <%= p.code %> - <%= p.name %>
                    </option>
                  <% }); %>
                <% } %>
              </select>
            </div>
          </div>

          <div class="form-row-2-1">
            <div class="form-group">
              <label class="form-label" for="title">Invoice Description/Subject</label>
              <input type="text" class="form-input" id="title" name="title" value="<%= invoice.title || '' %>" required>
            </div>
            <div class="form-group">
              <label class="form-label" for="dueDate">Due Date *</label>
              <% const dueDateFormatted = invoice.due_date ? new Date(invoice.due_date).toISOString().split('T')[0] : ''; %>
              <input type="date" class="form-input" id="dueDate" name="dueDate" value="<%= dueDateFormatted %>" required>
            </div>
          </div>

          <div class="mt-4 mb-2 flex items-center justify-between">
            <h3 class="font-semibold text-primary">Billable Line Items</h3>
            <button type="button" class="btn btn-sm btn-secondary" id="btn-add-line-item">
              <i class="uil uil-plus"></i>
              <span>Add Item</span>
            </button>
          </div>

          <div id="line-items-container" class="line-item-builder">
            <% if (items && items.length > 0) { %>
              <% items.forEach(function(item) { %>
                <div class="line-item-row">
                  <div class="line-item-grid">
                    <div class="form-group">
                      <label class="form-label">Item / Description *</label>
                      <input type="text" class="form-input" name="itemDescriptions" required placeholder="e.g. Fiber optic network installation" value="<%= item.description %>">
                    </div>
                    <div class="form-group">
                      <label class="form-label">Quantity *</label>
                      <input type="number" step="any" min="1" class="form-input" name="itemQuantities" value="<%= item.quantity %>" required>
                    </div>
                    <div class="form-group">
                      <label class="form-label">Unit Price (KES) *</label>
                      <input type="number" step="any" min="0" class="form-input" name="itemUnitPrices" required placeholder="0.00" value="<%= item.unit_price %>">
                    </div>
                    <div class="line-item-remove-wrapper">
                      <button type="button" class="btn btn-sm btn-ghost btn-remove-item" aria-label="Remove item" title="Remove item">
                        <i class="uil uil-trash-alt"></i>
                      </button>
                    </div>
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <div class="line-item-row">
                <div class="line-item-grid">
                  <div class="form-group">
                    <label class="form-label">Item / Description *</label>
                    <input type="text" class="form-input" name="itemDescriptions" required placeholder="e.g. Service or equipment description">
                  </div>
                  <div class="form-group">
                    <label class="form-label">Quantity *</label>
                    <input type="number" step="1" min="1" class="form-input" name="itemQuantities" value="1" required>
                  </div>
                  <div class="form-group">
                    <label class="form-label">Unit Price (KES) *</label>
                    <input type="number" step="any" min="0" class="form-input" name="itemUnitPrices" required placeholder="0.00">
                  </div>
                  <div class="line-item-remove-wrapper">
                    <button type="button" class="btn btn-sm btn-ghost btn-remove-item" aria-label="Remove item" title="Remove item">
                      <i class="uil uil-trash-alt"></i>
                    </button>
                  </div>
                </div>
              </div>
            <% } %>
          </div>

          <!-- VAT Option Box -->
          <% const hasVat = invoice.include_vat !== false && parseFloat(invoice.tax_amount || 0) > 0; %>
          <div class="card p-4 mb-4 bg-surface-subtle vat-option-card" style="border: 1px solid var(--border-color); border-radius: 8px; background: rgba(79, 70, 229, 0.04); margin-top: 14px;">
            <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px;">
              <div style="display: flex; align-items: flex-start; gap: 12px;">
                <div style="margin-top: 2px;">
                  <input type="checkbox" id="includeVat" name="includeVat" value="true" class="form-check-input" <%= hasVat ? 'checked' : '' %> style="width: 20px; height: 20px; accent-color: var(--primary); cursor: pointer;">
                </div>
                <div>
                  <label for="includeVat" style="font-weight: 700; font-size: 0.95rem; cursor: pointer; color: var(--text-primary); display: block; margin-bottom: 2px;">
                    Apply Kenya Value Added Tax (VAT 16%)
                  </label>
                  <p class="text-xs text-muted" style="margin: 0;">
                    Uncheck this option to generate a tax-exempt or non-VAT invoice without 16% tax added.
                  </p>
                </div>
              </div>
              <div id="vat-mode-badge">
                <span class="badge <%= hasVat ? 'badge-success' : 'badge-subtle' %>" style="font-weight: 700; font-size: 0.8rem; padding: 4px 10px;">
                  <i class="uil <%= hasVat ? 'uil-check-circle' : 'uil-ban' %> mr-1"></i> <%= hasVat ? 'VAT Included (16%)' : 'No VAT (0% Exempt)' %>
                </span>
              </div>
            </div>
          </div>

          <!-- Real-Time Calculation Preview -->
          <div class="invoice-live-summary">
            <div class="live-summary-row">
              <span>Subtotal (Net):</span>
              <strong id="live-subtotal"><%= formatKES(parseFloat(invoice.subtotal || 0)) %></strong>
            </div>
            <div class="live-summary-row" id="live-vat-row">
              <span id="live-vat-label"><%= hasVat ? 'VAT (16% Standard):' : 'VAT (0% Exempt / Zero-Rated):' %></span>
              <strong id="live-vat"><%= hasVat ? formatKES(parseFloat(invoice.tax_amount || 0)) : 'KES 0.00 (Exempt / 0%)' %></strong>
            </div>
            <div class="live-summary-row live-summary-grand">
              <span>Estimated Grand Total:</span>
              <strong class="text-primary-color" id="live-grand-total"><%= formatKES(parseFloat(invoice.total_amount || 0)) %></strong>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="notes">Notes to Client</label>
              <textarea class="form-input" id="notes" name="notes" rows="2" placeholder="Bank payment instructions, M-Pesa Till number, or cheque details..."><%= invoice.notes || '' %></textarea>
            </div>
            <div class="form-group">
              <label class="form-label" for="terms">Payment Terms</label>
              <textarea class="form-input" id="terms" name="terms" rows="2"><%= invoice.terms || 'Payment due within 30 days.' %></textarea>
            </div>
          </div>

          <div class="form-actions mt-6" style="display: flex; justify-content: flex-end; gap: 10px; border-top: 1px solid var(--border-color); padding-top: 20px;">
            <a href="/invoices/<%= invoice.id %>" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary" id="btn-save-invoice">
              <i class="uil uil-save"></i>
              <span>Save Changes</span>
            </button>
          </div>
        </form>
      <% } %>
    </div>
  </div>
</div>
