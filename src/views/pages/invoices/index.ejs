<!-- ═══════════════════════════════════════════════════════════════════
     Invoices Directory View
     ═══════════════════════════════════════════════════════════════════ -->

<div class="invoices-page">
  <div class="page-header">
    <div class="page-title-group">
      <h1 class="page-title">Invoices</h1>
      <p class="page-subtitle">Generate KRA/eTIMS compliant tax invoices and track payment collections.</p>
    </div>
    <div class="page-actions">
      <a href="/invoices/new" class="btn btn-primary" id="btn-create-invoice">
        <i class="uil uil-plus"></i>
        <span>New Invoice</span>
      </a>
    </div>
  </div>

  <!-- Search & Date Filter Section -->
  <div class="search-filter-section">
    <form action="/invoices" method="GET" class="filter-form">
      <div class="search-input-wrapper">
        <i class="uil uil-search"></i>
        <input type="text" name="q" class="form-input" placeholder="Search invoice #, client, project, or notes..." value="<%= (typeof filters !== 'undefined' && filters.search) ? filters.search : '' %>">
      </div>

      <div class="date-filter-group">
        <div class="date-filter-item">
          <span>From:</span>
          <input type="date" name="startDate" class="form-input" placeholder="e.g. 2026-09-01" value="<%= (typeof filters !== 'undefined' && filters.startDate) ? filters.startDate : '' %>">
        </div>
        <div class="date-filter-item">
          <span>To:</span>
          <input type="date" name="endDate" class="form-input" placeholder="e.g. 2026-09-30" value="<%= (typeof filters !== 'undefined' && filters.endDate) ? filters.endDate : '' %>">
        </div>
      </div>

      <div class="filter-status-wrapper">
        <select name="status" class="form-select form-select-sm">
          <option value="">All Statuses</option>
          <option value="DRAFT" <%= (typeof filters !== 'undefined' && filters.status === 'DRAFT') ? 'selected' : '' %>>Draft</option>
          <option value="SENT" <%= (typeof filters !== 'undefined' && filters.status === 'SENT') ? 'selected' : '' %>>Sent</option>
          <option value="PAID" <%= (typeof filters !== 'undefined' && filters.status === 'PAID') ? 'selected' : '' %>>Paid</option>
          <option value="PARTIALLY_PAID" <%= (typeof filters !== 'undefined' && filters.status === 'PARTIALLY_PAID') ? 'selected' : '' %>>Partially Paid</option>
          <option value="OVERDUE" <%= (typeof filters !== 'undefined' && filters.status === 'OVERDUE') ? 'selected' : '' %>>Overdue</option>
          <option value="CANCELLED" <%= (typeof filters !== 'undefined' && filters.status === 'CANCELLED') ? 'selected' : '' %>>Cancelled</option>
        </select>
      </div>

      <div class="filter-actions">
        <button type="submit" class="btn btn-sm btn-primary">
          <i class="uil uil-filter"></i>
          <span>Filter</span>
        </button>
        <% if (typeof filters !== 'undefined' && (filters.search || filters.startDate || filters.endDate || filters.status)) { %>
          <a href="/invoices" class="btn btn-sm btn-secondary" title="Clear all filters">
            <i class="uil uil-times"></i>
            <span>Clear</span>
          </a>
        <% } %>
      </div>
    </form>
  </div>

  <div class="card">
    <div class="card-header">
      <div class="card-title-group">
        <div class="card-title-icon">
          <i class="uil uil-bill"></i>
        </div>
        <div>
          <div class="flex-align-center gap-2">
            <h2 class="card-title">Commercial Invoices</h2>
            <span class="badge badge-subtle"><%= invoices ? invoices.length : 0 %> Listed</span>
          </div>
          <p class="card-subtitle">Manage billing, payments, template designs, and eTIMS tax compliance</p>
        </div>
      </div>
      <div class="flex-align-center gap-2">
        <a href="/invoices/new" class="btn btn-sm btn-primary">
          <i class="uil uil-plus"></i>
          <span>New Invoice</span>
        </a>
      </div>
    </div>
    <div class="card-body-table">
      <% if (invoices && invoices.length > 0) { %>
        <div class="table-scroll-hint">
          <i class="uil uil-arrows-h"></i>
          <span>Swipe to view all</span>
        </div>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Invoice #</th>
                <th>Client</th>
                <th>Project</th>
                <th>Issue Date</th>
                <th>Due Date</th>
                <th>Total</th>
                <th>Paid</th>
                <th>Balance Due</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% invoices.forEach(function(inv) { %>
                <tr>
                  <td>
                    <a href="/invoices/<%= inv.id %>" class="font-bold text-primary">
                      <%= inv.invoice_number %>
                    </a>
                  </td>
                  <td><%= inv.client_name || '—' %></td>
                  <td><%= inv.project_code || '—' %></td>
                  <td><%= new Date(inv.issue_date).toLocaleDateString() %></td>
                  <td><%= new Date(inv.due_date).toLocaleDateString() %></td>
                  <td><strong><%= formatKES(parseFloat(inv.total_amount)) %></strong></td>
                  <td class="text-success font-semibold"><%= formatKES(parseFloat(inv.amount_paid)) %></td>
                  <td>
                    <% const bal = parseFloat(inv.balance_due); %>
                    <strong class="<%= bal > 0 ? 'text-error' : 'text-muted' %>">
                      <%= formatKES(bal) %>
                    </strong>
                  </td>
                  <td>
                    <% if (inv.status === 'PAID') { %>
                      <span class="badge badge-success"><span class="badge-dot"></span>Paid</span>
                    <% } else if (inv.status === 'SENT') { %>
                      <span class="badge badge-info"><span class="badge-dot"></span>Sent</span>
                    <% } else if (inv.status === 'OVERDUE') { %>
                      <span class="badge badge-danger"><span class="badge-dot"></span>Overdue</span>
                    <% } else { %>
                      <span class="badge badge-subtle"><%= inv.status %></span>
                    <% } %>
                  </td>
                  <td>
                    <div class="btn-group-sm">
                      <a href="/invoices/<%= inv.id %>" class="btn btn-sm btn-secondary" title="View details">
                        <i class="uil uil-eye"></i>
                      </a>
                      <a href="/invoices/<%= inv.id %>/pdf" class="btn btn-sm btn-secondary" title="Download PDF" target="_blank">
                        <i class="uil uil-file-download-alt"></i>
                      </a>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <%- include('../../partials/pagination') %>

      <% } else { %>
        <div class="empty-state">
          <div class="empty-state-icon"><i class="uil uil-invoice"></i></div>
          <p class="empty-state-title">No invoices found</p>
          <p class="empty-state-message">
            <% if (typeof filters !== 'undefined' && (filters.search || filters.startDate || filters.endDate || filters.status)) { %>
              No invoices match your search/filter criteria. Try adjusting or clearing your filters.
            <% } else { %>
              Generate your first tax invoice and collect payments through M-Pesa or bank transfer.
            <% } %>
          </p>
          <% if (typeof filters !== 'undefined' && (filters.search || filters.startDate || filters.endDate || filters.status)) { %>
            <a href="/invoices" class="btn btn-secondary btn-sm mt-3">
              <i class="uil uil-times"></i>
              <span>Clear Filters</span>
            </a>
          <% } else { %>
            <a href="/invoices/new" class="btn btn-primary btn-sm mt-3">
              <i class="uil uil-plus"></i>
              <span>Create Invoice</span>
            </a>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</div>
