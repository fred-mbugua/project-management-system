<!-- ═══════════════════════════════════════════════════════════════════
     Create Invoice Form View
     ═══════════════════════════════════════════════════════════════════ -->

<div class="new-invoice-page">
  <div class="page-header">
    <div class="page-title-group">
      <h1 class="page-title">Generate Tax Invoice</h1>
      <p class="page-subtitle">Creates eTIMS verification payload with automatic VAT 16% calculation.</p>
    </div>
    <div class="page-actions">
      <a href="/invoices" class="btn btn-secondary">
        <i class="uil uil-arrow-left"></i>
        <span>Cancel</span>
      </a>
    </div>
  </div>

  <div class="card max-w-wide">
    <div class="card-body">
      <form action="/invoices/new" method="POST" class="form-stack">
        <div class="form-row-3">
          <div class="form-group">
            <label class="form-label" for="invoiceNumber">Invoice Number *</label>
            <input type="text" class="form-input" id="invoiceNumber" name="invoiceNumber" value="<%= invoiceNumber %>" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="clientId">Client *</label>
            <select class="form-select" id="clientId" name="clientId" required>
              <option value="">-- Select Client --</option>
              <% if (clients && clients.length > 0) { %>
                <% clients.forEach(function(c) { %>
                  <option value="<%= c.id %>"><%= c.name %> (<%= c.kra_pin || 'No PIN' %>)</option>
                <% }); %>
              <% } %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="projectId">Associated Project</label>
            <select class="form-select" id="projectId" name="projectId">
              <option value="">-- None / General --</option>
              <% if (projects && projects.length > 0) { %>
                <% projects.forEach(function(p) { %>
                  <option value="<%= p.id %>"><%= p.code %> - <%= p.name %></option>
                <% }); %>
              <% } %>
            </select>
          </div>
        </div>

        <div class="form-row-2-1">
          <div class="form-group">
            <label class="form-label" for="title">Invoice Description/Subject</label>
            <input type="text" class="form-input" id="title" name="title" value="Professional Services & Equipment Delivery">
          </div>
          <div class="form-group">
            <label class="form-label" for="dueDate">Due Date *</label>
            <input type="date" class="form-input" id="dueDate" name="dueDate" placeholder="e.g. 2026-10-15" required>
          </div>
        </div>

        <div class="mt-4 mb-2 flex items-center justify-between">
          <h3 class="font-semibold text-primary">Billable Line Items</h3>
          <button type="button" class="btn btn-sm btn-secondary" id="btn-add-line-item">
            <i class="uil uil-plus"></i>
            <span>Add Item</span>
          </button>
        </div>

        <div id="line-items-container" class="line-item-builder">
          <div class="line-item-row">
            <div class="line-item-grid">
              <div class="form-group">
                <label class="form-label">Item / Description *</label>
                <input type="text" class="form-input" name="itemDescriptions" required placeholder="e.g. Fiber optic network installation" value="Fiber optic network installation">
              </div>
              <div class="form-group">
                <label class="form-label">Quantity *</label>
                <input type="number" step="1" min="1" class="form-input" name="itemQuantities" value="1" required>
              </div>
              <div class="form-group">
                <label class="form-label">Unit Price (KES) *</label>
                <input type="number" step="0.01" min="0" class="form-input" name="itemUnitPrices" required placeholder="50000" value="50000">
              </div>
              <div class="line-item-remove-wrapper">
                <button type="button" class="btn btn-sm btn-ghost btn-remove-item" aria-label="Remove item" title="Remove item">
                  <i class="uil uil-trash-alt"></i>
                </button>
              </div>

            </div>
          </div>
        </div>

        <p class="text-xs text-muted mb-4">
          * Standard Kenya VAT (16%) is automatically calculated and added to the taxable base.
        </p>

        <!-- Real-Time Calculation Preview -->
        <div class="invoice-live-summary">
          <div class="live-summary-row">
            <span>Subtotal (Net):</span>
            <strong id="live-subtotal">KES 50,000.00</strong>
          </div>
          <div class="live-summary-row">
            <span>VAT (16% Standard):</span>
            <strong id="live-vat">KES 8,000.00</strong>
          </div>
          <div class="live-summary-row live-summary-grand">
            <span>Estimated Grand Total:</span>
            <strong class="text-primary-color" id="live-grand-total">KES 58,000.00</strong>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="notes">Notes to Client</label>
            <textarea class="form-input" id="notes" name="notes" rows="2" placeholder="Bank payment instructions, M-Pesa Till number, or cheque details..."></textarea>
          </div>
          <div class="form-group">
            <label class="form-label" for="terms">Payment Terms</label>
            <textarea class="form-input" id="terms" name="terms" rows="2">Payment is due within 30 days. Late settlement attracts a 2% monthly interest.</textarea>
          </div>
        </div>

        <div class="form-actions">
          <a href="/invoices" class="btn btn-secondary">Cancel</a>
          <button type="submit" class="btn btn-primary" id="btn-save-invoice">
            <i class="uil uil-check"></i>
            <span>Generate & Send Invoice</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
