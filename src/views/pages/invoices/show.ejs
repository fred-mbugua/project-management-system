<!-- ═══════════════════════════════════════════════════════════════════
     Invoice Details & Print View
     Compliant with KRA eTIMS Tax Invoice Standards
     ═══════════════════════════════════════════════════════════════════ -->

<div class="invoice-detail-page">
  <div class="page-header">
    <div class="page-title-group">
      <a href="/invoices" class="btn btn-sm btn-secondary mb-2">
        <i class="uil uil-arrow-left"></i>
        <span>Back to Invoices</span>
      </a>
      <h1 class="page-title">Invoice <%= invoice.invoice_number %></h1>
      <p class="page-subtitle">Commercial Tax Invoice &bull; Client: <strong><%= invoice.client_name || 'Valued Client' %></strong></p>
    </div>
    <div class="page-actions" style="display: flex; gap: 8px; flex-wrap: wrap;">
      <% if (typeof isSubscriptionCancelled !== 'undefined' && isSubscriptionCancelled) { %>
        <button type="button" class="btn btn-secondary disabled" title="Subscription cancelled. Renew to download PDF." disabled style="opacity: 0.55; cursor: not-allowed;">
          <i class="uil uil-lock"></i>
          <span>Download PDF (Locked)</span>
        </button>
        <button type="button" class="btn btn-secondary disabled" title="Subscription cancelled. Renew to print." disabled style="opacity: 0.55; cursor: not-allowed;">
          <i class="uil uil-lock"></i>
          <span>Print (Locked)</span>
        </button>
        <button type="button" class="btn btn-secondary disabled" title="Subscription cancelled. Transactions are disabled." disabled style="opacity: 0.55; cursor: not-allowed;">
          <i class="uil uil-lock"></i>
          <span>Record Payment (Locked)</span>
        </button>
      <% } else { %>
        <a href="/invoices/<%= invoice.id %>/pdf" class="btn btn-secondary" id="btn-download-pdf" target="_blank">
          <i class="uil uil-file-download-alt"></i>
          <span>Download PDF</span>
        </a>
        <button type="button" class="btn btn-secondary" id="btn-print-invoice" data-action="print">
          <i class="uil uil-print"></i>
          <span>Print</span>
        </button>

        <!-- Record Manual Payment -->
        <button type="button" class="btn btn-success" onclick="openManualPaymentModal()">
          <i class="uil uil-bill"></i>
          <span>Record Manual Payment</span>
        </button>
      <% } %>

      <!-- Manual Status Update -->
      <button type="button" class="btn btn-secondary" onclick="openStatusModal()">
        <i class="uil uil-exchange"></i>
        <span>Status: <strong><%= invoice.status %></strong></span>
      </button>

      <% if (parseFloat(invoice.balance_due) > 0) { %>
        <button type="button" class="btn btn-primary" id="btn-pay-mpesa" data-action="mpesa-pay" data-amount="<%= invoice.balance_due %>">
          <i class="uil uil-mobile-android"></i>
          <span>Pay via M-Pesa</span>
        </button>
      <% } %>
    </div>
  </div>

  <% if (typeof isSubscriptionCancelled !== 'undefined' && isSubscriptionCancelled) { %>
    <div class="alert alert-danger mb-4" style="border-left: 4px solid var(--danger); background: #fef2f2; padding: 14px 18px; border-radius: 8px;">
      <div class="flex-between">
        <div class="flex-align-center gap-2">
          <i class="uil uil-lock text-danger" style="font-size: 1.4rem;"></i>
          <div>
            <strong style="color: #991b1b;">Document Access Restricted &bull; Subscription Cancelled</strong>
            <div style="font-size: 0.85rem; color: #7f1d1d;">
              Printing, PDF downloads, and transaction settlements are locked until your organization renews its subscription.
            </div>
          </div>
        </div>
        <a href="/subscription/pay" class="btn btn-sm btn-danger">
          <i class="uil uil-sync"></i> Renew Subscription
        </a>
      </div>
    </div>
  <% } %>

  <!-- Document Customization Toolbar -->
  <div class="doc-customizer-bar">
    <div class="doc-customizer-section">
      <span class="doc-customizer-label">Design Template:</span>
      <div class="template-selector-group">
        <button type="button" class="template-btn active" data-template="modern">
          <i class="uil uil-layer-group"></i>
          <span>Modern</span>
        </button>
        <button type="button" class="template-btn" data-template="corporate">
          <i class="uil uil-building"></i>
          <span>Corporate</span>
        </button>
        <button type="button" class="template-btn" data-template="classic">
          <i class="uil uil-file-alt"></i>
          <span>Classic</span>
        </button>
        <button type="button" class="template-btn" data-template="creative">
          <i class="uil uil-palette"></i>
          <span>Creative</span>
        </button>
        <button type="button" class="template-btn" data-template="executive">
          <i class="uil uil-award"></i>
          <span>Executive</span>
        </button>
        <button type="button" class="template-btn" data-template="compact">
          <i class="uil uil-table"></i>
          <span>Compact</span>
        </button>
        <button type="button" class="template-btn" data-template="minimal">
          <i class="uil uil-minus"></i>
          <span>Minimal</span>
        </button>
        <button type="button" class="template-btn" data-template="bold">
          <i class="uil uil-brush-alt"></i>
          <span>Bold Banner</span>
        </button>
      </div>
    </div>

    <div class="doc-customizer-section">
      <span class="doc-customizer-label">Brand Color:</span>
      <div class="color-swatches-group">
        <button type="button" class="color-swatch active" data-color="#4F46E5" title="Indigo" aria-label="Indigo"></button>
        <button type="button" class="color-swatch" data-color="#059669" title="Emerald" aria-label="Emerald"></button>
        <button type="button" class="color-swatch" data-color="#2563EB" title="Sapphire" aria-label="Sapphire"></button>
        <button type="button" class="color-swatch" data-color="#DC2626" title="Ruby" aria-label="Ruby"></button>
        <button type="button" class="color-swatch" data-color="#D97706" title="Amber" aria-label="Amber"></button>
        <button type="button" class="color-swatch" data-color="#475569" title="Slate" aria-label="Slate"></button>
        <button type="button" class="color-swatch" data-color="#9333EA" title="Purple" aria-label="Purple"></button>
        <button type="button" class="color-swatch" data-color="#0891B2" title="Teal" aria-label="Teal"></button>
        <div class="color-picker-wrapper" title="Pick Custom Color">
          <input type="color" class="color-picker-input" value="#4F46E5" aria-label="Custom brand color">
        </div>
      </div>
    </div>
  </div>

  <% const df = (typeof tenant !== 'undefined' && tenant && tenant.displayFields) ? tenant.displayFields : {}; %>

  <div class="invoice-sheet document-sheet template-modern"
       data-default-template="<%= (typeof tenant !== 'undefined' && tenant && tenant.invoiceTemplate) ? tenant.invoiceTemplate : 'modern' %>"
       data-default-color="<%= (typeof invoice !== 'undefined' && invoice.custom_color) ? invoice.custom_color : ((typeof invoice !== 'undefined' && invoice.tenant_primary_color) ? invoice.tenant_primary_color : ((typeof tenant !== 'undefined' && tenant && tenant.primaryColor) ? tenant.primaryColor : '#4F46E5')) %>">
    <!-- Invoice Header Row -->
    <div class="invoice-header-row">
      <div class="invoice-brand-block">
        <% const effectiveLogo = invoice.tenant_logo_url || (typeof tenant !== 'undefined' && tenant && tenant.logoUrl) ? (invoice.tenant_logo_url || tenant.logoUrl) : '/icons/icon-96x96.png'; %>
        <div class="doc-logo-wrapper">
          <img src="<%= effectiveLogo %>" alt="<%= invoice.tenant_name || (typeof tenant !== 'undefined' && tenant ? tenant.name : appName) %> Logo" class="doc-brand-logo">
        </div>
        <h2><%= invoice.tenant_name || ((typeof tenant !== 'undefined' && tenant) ? tenant.name : appName) %></h2>
        <div>
          <% if (df.showTenantAddress !== false) { %>
            <p><%= invoice.tenant_address || ((typeof tenant !== 'undefined' && tenant) ? tenant.address : 'Nairobi, Kenya') %></p>
          <% } %>
          <% if (df.showTenantEmail !== false && (invoice.tenant_email || (typeof tenant !== 'undefined' && tenant && tenant.email))) { %>
            <p>Email: <%= invoice.tenant_email || ((typeof tenant !== 'undefined' && tenant) ? tenant.email : '') %></p>
          <% } %>
          <% if (df.showTenantPhone !== false && (invoice.tenant_phone || (typeof tenant !== 'undefined' && tenant && tenant.phone))) { %>
            <p>Phone: <%= invoice.tenant_phone || ((typeof tenant !== 'undefined' && tenant) ? tenant.phone : '') %></p>
          <% } %>
          <% if (df.showTenantKraPin !== false) { %>
            <p><strong>KRA PIN:</strong> <%= invoice.tenant_kra_pin || invoice.tenantKraPin || ((typeof tenant !== 'undefined' && tenant) ? tenant.kraPin : 'P000000000X') %></p>
          <% } %>
        </div>
      </div>
      <div class="invoice-meta-block">
        <span class="badge <%= invoice.status === 'PAID' ? 'badge-success' : (invoice.status === 'SENT' ? 'badge-info' : 'badge-danger') %>">
          <span class="badge-dot"></span>
          <%= invoice.status %>
        </span>
        <h3><%= invoice.invoice_number %></h3>
        <p>Issue Date: <%= new Date(invoice.issue_date).toLocaleDateString('en-KE', { year: 'numeric', month: 'short', day: 'numeric' }) %></p>
        <% if (df.showPaymentTerms !== false) { %>
          <p>Due Date: <%= new Date(invoice.due_date).toLocaleDateString('en-KE', { year: 'numeric', month: 'short', day: 'numeric' }) %></p>
        <% } %>
      </div>
    </div>

    <!-- Client / Bill To -->
    <div class="invoice-parties-grid">
      <div class="invoice-party-col">
        <h4 class="invoice-party-heading">Billed To:</h4>
        <h3 class="invoice-party-name"><%= invoice.client_name || 'Valued Client' %></h3>
        <div class="invoice-party-details">
          <% if (df.showClientAddress !== false && invoice.client_address) { %><p><%= invoice.client_address %></p><% } %>
          <% if (df.showClientEmail !== false && invoice.client_email) { %><p>Email: <%= invoice.client_email %></p><% } %>
          <% if (df.showClientPhone !== false && invoice.client_phone) { %><p>Phone: <%= invoice.client_phone %></p><% } %>
          <% if (df.showClientKraPin !== false && (invoice.client_kra_pin || invoice.clientKraPin)) { %>
            <p><strong>Client KRA PIN:</strong> <%= invoice.client_kra_pin || invoice.clientKraPin %></p>
          <% } %>
        </div>
      </div>
      <% if (df.showProject !== false && invoice.project_name) { %>
        <div class="invoice-party-col text-right">
          <h4 class="invoice-party-heading">Project:</h4>
          <p class="font-semibold text-primary">
            <%= invoice.project_name %> (<%= invoice.project_code %>)
          </p>
        </div>
      <% } %>
    </div>

    <!-- Items Table -->
    <div class="table-responsive invoice-table-wrapper mb-6">
      <div class="table-scroll-hint">
        <i class="uil uil-arrows-h"></i>
        <span>Swipe horizontally to view all</span>
      </div>
      <table class="invoice-table">
        <thead>
          <tr>
            <th>Item Description</th>
            <th class="text-center">Qty</th>
            <th class="text-right">Unit Price</th>
            <% if (df.showTaxBreakdown !== false) { %>
              <th class="text-right">VAT (16%)</th>
            <% } %>
            <th class="text-right">Amount</th>
          </tr>
        </thead>
        <tbody>
          <% if (items && items.length > 0) { %>
            <% items.forEach(function(item) { %>
              <tr>
                <td><strong><%= item.description %></strong></td>
                <td class="text-center"><%= item.quantity %></td>
                <td class="text-right"><%= formatKES(parseFloat(item.unit_price)) %></td>
                <% if (df.showTaxBreakdown !== false) { %>
                  <td class="text-right"><%= formatKES(parseFloat(item.line_tax || (item.quantity * item.unit_price * 0.16))) %></td>
                <% } %>
                <td class="text-right font-semibold"><%= formatKES(parseFloat(item.line_total || (item.quantity * item.unit_price * (df.showTaxBreakdown !== false ? 1.16 : 1)))) %></td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="<%= df.showTaxBreakdown !== false ? 5 : 4 %>" class="text-center text-muted p-4">No line items recorded.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Totals Section -->
    <div class="invoice-totals-wrapper">
      <div class="invoice-totals-box">
        <div class="invoice-total-line">
          <span>Subtotal (Net):</span>
          <span><%= formatKES(parseFloat(invoice.subtotal)) %></span>
        </div>
        <% if (df.showTaxBreakdown !== false) { %>
          <div class="invoice-total-line">
            <span>VAT (16% Standard):</span>
            <span><%= formatKES(parseFloat(invoice.tax_amount)) %></span>
          </div>
        <% } %>
        <% if (df.showDiscount !== false && parseFloat(invoice.discount_amount) > 0) { %>
          <div class="invoice-total-line">
            <span>Discount:</span>
            <span>- <%= formatKES(parseFloat(invoice.discount_amount)) %></span>
          </div>
        <% } %>
        <div class="invoice-total-line invoice-total-line-grand">
          <span>Grand Total:</span>
          <span><%= formatKES(parseFloat(invoice.total_amount)) %></span>
        </div>
        <div class="invoice-total-line text-success font-medium">
          <span>Amount Paid:</span>
          <span><%= formatKES(parseFloat(invoice.amount_paid)) %></span>
        </div>
        <div class="invoice-total-line invoice-total-line-balance">
          <span>Balance Due:</span>
          <span><%= formatKES(parseFloat(invoice.balance_due)) %></span>
        </div>
      </div>
    </div>

    <!-- Settlement Details (Bank & M-Pesa) -->
    <% const hasBank = df.showBankDetails !== false && (invoice.tenant_bank_details || (typeof tenant !== 'undefined' && tenant && tenant.bankDetails)); %>
    <% const hasMpesa = df.showMpesaDetails !== false && (invoice.tenant_daraja_shortcode || (typeof tenant !== 'undefined' && tenant && tenant.darajaShortcode)); %>
    <% if (hasBank || hasMpesa) { %>
      <div class="invoice-settlement-card mb-6">
        <h4 class="invoice-settlement-title">
          <i class="uil uil-credit-card text-primary"></i>
          <span>Payment & Settlement Details</span>
        </h4>
        <div class="invoice-settlement-grid">
          <% if (hasBank) { %>
            <div class="settlement-grid-item">
              <span class="settlement-label">Bank Settlement Account:</span>
              <p class="settlement-value"><%= invoice.tenant_bank_details || tenant.bankDetails %></p>
            </div>
          <% } %>
          <% if (hasMpesa) { %>
            <div class="settlement-grid-item">
              <span class="settlement-label">Safaricom M-Pesa <%= (invoice.tenant_daraja_shortcode_type || (typeof tenant !== 'undefined' && tenant && tenant.darajaShortcodeType) || 'PAYBILL') %>:</span>
              <p class="settlement-value">
                Shortcode: <strong><%= invoice.tenant_daraja_shortcode || tenant.darajaShortcode %></strong> &bull; Account: <strong><%= invoice.invoice_number %></strong>
              </p>
            </div>
          <% } %>
        </div>
      </div>
    <% } %>

    <!-- KRA eTIMS Verification Banner -->
    <% if (df.showEtimsQr !== false) { %>
      <div class="invoice-etims-banner">
        <div class="invoice-etims-info">
          <div class="invoice-etims-title">KRA eTIMS Verification</div>
          <div class="invoice-etims-hash">
            Hash: <%= invoice.etims_verification_hash || 'ETIMS-SIGNATURE-NOT-AVAILABLE' %>
          </div>
        </div>
        <div class="invoice-etims-badge">
          <i class="uil uil-qrcode-scan"></i>
          <span class="invoice-etims-badge-text">eTIMS QR</span>
        </div>
      </div>
    <% } %>

    <!-- Notes & Terms -->
    <% const hasNotes = df.showNotes !== false && invoice.notes; %>
    <% const hasTerms = df.showTerms !== false && invoice.terms; %>
    <% if (hasNotes || hasTerms) { %>
      <div class="invoice-notes-terms">
        <% if (hasNotes) { %>
          <p class="mb-1"><strong>Notes:</strong> <%= invoice.notes %></p>
        <% } %>
        <% if (hasTerms) { %>
          <p><strong>Terms:</strong> <%= invoice.terms %></p>
        <% } %>
      </div>
    <% } %>
  </div>

  <!-- Complete Invoice History & Payment Log -->
  <div class="card mt-6">
    <div class="card-header">
      <h3 class="card-title">
        <i class="uil uil-history text-primary"></i>
        <span>Complete Document History & Ledger</span>
      </h3>
      <p class="text-xs text-muted">Chronological timeline of creation, disbursements, and Safaricom M-Pesa receipts</p>
    </div>
    <div class="card-body">
      <div class="timeline-feed">
        <div class="timeline-entry">
          <div class="timeline-dot bg-primary"></div>
          <div class="timeline-content">
            <div class="timeline-heading">Invoice Generated & Issued</div>
            <div class="timeline-meta">
              <%= new Date(invoice.created_at || invoice.issue_date).toLocaleString('en-KE', { dateStyle: 'medium', timeStyle: 'short' }) %> &bull; Status: <span class="badge badge-sm badge-info"><%= invoice.status %></span>
            </div>
            <div class="text-xs text-muted mt-1">
              Invoice <%= invoice.invoice_number %> initialized for <%= invoice.client_name %> with total amount of <%= formatKES(parseFloat(invoice.total_amount)) %>.
              <% if (invoice.quotation_id) { %>
                <span class="text-primary font-medium">Converted from Quotation #<%= invoice.quotation_id.slice(0, 8) %></span>
              <% } %>
            </div>
          </div>
        </div>

        <% if (typeof payments !== 'undefined' && payments && payments.length > 0) { %>
          <% payments.forEach(function(pay) { %>
            <div class="timeline-entry">
              <div class="timeline-dot bg-success"></div>
              <div class="timeline-content">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                  <div class="timeline-heading">
                    Payment Received &bull; <span class="text-success"><%= formatKES(parseFloat(pay.amount)) %></span>
                  </div>
                  <span class="badge badge-success"><%= pay.receipt_number || 'RECEIPT' %></span>
                </div>
                <div class="timeline-meta" style="margin-top: 4px;">
                  <%= new Date(pay.payment_date || pay.created_at).toLocaleString('en-KE', { dateStyle: 'medium', timeStyle: 'short' }) %> &bull; Method: <strong><%= pay.payment_method %></strong>
                </div>
                <div class="text-xs text-muted mt-1">
                  <% if (pay.mpesa_receipt_number) { %>
                    M-Pesa Receipt: <strong><%= pay.mpesa_receipt_number %></strong> &bull; Phone: <%= pay.mpesa_phone_number || 'N/A' %>
                  <% } %>
                  <% if (pay.reference_number) { %>
                    <span> &bull; Ref / Code: <strong><%= pay.reference_number %></strong></span>
                  <% } %>
                  <% if (pay.notes) { %>
                    <div style="margin-top: 4px; color: var(--text-primary); font-style: italic;">
                      <i class="uil uil-comment-alt-notes"></i> <%= pay.notes %>
                    </div>
                  <% } %>
                </div>

                <!-- Proof of Payment Document Link -->
                <% if (pay.proof_url) { %>
                  <div style="margin-top: 8px;">
                    <a href="<%= pay.proof_url %>" target="_blank" class="btn btn-xs btn-outline-primary" style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; font-size: 0.8rem; border-radius: 6px; text-decoration: none; border: 1px solid var(--primary); color: var(--primary);">
                      <i class="uil uil-paperclip"></i>
                      <span>View Payment Proof (<%= pay.proof_filename || 'Attachment' %>)</span>
                      <i class="uil uil-external-link-alt" style="font-size: 0.75rem;"></i>
                    </a>
                  </div>
                <% } %>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════
     Record Manual Payment Modal (with Proof Upload & Note)
     ═══════════════════════════════════════════════════════════════════ -->
<div id="modalManualPayment" class="modal-backdrop" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.65); backdrop-filter: blur(4px); z-index: 1050; align-items: center; justify-content: center; padding: 20px;">
  <div class="card" style="width: 100%; max-width: 540px; margin: auto; max-height: 90vh; overflow-y: auto; box-shadow: var(--shadow-xl); border: 1px solid var(--border-color); animation: fadeIn 0.15s ease-out;">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding: 18px 24px;">
      <div>
        <h3 class="card-title" style="margin: 0; display: flex; align-items: center; gap: 8px;">
          <i class="uil uil-bill" style="color: var(--success); font-size: 1.3rem;"></i>
          <span>Record Manual Payment</span>
        </h3>
        <p class="text-xs text-muted" style="margin: 4px 0 0 0;">Record cash, bank wire, or manual M-Pesa settlement for Invoice <%= invoice.invoice_number %></p>
      </div>
      <button type="button" class="btn btn-sm btn-subtle" onclick="closeManualPaymentModal()" style="border: none; background: transparent; font-size: 1.2rem; cursor: pointer;">
        <i class="uil uil-times"></i>
      </button>
    </div>

    <form action="/invoices/<%= invoice.id %>/payments/manual" method="POST" enctype="multipart/form-data" style="padding: 24px;">
      <div style="background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: var(--border-radius-md); padding: 12px 16px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
        <span style="font-size: 0.9rem; color: var(--text-secondary);">Current Balance Due:</span>
        <strong style="font-size: 1.15rem; color: var(--success);"><%= formatKES(parseFloat(invoice.balance_due)) %></strong>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;">
        <div class="form-group" style="margin-bottom: 0;">
          <label for="manualPaymentAmount" class="form-label" style="font-weight: 600;">Amount Received (KES) *</label>
          <input type="number" step="any" min="1" id="manualPaymentAmount" name="amount" class="form-input" value="<%= invoice.balance_due %>" required style="font-weight: 700; font-size: 1rem;">
        </div>

        <div class="form-group" style="margin-bottom: 0;">
          <label for="manualPaymentDate" class="form-label" style="font-weight: 600;">Payment Date *</label>
          <input type="date" id="manualPaymentDate" name="paymentDate" class="form-input flatpickr-date" placeholder="e.g. 2026-09-28" value="<%= new Date().toISOString().split('T')[0] %>" required>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;">
        <div class="form-group" style="margin-bottom: 0;">
          <label for="manualPaymentMethod" class="form-label" style="font-weight: 600;">Payment Method *</label>
          <select id="manualPaymentMethod" name="paymentMethod" class="form-select" required>
            <option value="BANK_TRANSFER">Bank Wire / Transfer</option>
            <option value="CASH">Cash Deposit / Cash</option>
            <option value="MPESA_C2B">Manual M-Pesa (Till / Paybill)</option>
            <option value="CARD">Debit / Credit Card</option>
            <option value="CHEQUE">Cheque</option>
            <option value="MANUAL" selected>Other Manual Payment</option>
          </select>
        </div>

        <div class="form-group" style="margin-bottom: 0;">
          <label for="manualReference" class="form-label" style="font-weight: 600;">Transaction Ref / Code</label>
          <input type="text" id="manualReference" name="referenceNumber" class="form-input" placeholder="e.g. QK847HD892, Slip #8492">
        </div>
      </div>

      <!-- Payment Proof Document Upload -->
      <div class="form-group" style="margin-bottom: 16px;">
        <label for="proofDocument" class="form-label" style="font-weight: 600;">
          <i class="uil uil-paperclip text-primary"></i> Upload Payment Proof (Document / Slip / Receipt)
        </label>
        <input type="file" id="proofDocument" name="proofDocument" class="form-input" accept=".pdf,image/png,image/jpeg,image/webp" style="padding: 8px;">
        <small class="text-xs text-muted" style="display: block; margin-top: 4px;">Attach bank deposit slip, M-Pesa screenshot, or signed delivery receipt (PDF or Image, max 15MB).</small>
      </div>

      <!-- Payment Notes / Memo -->
      <div class="form-group" style="margin-bottom: 24px;">
        <label for="manualNotes" class="form-label" style="font-weight: 600;">Payment Note / Remarks (For Future Reference)</label>
        <textarea id="manualNotes" name="notes" class="form-input" rows="2" placeholder="e.g. Received via Equity Bank Westlands branch; verified by accountant."></textarea>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px; border-top: 1px solid var(--border-color); padding-top: 18px;">
        <button type="button" class="btn btn-secondary" onclick="closeManualPaymentModal()">Cancel</button>
        <button type="submit" class="btn btn-success" style="display: inline-flex; align-items: center; gap: 6px;">
          <i class="uil uil-check-circle"></i>
          <span>Save Payment & Update Invoice</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════
     Update Invoice Status Modal
     ═══════════════════════════════════════════════════════════════════ -->
<div id="modalUpdateStatus" class="modal-backdrop" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.65); backdrop-filter: blur(4px); z-index: 1050; align-items: center; justify-content: center; padding: 20px;">
  <div class="card" style="width: 100%; max-width: 440px; margin: auto; box-shadow: var(--shadow-xl); border: 1px solid var(--border-color);">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding: 18px 22px;">
      <h3 class="card-title" style="margin: 0; display: flex; align-items: center; gap: 8px;">
        <i class="uil uil-exchange text-primary"></i>
        <span>Change Invoice Status</span>
      </h3>
      <button type="button" class="btn btn-sm btn-subtle" onclick="closeStatusModal()" style="border: none; background: transparent; font-size: 1.2rem; cursor: pointer;">
        <i class="uil uil-times"></i>
      </button>
    </div>

    <form action="/invoices/<%= invoice.id %>/status" method="POST" style="padding: 22px;">
      <div class="form-group" style="margin-bottom: 16px;">
        <label for="statusSelect" class="form-label" style="font-weight: 600;">Select New Status *</label>
        <select id="statusSelect" name="status" class="form-select" required>
          <option value="PAID" <%= invoice.status === 'PAID' ? 'selected' : '' %>>PAID (Fully Settled - Clears Remaining Balance)</option>
          <option value="PARTIALLY_PAID" <%= invoice.status === 'PARTIALLY_PAID' ? 'selected' : '' %>>PARTIALLY_PAID</option>
          <option value="SENT" <%= invoice.status === 'SENT' ? 'selected' : '' %>>SENT (Awaiting Client Payment)</option>
          <option value="OVERDUE" <%= invoice.status === 'OVERDUE' ? 'selected' : '' %>>OVERDUE</option>
          <option value="CANCELLED" <%= invoice.status === 'CANCELLED' ? 'selected' : '' %>>CANCELLED</option>
          <option value="DRAFT" <%= invoice.status === 'DRAFT' ? 'selected' : '' %>>DRAFT</option>
        </select>
        <small class="text-xs text-muted" style="display: block; margin-top: 6px;">
          Note: Selecting <strong>PAID</strong> will mark the balance due as KES 0.00 and log the manual settlement.
        </small>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px; border-top: 1px solid var(--border-color); padding-top: 16px;">
        <button type="button" class="btn btn-secondary" onclick="closeStatusModal()">Cancel</button>
        <button type="submit" class="btn btn-primary">Update Status</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openManualPaymentModal() {
    const modal = document.getElementById('modalManualPayment');
    modal.style.display = 'flex';
  }
  function closeManualPaymentModal() {
    const modal = document.getElementById('modalManualPayment');
    modal.style.display = 'none';
  }
  function openStatusModal() {
    const modal = document.getElementById('modalUpdateStatus');
    modal.style.display = 'flex';
  }
  function closeStatusModal() {
    const modal = document.getElementById('modalUpdateStatus');
    modal.style.display = 'none';
  }

  document.addEventListener('DOMContentLoaded', function() {
    if (window.location.search.includes('print=1')) {
      setTimeout(function() {
        window.print();
      }, 500);
    }

    // Close modals on clicking backdrop
    window.addEventListener('click', function(e) {
      const modalPay = document.getElementById('modalManualPayment');
      const modalStatus = document.getElementById('modalUpdateStatus');
      if (e.target === modalPay) closeManualPaymentModal();
      if (e.target === modalStatus) closeStatusModal();
    });
  });
</script>
