<script>
  // ─────────────────────────────────────────────────────────────
  // 1. Cadence & Custom Months Handling
  // ─────────────────────────────────────────────────────────────
  function handleFrequencyChange(val) {
    const customGroup = document.getElementById('customIntervalGroup');
    const intervalInput = document.getElementById('intervalMonths');

    if (val === 'CUSTOM') {
      customGroup.style.display = 'block';
      if (!intervalInput.value || parseInt(intervalInput.value, 10) < 1) {
        intervalInput.value = 2;
      }
      setTimeout(() => {
        intervalInput.focus();
        intervalInput.select();
      }, 50);
    } else {
      customGroup.style.display = 'none';
      if (val === 'MONTHLY') intervalInput.value = 1;
      else if (val === 'QUARTERLY') intervalInput.value = 3;
      else if (val === 'BIANNUAL') intervalInput.value = 6;
      else if (val === 'ANNUAL') intervalInput.value = 12;
      else if (val === 'WEEKLY') intervalInput.value = 1;
      else if (val === 'BIWEEKLY') intervalInput.value = 1;
    }

    recalculateBillingTimeline();
  }

  // ─────────────────────────────────────────────────────────────
  // 2. Real-time Calculation of Elapsed Intervals & Timeline
  // ─────────────────────────────────────────────────────────────
  function calculateBillingCycles(startDateVal, frequencyVal, intervalMonthsVal, endDateVal) {
    if (!startDateVal) return { elapsed: [], upcoming: [], nextDueDate: null };

    const start = new Date(startDateVal + 'T00:00:00');
    if (isNaN(start.getTime())) return { elapsed: [], upcoming: [], nextDueDate: null };

    const end = endDateVal ? new Date(endDateVal + 'T23:59:59') : null;
    const now = new Date();
    // Reference date is end of current day
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 23, 59, 59);

    let interval = parseInt(intervalMonthsVal, 10) || 1;
    if (interval < 1) interval = 1;

    let current = new Date(start);
    const elapsed = [];
    const upcoming = [];

    let idx = 1;
    while (idx <= 180) {
      if (end && current > end) break;

      const dueDate = new Date(current);

      // Compute next cycle start
      const nextStart = new Date(current);
      if (frequencyVal === 'WEEKLY') {
        nextStart.setDate(nextStart.getDate() + 7);
      } else if (frequencyVal === 'BIWEEKLY') {
        nextStart.setDate(nextStart.getDate() + 14);
      } else if (frequencyVal === 'QUARTERLY') {
        nextStart.setMonth(nextStart.getMonth() + 3);
      } else if (frequencyVal === 'BIANNUAL') {
        nextStart.setMonth(nextStart.getMonth() + 6);
      } else if (frequencyVal === 'ANNUAL') {
        nextStart.setFullYear(nextStart.getFullYear() + 1);
      } else { // MONTHLY or CUSTOM
        nextStart.setMonth(nextStart.getMonth() + interval);
      }

      const periodEnd = new Date(nextStart);
      periodEnd.setDate(periodEnd.getDate() - 1);

      const isElapsed = dueDate <= today;

      const item = {
        index: idx,
        dueDate: dueDate,
        dueDateStr: dueDate.toLocaleDateString('en-KE', { month: 'short', day: 'numeric', year: 'numeric' }),
        periodStr: dueDate.toLocaleDateString('en-KE', { month: 'short', day: 'numeric', year: 'numeric' }) + ' - ' + periodEnd.toLocaleDateString('en-KE', { month: 'short', day: 'numeric', year: 'numeric' }),
        isElapsed: isElapsed
      };

      if (isElapsed) {
        elapsed.push(item);
      } else {
        upcoming.push(item);
        if (!end && upcoming.length >= 6) break;
      }

      current = nextStart;
      idx++;
    }

    const nextDue = upcoming.length > 0 ? upcoming[0].dueDate : (elapsed.length > 0 ? elapsed[elapsed.length - 1].dueDate : start);

    return { elapsed, upcoming, nextDueDate: nextDue };
  }

  function recalculateBillingTimeline() {
    const startDateInput = document.getElementById('startDate');
    const frequencyInput = document.getElementById('frequency');
    const intervalInput = document.getElementById('intervalMonths');
    const endDateInput = document.getElementById('endDate');
    const amountInput = document.getElementById('chargeAmount');
    const taxRateInput = document.getElementById('taxRate');
    const nextDueInput = document.getElementById('nextDueDate');

    if (!startDateInput) return;

    const startVal = startDateInput.value;
    const freqVal = frequencyInput ? frequencyInput.value : 'MONTHLY';
    const intervalVal = intervalInput ? intervalInput.value : '1';
    const endVal = endDateInput ? endDateInput.value : '';

    if (!startVal) {
      document.getElementById('accruedNoticeBanner').style.display = 'none';
      document.getElementById('projectedScheduleCard').style.display = 'none';
      return;
    }

    const result = calculateBillingCycles(startVal, freqVal, intervalVal, endVal);
    const amount = parseFloat(amountInput.value || 0) || 0;
    const taxRate = parseFloat(taxRateInput.value || 16) || 0;
    const totalPerInvoice = amount + (amount * (taxRate / 100));

    // Auto-update Next Invoice Due Date field if upcoming exists or computed
    if (result.nextDueDate && nextDueInput) {
      const formattedNext = result.nextDueDate.toISOString().split('T')[0];
      if (nextDueInput._flatpickr) {
        nextDueInput._flatpickr.setDate(formattedNext, false);
      } else {
        nextDueInput.value = formattedNext;
      }
    }

    // 1. Accrued Banner update
    const banner = document.getElementById('accruedNoticeBanner');
    if (result.elapsed.length > 0) {
      banner.style.display = 'block';
      const formattedStart = new Date(startVal).toLocaleDateString('en-KE', { month: 'short', day: 'numeric', year: 'numeric' });
      document.getElementById('noticeStartDateText').textContent = formattedStart;
      
      let cadenceLabel = freqVal;
      if (freqVal === 'CUSTOM') cadenceLabel = `Every ${intervalVal} Months`;
      else if (freqVal === 'MONTHLY') cadenceLabel = 'Monthly';
      else if (freqVal === 'QUARTERLY') cadenceLabel = 'Quarterly';
      else if (freqVal === 'BIANNUAL') cadenceLabel = 'Biannual';
      else if (freqVal === 'ANNUAL') cadenceLabel = 'Annual';
      document.getElementById('noticeCadenceText').textContent = cadenceLabel;

      const elapsedCount = result.elapsed.length;
      document.getElementById('noticeElapsedCount').textContent = elapsedCount;
      document.getElementById('noticeElapsedCountBadge').textContent = elapsedCount;
      document.getElementById('noticeCheckCount').textContent = elapsedCount;

      const totalAccrued = elapsedCount * totalPerInvoice;
      const formattedTotal = 'KES ' + totalAccrued.toLocaleString('en-KE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.getElementById('noticeElapsedTotal').textContent = formattedTotal;
      document.getElementById('noticeTotalAccruedPill').textContent = formattedTotal + ' Due';
    } else {
      banner.style.display = 'none';
    }

    // 2. Projected Schedule Table update
    const previewCard = document.getElementById('projectedScheduleCard');
    const tbody = document.getElementById('projectedScheduleTbody');
    const allCycles = [...result.elapsed, ...result.upcoming];

    if (allCycles.length > 0) {
      previewCard.style.display = 'block';
      document.getElementById('projectedCycleCountBadge').textContent = `${allCycles.length} Cycles (${result.elapsed.length} Accrued, ${result.upcoming.length} Upcoming)`;

      let html = '';
      allCycles.forEach((c) => {
        let badgeHtml = '';
        if (c.isElapsed) {
          badgeHtml = '<span class="badge badge-warning" style="font-size: 0.72rem; padding: 2px 7px;"><i class="uil uil-clock-eight"></i> Accrued (Past Due)</span>';
        } else if (result.upcoming.length > 0 && c.index === result.upcoming[0].index) {
          badgeHtml = '<span class="badge badge-info" style="font-size: 0.72rem; padding: 2px 7px;"><i class="uil uil-star"></i> Next Invoice Due</span>';
        } else {
          badgeHtml = '<span class="badge badge-subtle" style="font-size: 0.72rem; padding: 2px 7px;">Future Scheduled</span>';
        }

        const formattedAmount = totalPerInvoice > 0
          ? 'KES ' + totalPerInvoice.toLocaleString('en-KE', { minimumFractionDigits: 2 })
          : '<span class="text-muted">Set Amount</span>';

        html += `
          <tr style="${c.isElapsed ? 'background: rgba(245, 158, 11, 0.04);' : ''}">
            <td><strong>#${c.index}</strong></td>
            <td><strong style="color: ${c.isElapsed ? '#b45309' : 'inherit'};">${c.dueDateStr}</strong></td>
            <td><span class="text-xs text-muted">${c.periodStr}</span></td>
            <td><strong>${formattedAmount}</strong></td>
            <td>${badgeHtml}</td>
          </tr>
        `;
      });
      tbody.innerHTML = html;
    } else {
      previewCard.style.display = 'none';
    }
  }

  function toggleProjectedTimeline() {
    const body = document.getElementById('projectedScheduleBody');
    const icon = document.getElementById('timelineToggleIcon');
    const hint = document.getElementById('timelineToggleHint');
    if (body.style.display === 'none') {
      body.style.display = 'block';
      icon.className = 'uil uil-angle-down';
      hint.textContent = 'Click to collapse';
    } else {
      body.style.display = 'none';
      icon.className = 'uil uil-angle-right';
      hint.textContent = 'Click to expand';
    }
  }

  // ─────────────────────────────────────────────────────────────
  // 3. Contract Invoices Modal & Actions
  // ─────────────────────────────────────────────────────────────
  let currentContractInvoices = [];

  function openScheduleInvoicesModal(scheduleId, title, clientName, cadence, embeddedInvoices) {
    const modal = document.getElementById('contractInvoicesModal');
    document.getElementById('modalContractTitle').textContent = title || 'Contract Invoices';
    document.getElementById('modalContractCadence').textContent = cadence || 'Recurring';
    document.getElementById('modalContractSubtitle').innerHTML = `Client: <strong>${clientName}</strong> &bull; Generated Billing Invoices`;

    modal.classList.add('active');

    if (embeddedInvoices && embeddedInvoices.length > 0) {
      currentContractInvoices = embeddedInvoices;
      renderModalInvoices(embeddedInvoices);
    } else {
      // Fetch dynamically
      document.getElementById('modalInvoicesLoading').style.display = 'block';
      document.getElementById('modalInvoicesTableContainer').style.display = 'none';
      document.getElementById('modalInvoicesEmpty').style.display = 'none';

      fetch('/maintenance/' + scheduleId + '/invoices')
        .then(r => r.json())
        .then(data => {
          document.getElementById('modalInvoicesLoading').style.display = 'none';
          if (data.success && data.invoices && data.invoices.length > 0) {
            currentContractInvoices = data.invoices;
            renderModalInvoices(data.invoices);
          } else {
            document.getElementById('modalInvoicesEmpty').style.display = 'block';
          }
        })
        .catch(err => {
          document.getElementById('modalInvoicesLoading').style.display = 'none';
          document.getElementById('modalInvoicesEmpty').style.display = 'block';
        });
    }
  }

  function renderModalInvoices(invoices) {
    const tbody = document.getElementById('modalInvoicesTbody');
    const tableContainer = document.getElementById('modalInvoicesTableContainer');
    const emptyState = document.getElementById('modalInvoicesEmpty');

    if (!invoices || invoices.length === 0) {
      tableContainer.style.display = 'none';
      emptyState.style.display = 'block';
      return;
    }

    tableContainer.style.display = 'block';
    emptyState.style.display = 'none';

    let html = '';
    invoices.forEach(inv => {
      const isPaid = inv.status === 'PAID';
      const isOverdue = !isPaid && (new Date(inv.due_date) < new Date());
      let badgeClass = isPaid ? 'badge-success' : (isOverdue ? 'badge-danger' : 'badge-info');
      let statusLabel = isPaid ? 'PAID' : (isOverdue ? 'OVERDUE' : inv.status);

      const dueDateStr = new Date(inv.due_date).toLocaleDateString('en-KE', { month: 'short', day: 'numeric', year: 'numeric' });
      const amountStr = 'KES ' + parseFloat(inv.total_amount || 0).toLocaleString('en-KE', { minimumFractionDigits: 2 });

      html += `
        <tr id="modal-inv-row-${inv.id}">
          <td>
            <a href="/invoices/${inv.id}" target="_blank" style="font-family: monospace; font-weight: 700; color: var(--primary);">
              ${inv.invoice_number}
            </a>
          </td>
          <td>
            <div style="font-weight: 600; color: ${isOverdue ? 'var(--danger, #ef4444)' : 'inherit'};">${dueDateStr}</div>
          </td>
          <td>
            <div class="text-xs text-muted" style="max-width: 220px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="${inv.notes || ''}">
              ${inv.title || inv.notes || 'Recurring Retainer'}
            </div>
          </td>
          <td><strong>${amountStr}</strong></td>
          <td><span class="badge ${badgeClass}" style="font-size: 0.7rem; padding: 2px 6px;">${statusLabel}</span></td>
          <td style="text-align: right;">
            <div style="display: inline-flex; gap: 4px; align-items: center; justify-content: flex-end;">
              <!-- 1. View -->
              <a href="/invoices/${inv.id}" target="_blank" class="btn btn-xs btn-secondary" title="View Full Invoice Details">
                <i class="uil uil-eye"></i> <span>View</span>
              </a>

              <!-- 2. Download PDF -->
              <a href="/invoices/${inv.id}/pdf" target="_blank" class="btn btn-xs btn-secondary" title="Download Official PDF">
                <i class="uil uil-file-download-alt"></i> <span>PDF</span>
              </a>

              <!-- 3. Print -->
              <button type="button" class="btn btn-xs btn-secondary" onclick="printInvoice('${inv.id}')" title="Print Invoice Directly">
                <i class="uil uil-print"></i> <span>Print</span>
              </button>

              <!-- 4. Customize -->
              <button type="button" class="btn btn-xs btn-primary" onclick="openCustomizeModal('${inv.id}')" title="Customize template, brand colors, due date & notes">
                <i class="uil uil-palette"></i> <span>Customize</span>
              </button>

              <!-- 5. Public Pay Link -->
              ${inv.public_token ? `
                <a href="/pay/${inv.public_token}" target="_blank" class="btn btn-xs btn-outline-info" title="Open Client Payment Portal">
                  <i class="uil uil-external-link-alt"></i>
                </a>
              ` : ''}
            </div>
          </td>
        </tr>
      `;
    });

    tbody.innerHTML = html;
  }

  function closeScheduleInvoicesModal() {
    const modal = document.getElementById('contractInvoicesModal');
    if (modal) modal.classList.remove('active');
  }

  function printInvoice(id) {
    const printWin = window.open('/invoices/' + id + '?print=1', '_blank');
    if (printWin) {
      printWin.focus();
    }
  }

  // ─────────────────────────────────────────────────────────────
  // 4. Customize Invoice Modal Handling
  // ─────────────────────────────────────────────────────────────
  function openCustomizeModal(invoiceId) {
    const inv = currentContractInvoices.find(i => i.id === invoiceId);
    if (!inv) return;

    document.getElementById('custInvoiceId').value = inv.id;
    document.getElementById('custModalTitle').textContent = `Customize Invoice: ${inv.invoice_number}`;
    document.getElementById('custDocTitle').value = inv.title || '';
    document.getElementById('custNotes').value = inv.notes || '';
    document.getElementById('custTerms').value = inv.terms || '';
    document.getElementById('custFullViewLink').href = `/invoices/${inv.id}`;

    if (inv.due_date) {
      const d = new Date(inv.due_date).toISOString().split('T')[0];
      const dueDateInput = document.getElementById('custDueDate');
      if (dueDateInput._flatpickr) {
        dueDateInput._flatpickr.setDate(d, false);
      } else {
        dueDateInput.value = d;
      }
    }

    selectCustTemplate(inv.template || 'modern');
    selectCustColor(inv.custom_color || '#4F46E5');

    document.getElementById('customizeInvoiceModal').classList.add('active');
  }

  function closeCustomizeModal() {
    const modal = document.getElementById('customizeInvoiceModal');
    if (modal) modal.classList.remove('active');
  }

  function selectCustTemplate(tpl) {
    document.getElementById('custSelectedTemplate').value = tpl;
    document.querySelectorAll('.cust-tpl-btn').forEach(btn => {
      if (btn.getAttribute('data-tpl') === tpl) {
        btn.classList.remove('btn-outline-secondary');
        btn.classList.add('btn-primary');
      } else {
        btn.classList.remove('btn-primary');
        btn.classList.add('btn-outline-secondary');
      }
    });
  }

  function selectCustColor(color) {
    document.getElementById('custSelectedColor').value = color;
    document.getElementById('custColorPicker').value = color;
    document.querySelectorAll('.cust-swatch').forEach(sw => {
      if (sw.getAttribute('data-c').toLowerCase() === color.toLowerCase()) {
        sw.style.borderColor = 'var(--text-primary, #000)';
        sw.style.transform = 'scale(1.15)';
      } else {
        sw.style.borderColor = 'transparent';
        sw.style.transform = 'scale(1)';
      }
    });
  }

  function submitInvoiceCustomization(e) {
    e.preventDefault();
    const id = document.getElementById('custInvoiceId').value;
    const form = document.getElementById('customizeInvoiceForm');
    const saveBtn = document.getElementById('btnSaveCustomization');

    saveBtn.disabled = true;
    saveBtn.innerHTML = '<i class="uil uil-spinner-alt spin"></i> Saving...';

    const payload = {
      template: document.getElementById('custSelectedTemplate').value,
      customColor: document.getElementById('custSelectedColor').value,
      title: document.getElementById('custDocTitle').value,
      dueDate: document.getElementById('custDueDate').value,
      notes: document.getElementById('custNotes').value,
      terms: document.getElementById('custTerms').value,
    };

    fetch('/invoices/' + id + '/customize', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
      },
      body: JSON.stringify(payload)
    })
    .then(r => r.json())
    .then(res => {
      saveBtn.disabled = false;
      saveBtn.innerHTML = '<i class="uil uil-check"></i> Save Customization';
      closeCustomizeModal();

      // Update in local array
      const idx = currentContractInvoices.findIndex(i => i.id === id);
      if (idx !== -1) {
        currentContractInvoices[idx] = { ...currentContractInvoices[idx], ...payload };
        renderModalInvoices(currentContractInvoices);
      }

      alert('Invoice ' + (payload.title || '') + ' customized successfully!');
    })
    .catch(err => {
      saveBtn.disabled = false;
      saveBtn.innerHTML = '<i class="uil uil-check"></i> Save Customization';
      alert('Error updating invoice customization.');
    });
  }

  // ─────────────────────────────────────────────────────────────
  // 5. DOM Initialization & Event Listeners
  // ─────────────────────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', () => {
    // Set default startDate to today if empty
    const startDateInput = document.getElementById('startDate');
    if (startDateInput && !startDateInput.value) {
      const todayStr = new Date().toISOString().split('T')[0];
      startDateInput.value = todayStr;
    }

    // Attach listeners to trigger recalculations
    ['startDate', 'frequency', 'intervalMonths', 'endDate', 'chargeAmount', 'taxRate'].forEach(id => {
      const el = document.getElementById(id);
      if (el) {
        el.addEventListener('change', recalculateBillingTimeline);
        el.addEventListener('input', recalculateBillingTimeline);
      }
    });

    // Run initial calculation
    setTimeout(recalculateBillingTimeline, 300);
  });
</script>
