<!-- ═══════════════════════════════════════════════════════════════════
     Recurring Invoices & Maintenance Contracts View
     ═══════════════════════════════════════════════════════════════════ -->

<div class="maintenance-page">
  <div class="page-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
    <div class="page-title-group">
      <h1 class="page-title">Recurring Invoices & Maintenance Contracts</h1>
      <p class="page-subtitle">Automate recurring client retainers, SLA maintenance, and generate auto-invoices with M-Pesa & Card payment links.</p>
    </div>
    <div class="page-actions-group" style="display: flex; gap: 10px; align-items: center;">
      <form action="/maintenance/run-billing" method="POST" style="margin: 0;" onsubmit="return confirm('Run automated billing engine now? This will scan all active due contracts, generate sequential invoices, and email clients with payment links.')">
        <button type="submit" class="btn btn-secondary" title="Manually execute the daily billing engine">
          <i class="uil uil-bolt-alt" style="color: #f59e0b;"></i>
          <span>Run Auto-Billing Now</span>
        </button>
      </form>
    </div>
  </div>

  <!-- Summary KPI Cards -->
  <div class="kpi-grid mb-6">
    <div class="kpi-card">
      <div class="kpi-icon kpi-icon-success">
        <i class="uil uil-sync"></i>
      </div>
      <div class="kpi-content">
        <span class="kpi-label">Active Recurring Retainers</span>
        <div class="kpi-value"><%= stats.activeCount %></div>
        <span class="text-xs text-muted mt-1 block">Scheduled for automated invoicing</span>
      </div>
    </div>
    <div class="kpi-card">
      <div class="kpi-icon kpi-icon-primary">
        <i class="uil uil-money-bill"></i>
      </div>
      <div class="kpi-content">
        <span class="kpi-label">Total Monthly Recurring (MRR)</span>
        <div class="kpi-value text-primary"><%= formatKES(stats.totalMRR) %></div>
        <span class="text-xs text-muted mt-1 block">Contracted baseline recurring revenue</span>
      </div>
    </div>
    <div class="kpi-card">
      <div class="kpi-icon kpi-icon-info">
        <i class="uil uil-file-check-alt"></i>
      </div>
      <div class="kpi-content">
        <span class="kpi-label">Total Contracts</span>
        <div class="kpi-value"><%= stats.totalSchedules %></div>
        <span class="text-xs text-muted mt-1 block">All registered SLA schedules</span>
      </div>
    </div>
  </div>

  <!-- Add Schedule Card -->
  <div class="card mb-6">
    <div class="card-header">
      <div class="card-title-group">
        <div class="card-title-icon">
          <i class="uil uil-calendar-alt"></i>
        </div>
        <div>
          <h3 class="card-title">Setup Recurring Contract & Auto-Invoicing</h3>
          <p class="text-xs text-muted">Set up recurring cadence, billing start date, and intervals. The system will automatically calculate invoice due dates and detect any accrued past intervals.</p>
        </div>
      </div>
    </div>
    <div class="card-body">
      <form action="/maintenance/new" method="POST" id="maintenanceForm">
        <!-- Row 1: Basic Info -->
        <div class="form-row-2-1-1" style="display: grid; grid-template-columns: 2fr 1.2fr 1fr; gap: 14px; margin-bottom: 16px;">
          <div class="form-group">
            <label for="title" class="form-label">Contract / Retainer Title *</label>
            <input type="text" id="title" name="title" class="form-input" placeholder="e.g. Website Maintenance & Cloud Hosting SLA" required>
          </div>
          <div class="form-group">
            <label for="clientId" class="form-label">Client *</label>
            <select id="clientId" name="clientId" class="form-select" required>
              <option value="">Select Client</option>
              <% clients.forEach(function(c) { %>
                <option value="<%= c.id %>"><%= c.name %></option>
              <% }); %>
            </select>
          </div>
          <div class="form-group">
            <label for="projectId" class="form-label">Linked Project (Optional)</label>
            <select id="projectId" name="projectId" class="form-select">
              <option value="">None / General Retainer</option>
              <% projects.forEach(function(p) { %>
                <option value="<%= p.id %>"><%= p.name %> (<%= p.code %>)</option>
              <% }); %>
            </select>
          </div>
        </div>

        <!-- Row 2: Billing Cadence & Cycle Configuration -->
        <div style="background: var(--bg-tertiary); border: 1px solid var(--border-color); border-radius: var(--border-radius-lg); padding: 18px 20px; margin-bottom: 18px;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; flex-wrap: wrap; gap: 8px;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <i class="uil uil-repeat" style="color: var(--primary); font-size: 1.25rem;"></i>
              <strong style="font-size: 0.95rem;">Recurring Cadence & Billing Schedule</strong>
            </div>
            <span class="text-xs text-muted" id="cadenceSummaryBadge">Intervals & past accrued invoices auto-calculate</span>
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px;" id="cadenceRowGrid">
            <div class="form-group" style="margin-bottom: 0;">
              <label for="frequency" class="form-label" style="font-weight: 600;">Billing Cadence *</label>
              <select id="frequency" name="frequency" class="form-select" onchange="handleFrequencyChange(this.value)" required>
                <option value="MONTHLY" selected>Monthly (Every 1 Month)</option>
                <option value="QUARTERLY">Quarterly (Every 3 Months)</option>
                <option value="BIANNUAL">Biannually (Every 6 Months)</option>
                <option value="ANNUAL">Annually (Every 12 Months)</option>
                <option value="CUSTOM">Custom Months Interval...</option>
                <option value="WEEKLY">Weekly (Every 7 Days)</option>
                <option value="BIWEEKLY">Bi-Weekly (Every 14 Days)</option>
              </select>
            </div>

            <div class="form-group" id="customIntervalGroup" style="margin-bottom: 0; display: none; background: rgba(79, 70, 229, 0.08); padding: 10px 14px; border-radius: var(--border-radius-md); border: 1.5px solid var(--primary);">
              <label for="intervalMonths" class="form-label" style="font-weight: 700; color: var(--primary);">
                <i class="uil uil-sliders-v-alt"></i> Interval (Months) *
              </label>
              <div style="display: flex; align-items: center; gap: 8px;">
                <span style="font-size: 0.85rem; font-weight: 600; color: var(--text-secondary); white-space: nowrap;">Every</span>
                <input type="number" id="intervalMonths" name="intervalMonths" class="form-input" value="2" min="1" max="120" style="font-weight: 700; font-size: 1rem; width: 85px; text-align: center;" placeholder="e.g. 2, 4, 5" oninput="recalculateBillingTimeline()">
                <span style="font-size: 0.85rem; font-weight: 600; color: var(--text-secondary); white-space: nowrap;">Month(s)</span>
              </div>
              <small class="text-xs" style="color: var(--primary); display: block; margin-top: 4px;">Generates invoice every X months</small>
            </div>

            <div class="form-group" style="margin-bottom: 0;">
              <label for="startDate" class="form-label" style="font-weight: 600;">Billing Start Date *</label>
              <input type="date" id="startDate" name="startDate" class="form-input flatpickr-date" placeholder="e.g. 2026-09-01" required onchange="recalculateBillingTimeline()">
              <small class="text-xs text-muted">When billing starts running</small>
            </div>

            <div class="form-group" style="margin-bottom: 0;">
              <label for="endDate" class="form-label">Contract End Date (Optional)</label>
              <input type="date" id="endDate" name="endDate" class="form-input flatpickr-date" placeholder="e.g. 2026-12-31" onchange="recalculateBillingTimeline()">
              <small class="text-xs text-muted">Leave empty for perpetual</small>
            </div>

            <div class="form-group" style="margin-bottom: 0;">
              <label for="chargeAmount" class="form-label" style="font-weight: 600;">Retainer Amount (KES) *</label>
              <input type="number" id="chargeAmount" name="chargeAmount" class="form-input" placeholder="e.g. 25000" step="any" min="0" required oninput="recalculateBillingTimeline()">
            </div>

            <div class="form-group" style="margin-bottom: 0;">
              <label for="taxRate" class="form-label">Tax / VAT (%)</label>
              <input type="number" id="taxRate" name="taxRate" class="form-input" value="16" min="0" max="100" oninput="recalculateBillingTimeline()">
            </div>

            <div class="form-group" style="margin-bottom: 0;">
              <label for="nextDueDate" class="form-label" style="font-weight: 600;">Next Invoice Due Date *</label>
              <input type="date" id="nextDueDate" name="nextDueDate" class="form-input flatpickr-date" placeholder="e.g. 2026-10-01" required>
              <small class="text-xs text-muted">Auto-calculated cycle date</small>
            </div>
          </div>
        </div>

        <!-- Row 3: Notes -->
        <div style="margin-bottom: 16px;">
          <div class="form-group">
            <label for="notes" class="form-label">SLA Scope / Deliverables</label>
            <input type="text" id="notes" name="notes" class="form-input" placeholder="e.g. 24/7 Server uptime monitoring, monthly security patch, 5hrs minor changes">
          </div>
        </div>

        <!-- Dynamic Accrued Invoices Alert Banner -->
        <div id="accruedNoticeBanner" style="display: none; background: linear-gradient(135deg, rgba(245, 158, 11, 0.12), rgba(217, 119, 6, 0.05)); border: 1.5px solid rgba(245, 158, 11, 0.5); border-radius: var(--border-radius-lg); padding: 18px 22px; margin-bottom: 20px;">
          <div style="display: flex; gap: 16px; align-items: flex-start;">
            <div style="width: 42px; height: 42px; border-radius: 50%; background: rgba(245, 158, 11, 0.22); color: #b45309; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; flex-shrink: 0;">
              <i class="uil uil-exclamation-triangle"></i>
            </div>
            <div style="flex: 1;">
              <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
                <h4 style="margin: 0; font-size: 1.02rem; font-weight: 700; color: #b45309;">
                  Past Billing Intervals Accrued (<span id="noticeElapsedCountBadge">0</span> Invoices)
                </h4>
                <span class="badge badge-warning" id="noticeTotalAccruedPill">KES 0.00 Due</span>
              </div>
              <p style="margin: 6px 0 12px 0; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.5;">
                You selected a start date in the past (<strong id="noticeStartDateText" style="color: var(--text-primary);">...</strong>). Based on your <strong id="noticeCadenceText" style="color: var(--text-primary);">Monthly</strong> cadence, 
                <strong style="color: #b45309;"><span id="noticeElapsedCount">0</span> billing intervals have already elapsed</strong> between the start date and today. Unless an earlier end date was set, these invoices are due for issuance.
              </p>
              <div style="background: rgba(255, 255, 255, 0.7); dark:background: rgba(0,0,0,0.2); padding: 10px 14px; border-radius: var(--border-radius-md); border: 1px solid rgba(245, 158, 11, 0.25);">
                <label style="display: inline-flex; align-items: center; gap: 10px; cursor: pointer; font-size: 0.9rem; font-weight: 600; color: var(--text-primary);">
                  <input type="checkbox" id="generatePastInvoices" name="generatePastInvoices" value="true" checked style="width: 19px; height: 19px; accent-color: var(--primary);">
                  <span>Automatically generate and dispatch all <strong id="noticeCheckCount" style="color: #b45309;">0</strong> accrued past invoices now upon scheduling</span>
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- Real-time Live Projected Invoices Schedule & Due Dates Table -->
        <div id="projectedScheduleCard" style="display: none; margin-bottom: 20px; border: 1px solid var(--border-color); border-radius: var(--border-radius-lg); background: var(--bg-secondary); overflow: hidden;">
          <div style="padding: 12px 18px; background: var(--bg-tertiary); border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; cursor: pointer;" onclick="toggleProjectedTimeline()">
            <div style="display: flex; align-items: center; gap: 8px;">
              <i class="uil uil-schedule" style="color: var(--primary); font-size: 1.15rem;"></i>
              <strong style="font-size: 0.9rem;">Calculated Invoices Schedule & Due Dates Preview</strong>
              <span class="badge badge-subtle" id="projectedCycleCountBadge">0 Cycles</span>
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
              <span class="text-xs text-muted" id="timelineToggleHint">Click to collapse</span>
              <i class="uil uil-angle-down" id="timelineToggleIcon"></i>
            </div>
          </div>
          <div id="projectedScheduleBody" class="table-responsive" style="padding: 14px 18px; max-height: 280px; overflow-y: auto; overflow-x: auto; width: 100%;">
            <table class="table" style="font-size: 0.85rem; margin: 0;">
              <thead>
                <tr>
                  <th style="width: 60px;">Cycle</th>
                  <th>Calculated Due Date</th>
                  <th>Billing Coverage Period</th>
                  <th>Projected Amount</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody id="projectedScheduleTbody">
                <!-- Injected via JavaScript calculation -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- Email Delivery Checkbox -->
        <div style="margin-bottom: 20px;">
          <label style="display: inline-flex; align-items: center; gap: 8px; font-size: 0.88rem; font-weight: 600; cursor: pointer;">
            <input type="checkbox" name="autoSendEmail" checked style="width: 17px; height: 17px; accent-color: var(--primary);">
            <span>Automatically email generated invoice with PDF & online payment link to client</span>
          </label>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary" id="btn-save-maintenance">
            <i class="uil uil-plus"></i>
            <span>Schedule Recurring Contract</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Search & Date Filter Section -->
  <div class="search-filter-section">
    <form action="/maintenance" method="GET" class="filter-form">
      <div class="search-input-wrapper">
        <i class="uil uil-search"></i>
        <input type="text" name="q" class="form-input" placeholder="Search contract title, notes, client, or project..." value="<%= (typeof filters !== 'undefined' && filters.search) ? filters.search : '' %>">
      </div>

      <div class="date-filter-group">
        <div class="date-filter-item">
          <span>From:</span>
          <input type="date" name="startDate" class="form-input flatpickr-date" placeholder="e.g. 2026-09-01" value="<%= (typeof filters !== 'undefined' && filters.startDate) ? filters.startDate : '' %>">
        </div>
        <div class="date-filter-item">
          <span>To:</span>
          <input type="date" name="endDate" class="form-input flatpickr-date" placeholder="e.g. 2026-09-30" value="<%= (typeof filters !== 'undefined' && filters.endDate) ? filters.endDate : '' %>">
        </div>
      </div>

      <div class="filter-status-wrapper">
        <select name="status" class="form-select form-select-sm">
          <option value="">All Statuses</option>
          <option value="ACTIVE" <%= (typeof filters !== 'undefined' && filters.status === 'ACTIVE') ? 'selected' : '' %>>Active</option>
          <option value="PAUSED" <%= (typeof filters !== 'undefined' && filters.status === 'PAUSED') ? 'selected' : '' %>>Paused</option>
          <option value="EXPIRED" <%= (typeof filters !== 'undefined' && filters.status === 'EXPIRED') ? 'selected' : '' %>>Expired</option>
          <option value="CANCELLED" <%= (typeof filters !== 'undefined' && filters.status === 'CANCELLED') ? 'selected' : '' %>>Cancelled</option>
        </select>
      </div>

      <div class="filter-actions">
        <button type="submit" class="btn btn-sm btn-primary">
          <i class="uil uil-filter"></i>
          <span>Filter</span>
        </button>
        <% if (typeof filters !== 'undefined' && (filters.search || filters.startDate || filters.endDate || filters.status)) { %>
          <a href="/maintenance" class="btn btn-sm btn-secondary" title="Clear all filters">
            <i class="uil uil-times"></i>
            <span>Clear</span>
          </a>
        <% } %>
      </div>
    </form>
  </div>

  <!-- Contracts Table -->
  <div class="card">
    <div class="card-header">
      <div class="card-title-group">
        <div class="card-title-icon">
          <i class="uil uil-list-ul"></i>
        </div>
        <div>
          <div class="flex-align-center gap-2">
            <h2 class="card-title">Recurring Maintenance Contracts</h2>
            <span class="badge badge-subtle"><%= schedules ? schedules.length : 0 %> Listed</span>
          </div>
          <p class="card-subtitle">Active billing schedules, last generated invoices, and instant generation controls.</p>
        </div>
      </div>
    </div>
    <div class="card-body-table">
      <div class="table-scroll-hint">Swipe horizontally to view all columns &rarr;</div>
      <% if (schedules && schedules.length > 0) { %>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Contract & Scope</th>
                <th>Client</th>
                <th>Cadence</th>
                <th>Retainer</th>
                <th>Next Due Date</th>
                <th>Invoices</th>
                <th>Last Invoice</th>
                <th>Status</th>
                <th style="text-align: right;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% schedules.forEach(function(s) { 
                 const isDue = new Date(s.next_due_date) <= new Date();
                 const invoiceCount = s.invoice_count || 0;
                 const rawInvoices = s.schedule_invoices ? JSON.stringify(s.schedule_invoices) : '[]';
              %>
                <tr id="contract-row-<%= s.id %>">
                  <td>
                    <strong><%= s.title %></strong>
                    <% if (s.project_name) { %>
                      <div class="text-xs text-muted">Project: <%= s.project_name %> (<%= s.project_code %>)</div>
                    <% } %>
                    <% if (s.notes) { %>
                      <div class="text-xs text-muted" style="max-width: 240px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= s.notes %></div>
                    <% } %>
                  </td>
                  <td>
                    <div><strong><%= s.client_name %></strong></div>
                    <% if (s.client_email) { %><div class="text-xs text-muted"><i class="uil uil-envelope"></i> <%= s.client_email %></div><% } %>
                    <% if (s.client_phone) { %><div class="text-xs text-muted"><i class="uil uil-phone"></i> <%= s.client_phone %></div><% } %>
                  </td>
                  <td>
                    <span class="badge badge-info"><%= s.frequency %></span>
                    <% if (s.interval_months && s.interval_months > 1) { %>
                      <div class="text-xs text-muted mt-1">Every <%= s.interval_months %> months</div>
                    <% } %>
                    <% if (s.startdate) { %>
                      <div class="text-xs text-muted mt-0.5">Start: <%= new Date(s.startdate).toLocaleDateString('en-KE', { month: 'short', day: 'numeric', year: 'numeric' }) %></div>
                    <% } %>
                  </td>
                  <td>
                    <div class="font-bold"><%= formatKES(parseFloat(s.charge_amount)) %></div>
                    <% if (s.tax_rate > 0) { %>
                      <small class="text-xs text-muted">+<%= s.tax_rate %>% VAT</small>
                    <% } %>
                  </td>
                  <td>
                    <div style="font-weight: <%= isDue ? '700' : 'normal' %>; color: <%= isDue ? 'var(--danger, #ef4444)' : 'inherit' %>;">
                      <%= new Date(s.next_due_date).toLocaleDateString('en-KE', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                    </div>
                    <% if (isDue && s.status === 'ACTIVE') { %>
                      <span class="badge badge-warning" style="font-size: 0.7rem; padding: 2px 6px;">Due for Invoicing</span>
                    <% } %>
                  </td>
                  <td>
                    <button type="button" class="btn btn-xs btn-outline-primary" 
                            onclick='openScheduleInvoicesModal("<%= s.id %>", "<%= s.title.replace(/"/g, "&quot;") %>", "<%= s.client_name.replace(/"/g, "&quot;") %>", "<%= s.frequency %>", <%= rawInvoices %>)'
                            title="List all invoices for this contract with due dates, view, download, print, & customize">
                      <i class="uil uil-receipt-alt"></i>
                      <span><strong><%= invoiceCount %></strong> Invoices</span>
                    </button>
                  </td>
                  <td>
                    <% if (s.last_invoice_number) { %>
                      <div>
                        <a href="/invoices" style="font-family: monospace; font-weight: 700; color: var(--primary);">
                          <%= s.last_invoice_number %>
                        </a>
                      </div>
                      <div class="text-xs mt-1">
                        <% if (s.last_invoice_status === 'PAID') { %>
                          <span class="badge badge-success" style="font-size: 0.68rem;">PAID</span>
                        <% } else { %>
                          <span class="badge badge-warning" style="font-size: 0.68rem;"><%= s.last_invoice_status %></span>
                        <% } %>
                        <% if (s.last_invoice_token) { %>
                          <a href="/pay/<%= s.last_invoice_token %>" target="_blank" title="View Public Checkout Portal" style="margin-left: 4px; color: var(--slate-500);">
                            <i class="uil uil-external-link-alt"></i>
                          </a>
                        <% } %>
                      </div>
                    <% } else { %>
                      <span class="text-xs text-muted">None generated</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (s.status === 'ACTIVE') { %>
                      <span class="badge badge-success"><span class="badge-dot"></span>Active</span>
                    <% } else { %>
                      <span class="badge badge-subtle"><%= s.status %></span>
                    <% } %>
                  </td>
                  <td style="text-align: right;">
                    <div style="display: inline-flex; gap: 6px; align-items: center;">
                      <form action="/maintenance/<%= s.id %>/generate-now" method="POST" style="margin: 0;" onsubmit="return confirm('Generate and dispatch invoice for <%= s.title %> right now?')">
                        <button type="submit" class="btn btn-xs btn-primary" title="Generate invoice & email client now">
                          <i class="uil uil-file-plus-alt"></i>
                          <span>Invoice Now</span>
                        </button>
                      </form>
                      <form action="/maintenance/<%= s.id %>/toggle-status" method="POST" style="margin: 0;">
                        <button type="submit" class="btn btn-xs btn-secondary" title="<%= s.status === 'ACTIVE' ? 'Pause Auto-Invoicing' : 'Resume Auto-Invoicing' %>">
                          <i class="uil <%= s.status === 'ACTIVE' ? 'uil-pause' : 'uil-play' %>"></i>
                        </button>
                      </form>
                      <form action="/maintenance/<%= s.id %>/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete this maintenance contract schedule?')">
                        <button type="submit" class="btn btn-xs btn-danger" title="Delete Contract">
                          <i class="uil uil-trash-alt"></i>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <% if (typeof pagination !== 'undefined' && pagination) { %>
          <%- include('../../partials/pagination') %>
        <% } %>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-state-icon">
            <i class="uil uil-sync"></i>
          </div>
          <h4 class="empty-state-title">No recurring contracts found</h4>
          <p class="empty-state-text">Set up your client maintenance retainers or recurring contracts using the form above.</p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════
     Modal 1: Contract Invoices Modal (List with View, Download, Print, Customize)
     ═══════════════════════════════════════════════════════════════════ -->
<div class="modal-overlay" id="contractInvoicesModal">
  <div class="modal" style="max-width: 980px;">
    <div class="modal-header">
      <div>
        <div style="display: flex; align-items: center; gap: 8px;">
          <h3 class="modal-title" id="modalContractTitle">Contract Invoices</h3>
          <span class="badge badge-info" id="modalContractCadence">Monthly</span>
