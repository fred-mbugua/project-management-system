<!-- Monetization & Transparent Pricing Section -->
<section class="pricing-section" id="pricing">
  <div class="section-header">
    <span class="section-pill">Simple, Transparent Pricing</span>
    <h2 class="section-title">Start Free, Scale as Your Business Grows</h2>
    <p class="section-desc">
      No lock-in contracts. Upgrade or downgrade at any time with convenient M-Pesa or Card payments.
    </p>
  </div>

  <div class="pricing-grid">
    <% if (typeof plans !== 'undefined' && plans && plans.length > 0) { %>
      <% plans.forEach(function(plan) { %>
        <% const isPopular = plan.tier === 'PROFESSIONAL'; %>
        <div class="pricing-card<%= isPopular ? ' popular' : '' %>">
          <% if (isPopular) { %>
            <div class="pricing-badge">Most Popular</div>
          <% } %>
          <h3 class="plan-name"><%= plan.name %></h3>
          <p class="plan-desc"><%= plan.description || 'Full-featured ERP and Project Management suite' %></p>
          
          <div class="plan-price-wrap">
            <span class="plan-price">KES <%= Number(plan.monthlyPrice).toLocaleString('en-KE') %></span>
            <span class="plan-cycle">/ <%= (plan.frequency || 'monthly').toLowerCase() %></span>
          </div>

          <ul class="plan-features-list">
            <li class="plan-feature-item">
              <i class="uil uil-check"></i>
              <span><strong><%= plan.maxUsers %></strong> <%= plan.maxUsers === 1 ? 'Team Member' : 'Team Members' %></span>
            </li>
            <li class="plan-feature-item">
              <i class="uil uil-check"></i>
              <span><strong><%= plan.maxProjects %></strong> Active Projects</span>
            </li>
            <li class="plan-feature-item">
              <i class="uil uil-check"></i>
              <span><strong><%= plan.maxStorageMb >= 1024 ? (plan.maxStorageMb / 1024) + ' GB' : plan.maxStorageMb + ' MB' %></strong> Storage Space</span>
            </li>
            <li class="plan-feature-item">
              <i class="uil uil-check"></i>
              <span>Unlimited Free Invoices &amp; PDF Downloads</span>
            </li>
            <li class="plan-feature-item">
              <i class="uil uil-check"></i>
              <span>Unlimited Free Quotations Generator</span>
            </li>
            <% if (plan.tier === 'STARTER') { %>
            <li class="plan-feature-item">
              <i class="uil uil-check"></i>
              <span>Standard Email Support</span>
            </li>
            <% } %>
            <% if (plan.tier === 'PROFESSIONAL' || plan.tier === 'ENTERPRISE') { %>
            <li class="plan-feature-item">
              <i class="uil uil-check"></i>
              <span>Automated Safaricom M-Pesa STK Push</span>
            </li>
            <li class="plan-feature-item">
              <i class="uil uil-check"></i>
              <span>Branded Client Payment Portal &amp; SLAs</span>
            </li>
            <% } %>
            <% if (plan.tier === 'ENTERPRISE') { %>
            <li class="plan-feature-item">
              <i class="uil uil-check"></i>
              <span>Double-Entry Accounting &amp; Tax Exports</span>
            </li>
            <li class="plan-feature-item">
              <i class="uil uil-check"></i>
              <span>Immutable Audit Logs &amp; Priority 24/7 SLA</span>
            </li>
            <% } %>
          </ul>

          <a href="/auth/register?plan=<%= plan.id %>" class="btn-plan <%= isPopular ? 'btn-plan-primary' : 'btn-plan-outline' %>" id="btn-plan-<%= plan.tier.toLowerCase() %>">
            <%= isPopular ? 'Start 30-Day Pro Trial' : 'Get Started with ' + plan.name %>
          </a>
        </div>
      <% }); %>
    <% } %>
  </div>
</section>

<!-- Frequently Asked Questions (Structured for Google Rich Snippets) -->
<section class="section" id="faq">
  <div class="section-header">
    <span class="section-pill">Got Questions?</span>
    <h2 class="section-title">Frequently Asked Questions</h2>
    <p class="section-desc">
      Everything you need to know about our free invoices, quotation generator, and project management tools.
    </p>
  </div>

  <div class="faq-container">
    <div class="faq-item">
      <button class="faq-question" type="button">
        <span>Is the invoice generator really free?</span>
        <i class="uil uil-angle-down"></i>
      </button>
      <div class="faq-answer">
        Yes! Our Free Starter tier allows you to create, customize, and export professional PDF invoices with your logo, tax/VAT calculations, and bank or M-Pesa payment instructions at zero cost. There are no hidden fees or expiring trials for the free tier.
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-question" type="button">
        <span>How does the free quotation generator work?</span>
        <i class="uil uil-angle-down"></i>
      </button>
      <div class="faq-answer">
        You can build itemized estimates, add service descriptions, quantities, discounts, and validity dates. When your client reviews and approves your quotation, you can convert it into an official active invoice with a single click, eliminating duplicate data entry.
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-question" type="button">
        <span>Can my clients pay invoices directly with Safaricom M-Pesa?</span>
        <i class="uil uil-angle-down"></i>
      </button>
      <div class="faq-answer">
        Yes! PM &amp; ERP SaaS has built-in integration with Safaricom Daraja API. Clients receive a secure payment link where they can trigger an instant M-Pesa STK push PIN prompt on their phone or view Paybill / Till number payment instructions. When paid, the invoice status updates automatically.
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-question" type="button">
        <span>What features are included in the free project management system?</span>
        <i class="uil uil-angle-down"></i>
      </button>
      <div class="faq-answer">
        You can create projects, break them down into milestone tasks, assign deadlines, track project expenses against client budgets, monitor maintenance contracts and SLAs, and track overall profitability in real time.
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-question" type="button">
        <span>Is my business data secure and confidential?</span>
        <i class="uil uil-angle-down"></i>
      </button>
      <div class="faq-answer">
        Absolutely. We use bank-grade 256-bit TLS encryption in transit, strict tenant data isolation, daily automated database backups, and password security hashed with 12 rounds of bcrypt.
      </div>
    </div>
  </div>
</section>

