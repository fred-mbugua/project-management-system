<!-- ═══════════════════════════════════════════════════════════════════
     Projects Directory View
     ═══════════════════════════════════════════════════════════════════ -->

<div class="projects-page">
  <div class="page-header">
    <div class="page-title-group">
      <h1 class="page-title">Projects</h1>
      <p class="page-subtitle">Track deliverables, progress, budgets, and milestone completion.</p>
    </div>
    <div class="page-actions">
      <% if (hasModuleAccess('projects', 'manage')) { %>
      <a href="/projects/new" class="btn btn-primary" id="btn-create-project">
        <i class="uil uil-plus"></i>
        <span>New Project</span>
      </a>
      <% } %>
    </div>
  </div>

  <!-- Search & Date Filter Section -->
  <div class="search-filter-section">
    <form action="/projects" method="GET" class="filter-form">
      <div class="search-input-wrapper">
        <i class="uil uil-search"></i>
        <input type="text" name="q" class="form-input" placeholder="Search project name, code, client, or description..." value="<%= (typeof filters !== 'undefined' && filters.search) ? filters.search : '' %>">
      </div>

      <div class="date-filter-group">
        <div class="date-filter-item">
          <span>From:</span>
          <input type="date" name="startDate" class="form-input" placeholder="e.g. 2026-09-01" value="<%= (typeof filters !== 'undefined' && filters.startDate) ? filters.startDate : '' %>">
        </div>
        <div class="date-filter-item">
          <span>To:</span>
          <input type="date" name="endDate" class="form-input" placeholder="e.g. 2026-09-30" value="<%= (typeof filters !== 'undefined' && filters.endDate) ? filters.endDate : '' %>">
        </div>
      </div>

      <div class="filter-status-wrapper">
        <select name="status" class="form-select form-select-sm">
          <option value="">All Statuses</option>
          <option value="PLANNING" <%= (typeof filters !== 'undefined' && filters.status === 'PLANNING') ? 'selected' : '' %>>Planning</option>
          <option value="IN_PROGRESS" <%= (typeof filters !== 'undefined' && filters.status === 'IN_PROGRESS') ? 'selected' : '' %>>In Progress</option>
          <option value="ON_HOLD" <%= (typeof filters !== 'undefined' && filters.status === 'ON_HOLD') ? 'selected' : '' %>>On Hold</option>
          <option value="COMPLETED" <%= (typeof filters !== 'undefined' && filters.status === 'COMPLETED') ? 'selected' : '' %>>Completed</option>
          <option value="CANCELLED" <%= (typeof filters !== 'undefined' && filters.status === 'CANCELLED') ? 'selected' : '' %>>Cancelled</option>
        </select>
      </div>

      <div class="filter-actions">
        <button type="submit" class="btn btn-sm btn-primary">
          <i class="uil uil-filter"></i>
          <span>Filter</span>
        </button>
        <% if (typeof filters !== 'undefined' && (filters.search || filters.startDate || filters.endDate || filters.status)) { %>
          <a href="/projects" class="btn btn-sm btn-secondary" title="Clear all filters">
            <i class="uil uil-times"></i>
            <span>Clear</span>
          </a>
        <% } %>
      </div>
    </form>
  </div>

  <div class="card">
    <div class="card-header">
      <div class="card-title-group">
        <div class="card-title-icon">
          <i class="uil uil-folder"></i>
        </div>
        <div>
          <div class="flex-align-center gap-2">
            <h2 class="card-title">Projects Directory</h2>
            <span class="badge badge-subtle"><%= projects ? projects.length : 0 %> Listed</span>
          </div>
          <p class="card-subtitle">Manage project scopes, deliverables, budgets, and status tracking</p>
        </div>
      </div>
      <% if (hasModuleAccess('projects', 'manage')) { %>
      <div class="flex-align-center gap-2">
        <a href="/projects/new" class="btn btn-sm btn-primary">
          <i class="uil uil-plus"></i>
          <span>New Project</span>
        </a>
      </div>
      <% } %>
    </div>
    <div class="card-body-table">
      <% if (projects && projects.length > 0) { %>
        <div class="table-scroll-hint">
          <i class="uil uil-arrows-h"></i>
          <span>Swipe to view all</span>
        </div>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Code</th>
                <th>Project Name</th>
                <th>Client</th>
                <th>Budget</th>
                <th>Tasks</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% projects.forEach(function(p) { %>
                <tr>
                  <td><span class="badge badge-subtle"><%= p.code %></span></td>
                  <td>
                    <a href="/projects/<%= p.id %>" class="font-semibold text-primary"><strong><%= p.name %></strong></a>
                    <% if (p.description) { %>
                      <p class="text-xs text-muted truncate-cell"><%= p.description %></p>
                    <% } %>

                  </td>
                  <td><%= p.client_name || 'Internal' %></td>
                  <td><strong><%= p.budget ? formatKES(parseFloat(p.budget)) : '—' %></strong></td>
                  <td>
                    <span class="text-sm font-medium"><%= p.completed_task_count %> / <%= p.task_count %> completed</span>
                  </td>
                  <td>
                    <% if (p.status === 'IN_PROGRESS') { %>
                      <span class="badge badge-info"><span class="badge-dot"></span>In Progress</span>
                    <% } else if (p.status === 'COMPLETED') { %>
                      <span class="badge badge-success"><span class="badge-dot"></span>Completed</span>
                    <% } else if (p.status === 'PLANNING') { %>
                      <span class="badge badge-secondary"><span class="badge-dot"></span>Planning</span>
                    <% } else { %>
                      <span class="badge badge-warning"><span class="badge-dot"></span><%= p.status %></span>
                    <% } %>
                  </td>
                  <td>
                    <div style="display: flex; gap: 6px; align-items: center;">
                      <a href="/projects/<%= p.id %>" class="btn btn-sm btn-secondary" title="Open Project">
                        <i class="uil uil-folder-open"></i>
                        <span>Open</span>
                      </a>
                      <form action="/projects/<%= p.id %>/delete" method="POST" style="display: inline-block; margin: 0;" onsubmit="return confirm('Are you sure you want to delete this project? All tasks and documents will be removed, and an audit log will be retained.');">
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Project">
                          <i class="uil uil-trash-alt"></i>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <% if (typeof pagination !== 'undefined' && pagination) { %>
          <%- include('../../partials/pagination') %>
        <% } %>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-state-icon"><i class="uil uil-folder-plus"></i></div>
          <p class="empty-state-title">No projects found</p>
          <p class="empty-state-message">Create your first client deliverable or internal milestone project.</p>
          <a href="/projects/new" class="btn btn-primary btn-sm mt-3">
            <i class="uil uil-plus"></i>
            <span>Create Project</span>
          </a>
        </div>
      <% } %>
    </div>
  </div>
</div>
