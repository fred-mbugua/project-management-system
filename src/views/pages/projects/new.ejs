<!-- ═══════════════════════════════════════════════════════════════════
     Create Project Form
     ═══════════════════════════════════════════════════════════════════ -->

<div class="new-project-page">
  <div class="page-header">
    <div class="page-title-group">
      <h1 class="page-title">Create New Project</h1>
      <p class="page-subtitle">Initiate a client deliverable or internal initiative.</p>
    </div>
    <div class="page-actions">
      <a href="/projects" class="btn btn-secondary">
        <i class="uil uil-arrow-left"></i>
        <span>Cancel</span>
      </a>
    </div>
  </div>

  <div class="card max-w-form">
    <div class="card-body">
      <form action="/projects/new" method="POST" class="form-stack">
        <div class="form-row-2-1">
          <div class="form-group">
            <label class="form-label" for="name">Project Name *</label>
            <input type="text" class="form-input" id="name" name="name" required placeholder="e.g. Data Center Modernization">
          </div>
          <div class="form-group">
            <label class="form-label" for="code">Project Code *</label>
            <input type="text" class="form-input" id="code" name="code" required placeholder="e.g. PRJ-004">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="clientId">Associated Client</label>
            <select class="form-select" id="clientId" name="clientId">
              <option value="">-- Internal / No Client --</option>
              <% if (clients && clients.length > 0) { %>
                <% clients.forEach(function(c) { %>
                  <option value="<%= c.id %>"><%= c.name %></option>
                <% }); %>
              <% } %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="budget">Total Budget (KES)</label>
            <input type="number" step="0.01" class="form-input" id="budget" name="budget" placeholder="1500000">
          </div>
        </div>

        <div class="form-row-3">
          <div class="form-group">
            <label class="form-label" for="status">Initial Status</label>
            <select class="form-select" id="status" name="status">
              <option value="PLANNING">Planning</option>
              <option value="IN_PROGRESS" selected>In Progress</option>
              <option value="ON_HOLD">On Hold</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="startDate">Start Date</label>
            <input type="date" class="form-input" id="startDate" name="startDate">
          </div>
          <div class="form-group">
            <label class="form-label" for="endDate">Target End Date</label>
            <input type="date" class="form-input" id="endDate" name="endDate">
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="description">Scope & Description</label>
          <textarea class="form-input" id="description" name="description" rows="4" placeholder="Detail the deliverable scope, milestones, or technical requirements..."></textarea>
        </div>

        <div class="form-actions">
          <a href="/projects" class="btn btn-secondary">Cancel</a>
          <button type="submit" class="btn btn-primary" id="btn-save-project">
            <i class="uil uil-check"></i>
            <span>Create Project</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
