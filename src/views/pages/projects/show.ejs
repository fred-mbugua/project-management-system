<!-- ═══════════════════════════════════════════════════════════════════
     Project Detail View (Tasks, Budget, Team)
     ═══════════════════════════════════════════════════════════════════ -->

<div class="project-detail-page">
  <div class="page-header">
    <div class="page-title-group">
      <div class="flex-align-center gap-2">
        <span class="badge badge-subtle"><%= project.code %></span>
        <h1 class="page-title m-0"><%= project.name %></h1>
      </div>
      <p class="page-subtitle">
        Client: <strong><%= project.client_name || 'Internal' %></strong> 
        &bull; Status: <span class="badge badge-info"><%= project.status %></span>
      </p>
    </div>
    <div class="page-actions" style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
      <a href="/projects" class="btn btn-secondary">
        <i class="uil uil-arrow-left"></i>
        <span>Back to Projects</span>
      </a>
      <form action="/projects/<%= project.id %>/delete" method="POST" style="display: inline-block; margin: 0;" onsubmit="return confirm('Are you sure you want to delete this project? All tasks and documents will be removed, and an audit trail will be preserved.');">
        <button type="submit" class="btn btn-danger" title="Delete Project">
          <i class="uil uil-trash-alt"></i>
          <span>Delete Project</span>
        </button>
      </form>
    </div>
  </div>

  <!-- Project Metadata Grid -->
  <div class="kpi-grid">
    <div class="kpi-card kpi-card-indigo">
      <div class="kpi-icon kpi-icon-indigo">
        <i class="uil uil-bill"></i>
      </div>
      <div class="kpi-info">
        <span class="kpi-label">Project Budget</span>
        <span class="kpi-value"><%= project.budget ? formatKES(parseFloat(project.budget)) : 'Not set' %></span>
      </div>
    </div>
    <div class="kpi-card kpi-card-emerald">
      <div class="kpi-icon kpi-icon-emerald">
        <i class="uil uil-check-circle"></i>
      </div>
      <div class="kpi-info">
        <span class="kpi-label">Tasks Progress</span>
        <span class="kpi-value"><%= tasks.filter(t => t.status === 'COMPLETED').length %> / <%= tasks.length %></span>
      </div>
    </div>
    <div class="kpi-card kpi-card-cyan">
      <div class="kpi-icon kpi-icon-cyan">
        <i class="uil uil-calendar-alt"></i>
      </div>
      <div class="kpi-info">
        <span class="kpi-label">Timeline</span>
        <span class="kpi-value kpi-timeline-value">
          <span><%= project.start_date ? new Date(project.start_date).toLocaleDateString() : 'N/A' %></span>
          <i class="uil uil-arrow-right text-muted"></i>
          <span><%= project.end_date ? new Date(project.end_date).toLocaleDateString() : 'Ongoing' %></span>
        </span>
      </div>
    </div>
  </div>

  <% if (project.description) { %>
    <div class="card mt-6">
      <div class="card-body">
        <h3 class="stat-panel-label mb-2">Project Overview</h3>
        <p class="project-overview-text"><%= project.description %></p>
      </div>
    </div>
  <% } %>


  <!-- Tasks Section -->
  <div class="project-layout-grid mt-6">
    <div class="card">
      <div class="card-header">
        <h2 class="card-title">Tasks & Deliverables</h2>
        <span class="text-xs text-muted"><%= tasks.length %> Total Tasks</span>
      </div>
      <div class="card-body-table">
        <% if (tasks && tasks.length > 0) { %>
          <div class="table-scroll-hint">
            <i class="uil uil-arrows-h"></i>
            <span>Swipe to view all</span>
          </div>
          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>Task</th>
                  <th>Assignee</th>
                  <th>Priority</th>
                  <th>Status</th>
                  <th class="text-right">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% tasks.forEach(function(t) { %>
                  <tr>
                    <td>
                      <strong><%= t.title %></strong>
                      <% if (t.description) { %>
                        <br><small class="text-tertiary"><%= t.description %></small>
                      <% } %>
                    </td>
                    <td><%= t.first_name ? t.first_name + ' ' + t.last_name : 'Unassigned' %></td>
                    <td>
                      <% if (t.priority === 'URGENT') { %>
                        <span class="badge badge-danger">Urgent</span>
                      <% } else if (t.priority === 'HIGH') { %>
                        <span class="badge badge-warning">High</span>
                      <% } else { %>
                        <span class="badge badge-subtle"><%= t.priority %></span>
                      <% } %>
                    </td>
                    <td>
                      <% if (t.status === 'COMPLETED') { %>
                        <span class="badge badge-success"><span class="badge-dot"></span>Done</span>
                      <% } else if (t.status === 'IN_PROGRESS') { %>
                        <span class="badge badge-info"><span class="badge-dot"></span>In Progress</span>
                      <% } else { %>
                        <span class="badge badge-secondary"><%= t.status %></span>
                      <% } %>
                    </td>
                    <td class="text-right">
                      <form action="/projects/<%= project.id %>/tasks/<%= t.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this task? An audit log will be retained.');">
                        <button type="submit" class="btn btn-xs btn-outline-danger" title="Delete Task" style="padding: 4px 8px; font-size: 0.8rem; border-radius: 4px;">
                          <i class="uil uil-trash-alt"></i>
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">
            <div class="empty-state-icon"><i class="uil uil-clipboard-notes"></i></div>
            <p class="empty-state-title">No tasks yet</p>
            <p class="empty-state-message">Add deliverables and milestones using the form on the right.</p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Quick Add Task Form -->
    <div class="card">
      <div class="card-header">
        <h2 class="card-title">Add New Task</h2>
      </div>
      <div class="card-body">
        <form action="/projects/<%= project.id %>/tasks" method="POST" class="form-stack">
          <div class="form-group">
            <label class="form-label" for="taskTitle">Task Title *</label>
            <input type="text" class="form-input" id="taskTitle" name="title" required placeholder="e.g. Conduct cabling tests">
          </div>

          <div class="form-group">
            <label class="form-label" for="assignedToId">Assign To</label>
            <select class="form-select" id="assignedToId" name="assignedToId">
              <option value="">-- Unassigned --</option>
              <% if (teamUsers && teamUsers.length > 0) { %>
                <% teamUsers.forEach(function(u) { %>
                  <option value="<%= u.id %>"><%= u.first_name %> <%= u.last_name %> (<%= u.role %>)</option>
                <% }); %>
              <% } %>
            </select>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="priority">Priority</label>
              <select class="form-select" id="priority" name="priority">
                <option value="LOW">Low</option>
                <option value="MEDIUM" selected>Medium</option>
                <option value="HIGH">High</option>
                <option value="URGENT">Urgent</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label" for="dueDate">Due Date</label>
              <input type="date" class="form-input" id="dueDate" name="dueDate" placeholder="e.g. 2026-10-15">
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="taskDesc">Details / Notes</label>
            <textarea class="form-input" id="taskDesc" name="description" rows="3" placeholder="Brief technical or delivery notes..."></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-block">
            <i class="uil uil-plus"></i>
            <span>Add Task</span>
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Project Documents Section -->
  <div class="project-layout-grid mt-6">
    <div class="card">
      <div class="card-header flex-between">
        <div>
          <h2 class="card-title">Project Documents & Files</h2>
          <span class="text-xs text-muted">Stored securely in cloud storage &bull; <%= (typeof documents !== 'undefined' && documents) ? documents.length : 0 %> files</span>
        </div>
        <span class="badge badge-subtle">
          <i class="uil uil-cloud"></i> Cloud Storage
        </span>
      </div>
      <div class="card-body-table">
        <% if (typeof documents !== 'undefined' && documents && documents.length > 0) { %>
          <div class="table-scroll-hint">
            <i class="uil uil-arrows-h"></i>
            <span>Swipe to view all</span>
          </div>
          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>Document Name</th>
                  <th>Uploaded By</th>
                  <th>Size</th>
                  <th>Date</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% documents.forEach(function(doc) { %>
                  <tr>
                    <td>
                      <div class="flex-align-center gap-2">
                        <i class="uil uil-file-alt text-primary" style="font-size: 1.25rem;"></i>
                        <div>
                          <strong><%= doc.name %></strong>
                          <% if (doc.file_type) { %>
                            <br><small class="text-tertiary"><%= doc.file_type %></small>
                          <% } %>
                        </div>
                      </div>
                    </td>
                    <td><%= (doc.first_name ? (doc.first_name + ' ' + (doc.last_name || '')) : 'System') %></td>
                    <td>
                      <% 
                        const bytes = doc.file_size || 0;
                        const sizeStr = bytes > 1048576 
                          ? (bytes / (1024 * 1024)).toFixed(1) + ' MB' 
                          : (bytes > 1024 ? (bytes / 1024).toFixed(0) + ' KB' : bytes + ' B');
                      %>
                      <span class="badge badge-subtle"><%= sizeStr %></span>
                    </td>
                    <td><%= new Date(doc.created_at).toLocaleDateString() %></td>
                    <td>
                      <div class="table-actions">
                        <a href="<%= doc.file_url %>" class="btn btn-sm btn-secondary" target="_blank" download title="View/Download Document">
                          <i class="uil uil-download-alt"></i>
                          <span>Download</span>
                        </a>
                        <form action="/projects/<%= project.id %>/documents/<%= doc.id %>/delete" method="POST" class="inline-block" onsubmit="return confirm('Are you sure you want to delete this document?');">
                          <button type="submit" class="btn btn-sm btn-danger" title="Delete file">
                            <i class="uil uil-trash-alt"></i>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state p-6">
            <div class="empty-state-icon"><i class="uil uil-cloud-upload"></i></div>
            <p class="empty-state-title">No documents uploaded yet</p>
            <p class="empty-state-message">Attach contracts, architectural blueprints, technical specs, and project deliverables.</p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Upload Document Form -->
    <div class="card">
      <div class="card-header">
        <h2 class="card-title">Upload Project Document</h2>
      </div>
      <div class="card-body">
        <form action="/projects/<%= project.id %>/documents" method="POST" enctype="multipart/form-data" class="form-stack">
          <div class="form-group">
            <label class="form-label" for="documentName">Document Title (Optional)</label>
            <input type="text" class="form-input" id="documentName" name="documentName" placeholder="e.g. Architectural Blueprint Rev 2">
            <small class="text-tertiary">Leave blank to use original filename</small>
          </div>

          <div class="form-group">
            <label class="form-label" for="projectDocFile">Select File *</label>
            <input type="file" class="form-input" id="projectDocFile" name="document" required accept=".pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.zip,.png,.jpg,.jpeg,.webp">
            <small class="text-tertiary">Max file size: 15 MB (PDF, Word, Excel, CSV, Images, CAD/Zip)</small>
          </div>

          <div class="bg-tertiary p-3 rounded mb-3 flex-align-center gap-2">
            <i class="uil uil-shield-check text-success" style="font-size: 1.25rem;"></i>
            <span class="text-xs text-secondary">Uploaded files are stored securely with high durability.</span>
          </div>

          <button type="submit" class="btn btn-primary btn-block">
            <i class="uil uil-cloud-upload"></i>
            <span>Upload Document</span>
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Assigned Team Members Section -->
  <div class="project-layout-grid mt-6">
    <div class="card">
      <div class="card-header flex-between">
        <div>
          <h2 class="card-title">Assigned Project Team</h2>
          <span class="text-xs text-muted"><%= (typeof teamMembers !== 'undefined' && teamMembers) ? teamMembers.length : 0 %> Members assigned to this project</span>
        </div>
        <span class="badge badge-subtle">
          <i class="uil uil-users-alt"></i> Workforce
        </span>
      </div>
      <div class="card-body-table">
        <% if (typeof teamMembers !== 'undefined' && teamMembers && teamMembers.length > 0) { %>
          <div class="table-scroll-hint">
            <i class="uil uil-arrows-h"></i>
            <span>Swipe to view all</span>
          </div>
          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>Team Member</th>
                  <th>Email</th>
                  <th>Project Role</th>
                  <th>Contact</th>
                  <% if (typeof hasModuleAccess === 'function' && hasModuleAccess('projects', 'manage')) { %>
                    <th class="text-right">Actions</th>
                  <% } %>
                </tr>
              </thead>
              <tbody>
                <% teamMembers.forEach(function(member) { %>
                  <tr>
                    <td>
                      <div class="flex-align-center gap-2">
                        <div class="avatar-circle">
                          <%= (member.first_name ? member.first_name.charAt(0) : '') + (member.last_name ? member.last_name.charAt(0) : '') %>
                        </div>
                        <div>
                          <strong><%= member.first_name %> <%= member.last_name %></strong>
                          <div class="text-xs text-muted"><%= member.role ? member.role.replace(/_/g, ' ') : 'Member' %></div>
                        </div>
                      </div>
                    </td>
                    <td><%= member.email %></td>
                    <td>
                      <span class="badge badge-info"><%= member.project_role || 'Contributor' %></span>
                      <% if (member.source === 'task') { %>
                        <span class="badge badge-subtle text-xs" title="Assigned via active project task">Task Lead</span>
                      <% } %>
                    </td>
                    <td><%= member.phone || '—' %></td>
                    <% if (typeof hasModuleAccess === 'function' && hasModuleAccess('projects', 'manage')) { %>
                      <td class="text-right">
                        <% if (member.source === 'member') { %>
                          <form action="/projects/<%= project.id %>/members/<%= member.user_id %>/delete" method="POST" class="inline-block" onsubmit="return confirm('Remove <%= member.first_name %> from this project?');">
                            <button type="submit" class="btn btn-xs btn-outline-danger" title="Remove from project">
                              <i class="uil uil-user-minus"></i>
                              <span>Remove</span>
                            </button>
                          </form>
                        <% } else { %>
                          <span class="text-xs text-muted">Via Task</span>
                        <% } %>
                      </td>
                    <% } %>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state p-6">
            <div class="empty-state-icon"><i class="uil uil-user-times"></i></div>
            <p class="empty-state-title">No team members assigned</p>
            <p class="empty-state-message">Add team members or assign them tasks to grant them access to this project.</p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Assign Member Form (if user can manage projects) -->
    <% if (typeof hasModuleAccess === 'function' && hasModuleAccess('projects', 'manage')) { %>
      <div class="card">
        <div class="card-header">
          <h2 class="card-title">Assign Team Member</h2>
        </div>
        <div class="card-body">
          <form action="/projects/<%= project.id %>/members" method="POST" class="form-stack">
            <div class="form-group">
              <label class="form-label" for="memberUserId">Select User *</label>
              <select class="form-select" id="memberUserId" name="userId" required>
                <option value="">-- Choose Member --</option>
                <% 
                  const usersToDisplay = (typeof availableUsers !== 'undefined' && availableUsers && availableUsers.length > 0)
                    ? availableUsers
                    : ((typeof teamUsers !== 'undefined' && teamUsers) ? teamUsers : []);
                %>
                <% if (usersToDisplay && usersToDisplay.length > 0) { %>
                  <% usersToDisplay.forEach(function(u) { %>
                    <option value="<%= u.id %>"><%= u.first_name %> <%= u.last_name %> (<%= u.role ? u.role.replace(/_/g, ' ') : '' %>)</option>
                  <% }); %>
                <% } else { %>
                  <option value="" disabled>No team members available</option>
                <% } %>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="projectRole">Project Role / Designation</label>
              <input type="text" class="form-input" id="projectRole" name="roleInProject" list="project-roles-list" placeholder="e.g. Team Leader, Lead Engineer, Contributor">
              <datalist id="project-roles-list">
                <option value="Team Leader">
                <option value="Project Lead">
                <option value="Lead Engineer">
                <option value="Senior Developer">
                <option value="Site Supervisor">
                <option value="Quality Assurance">
                <option value="Contributor">
              </datalist>
              <div class="flex gap-1 mt-2 flex-wrap">
                <button type="button" class="btn btn-xs btn-subtle" onclick="document.getElementById('projectRole').value='Team Leader';">Team Leader</button>
                <button type="button" class="btn btn-xs btn-subtle" onclick="document.getElementById('projectRole').value='Lead Engineer';">Lead Engineer</button>
                <button type="button" class="btn btn-xs btn-subtle" onclick="document.getElementById('projectRole').value='Contributor';">Contributor</button>
              </div>
            </div>

            <div class="bg-tertiary p-3 rounded mb-3 flex-align-center gap-2">
              <i class="uil uil-info-circle text-primary" style="font-size: 1.25rem;"></i>
              <span class="text-xs text-secondary">Assigning a user grants them full visibility into this project, its tasks, quotations, and invoices.</span>
            </div>

            <button type="submit" class="btn btn-primary btn-block">
              <i class="uil uil-user-plus"></i>
              <span>Assign to Project</span>
            </button>
          </form>
        </div>
      </div>
    <% } %>
  </div>

  <!-- Associated Financial Items (Invoices & Quotations) -->
  <%
    const canSeeInvoices = (typeof hasModuleAccess === 'function') ? hasModuleAccess('invoices') : true;
    const canSeeQuotations = (typeof hasModuleAccess === 'function') ? hasModuleAccess('quotations') : true;
  %>
  <% if (canSeeInvoices || canSeeQuotations) { %>
    <div class="project-layout-grid mt-6">
      <!-- Associated Invoices -->
      <% if (canSeeInvoices) { %>
        <div class="card">
          <div class="card-header flex-between">
            <div>
              <h2 class="card-title">Associated Invoices</h2>
              <span class="text-xs text-muted"><%= (typeof invoices !== 'undefined' && invoices) ? invoices.length : 0 %> billing records</span>
            </div>
            <% if (typeof hasModuleAccess === 'function' && hasModuleAccess('invoices', 'manage')) { %>
              <a href="/invoices/new?projectId=<%= project.id %>" class="btn btn-xs btn-primary">
                <i class="uil uil-plus"></i> New Invoice
              </a>
            <% } %>
          </div>
          <div class="card-body-table">
            <% if (typeof invoices !== 'undefined' && invoices && invoices.length > 0) { %>
              <div class="table-responsive">
                <table class="table">
                  <thead>
                    <tr>
                      <th>Invoice #</th>
                      <th>Amount</th>
                      <th>Status</th>
                      <th class="text-right">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% invoices.forEach(function(inv) { %>
                      <tr>
                        <td>
                          <strong><a href="/invoices/<%= inv.id %>"><%= inv.invoice_number %></a></strong>
                          <div class="text-xs text-muted"><%= new Date(inv.issue_date).toLocaleDateString() %></div>
                        </td>
                        <td><%= formatKES(parseFloat(inv.total_amount || 0)) %></td>
                        <td>
                          <% if (inv.status === 'PAID') { %>
                            <span class="badge badge-success">Paid</span>
                          <% } else if (inv.status === 'OVERDUE') { %>
                            <span class="badge badge-danger">Overdue</span>
                          <% } else { %>
                            <span class="badge badge-info"><%= inv.status %></span>
                          <% } %>
                        </td>
                        <td class="text-right">
                          <a href="/invoices/<%= inv.id %>" class="btn btn-xs btn-secondary" title="View Invoice">
                            <i class="uil uil-eye"></i>
                          </a>
                          <a href="/invoices/<%= inv.id %>/pdf" class="btn btn-xs btn-outline-secondary" title="Download PDF">
                            <i class="uil uil-download-alt"></i>
                          </a>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="empty-state p-4">
                <p class="empty-state-title text-sm">No invoices linked</p>
                <p class="empty-state-message text-xs">No invoices have been billed against this project yet.</p>
              </div>
            <% } %>
          </div>
        </div>
      <% } %>

      <!-- Associated Quotations -->
      <% if (canSeeQuotations) { %>
        <div class="card">
          <div class="card-header flex-between">
            <div>
              <h2 class="card-title">Associated Quotations</h2>
              <span class="text-xs text-muted"><%= (typeof quotations !== 'undefined' && quotations) ? quotations.length : 0 %> estimates & quotes</span>
            </div>
            <% if (typeof hasModuleAccess === 'function' && hasModuleAccess('quotations', 'manage')) { %>
              <a href="/quotations/new?projectId=<%= project.id %>" class="btn btn-xs btn-primary">
                <i class="uil uil-plus"></i> New Quote
              </a>
            <% } %>
          </div>
          <div class="card-body-table">
            <% if (typeof quotations !== 'undefined' && quotations && quotations.length > 0) { %>
              <div class="table-responsive">
                <table class="table">
                  <thead>
                    <tr>
                      <th>Quote #</th>
                      <th>Amount</th>
                      <th>Status</th>
                      <th class="text-right">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% quotations.forEach(function(q) { %>
                      <tr>
                        <td>
                          <strong><a href="/quotations/<%= q.id %>"><%= q.quotation_number %></a></strong>
                          <div class="text-xs text-muted"><%= new Date(q.created_at).toLocaleDateString() %></div>
                        </td>
                        <td><%= formatKES(parseFloat(q.total_amount || 0)) %></td>
                        <td>
                          <% if (q.status === 'ACCEPTED') { %>
                            <span class="badge badge-success">Accepted</span>
                          <% } else if (q.status === 'CONVERTED') { %>
                            <span class="badge badge-primary">Invoiced</span>
                          <% } else { %>
                            <span class="badge badge-info"><%= q.status %></span>
                          <% } %>
                        </td>
                        <td class="text-right">
                          <a href="/quotations/<%= q.id %>" class="btn btn-xs btn-secondary" title="View Quote">
                            <i class="uil uil-eye"></i>
                          </a>
                          <a href="/quotations/<%= q.id %>/pdf" class="btn btn-xs btn-outline-secondary" title="Download PDF">
                            <i class="uil uil-download-alt"></i>
                          </a>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="empty-state p-4">
                <p class="empty-state-title text-sm">No quotations linked</p>
                <p class="empty-state-message text-xs">No estimates or quotations have been created for this project.</p>
              </div>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>
  <% } %>
</div>
