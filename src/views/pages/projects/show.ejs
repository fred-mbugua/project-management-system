<!-- ═══════════════════════════════════════════════════════════════════
     Project Detail View (Tasks, Budget, Team)
     ═══════════════════════════════════════════════════════════════════ -->

<div class="project-detail-page">
  <div class="page-header">
    <div class="page-title-group">
      <div class="flex-align-center gap-2">
        <span class="badge badge-subtle"><%= project.code %></span>
        <h1 class="page-title m-0"><%= project.name %></h1>
      </div>
      <p class="page-subtitle">
        Client: <strong><%= project.client_name || 'Internal' %></strong> 
        &bull; Status:
        <% if (project.status === 'IN_PROGRESS') { %>
          <span class="badge badge-info"><span class="badge-dot"></span>In Progress</span>
        <% } else if (project.status === 'COMPLETED') { %>
          <span class="badge badge-success"><span class="badge-dot"></span>Completed</span>
        <% } else if (project.status === 'PLANNING') { %>
          <span class="badge badge-secondary"><span class="badge-dot"></span>Planning</span>
        <% } else if (project.status === 'ON_HOLD') { %>
          <span class="badge badge-warning"><span class="badge-dot"></span>On Hold</span>
        <% } else if (project.status === 'CANCELLED') { %>
          <span class="badge badge-danger"><span class="badge-dot"></span>Cancelled</span>
        <% } else { %>
          <span class="badge badge-info"><%= project.status %></span>
        <% } %>
      </p>
    </div>
    <div class="page-actions" style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
      <a href="/projects" class="btn btn-secondary">
        <i class="uil uil-arrow-left"></i>
        <span>Back to Projects</span>
      </a>
      <% if (typeof hasModuleAccess === 'function' && hasModuleAccess('projects', 'manage')) { %>
        <a href="/projects/<%= project.id %>/edit" class="btn btn-primary" id="btn-edit-project">
          <i class="uil uil-edit"></i>
          <span>Edit Project</span>
        </a>
        <form action="/projects/<%= project.id %>/delete" method="POST" style="display: inline-block; margin: 0;" onsubmit="return confirm('Are you sure you want to delete this project? All tasks and documents will be removed, and an audit trail will be preserved.');">
          <button type="submit" class="btn btn-danger" title="Delete Project">
            <i class="uil uil-trash-alt"></i>
            <span>Delete Project</span>
          </button>
        </form>
      <% } %>
    </div>
  </div>

  <!-- Project Metadata Grid -->
  <div class="kpi-grid">
    <div class="kpi-card kpi-card-indigo">
      <div class="kpi-icon kpi-icon-indigo">
        <i class="uil uil-bill"></i>
      </div>
      <div class="kpi-info">
        <span class="kpi-label">Project Budget</span>
        <span class="kpi-value"><%= project.budget ? formatKES(parseFloat(project.budget)) : 'Not set' %></span>
      </div>
    </div>
    <div class="kpi-card kpi-card-emerald">
      <div class="kpi-icon kpi-icon-emerald">
        <i class="uil uil-check-circle"></i>
      </div>
      <div class="kpi-info">
        <span class="kpi-label">Tasks Progress</span>
        <span class="kpi-value"><%= tasks.filter(t => t.status === 'COMPLETED').length %> / <%= tasks.length %></span>
      </div>
    </div>
    <div class="kpi-card kpi-card-cyan">
      <div class="kpi-icon kpi-icon-cyan">
        <i class="uil uil-calendar-alt"></i>
      </div>
      <div class="kpi-info">
        <span class="kpi-label">Timeline</span>
        <span class="kpi-value kpi-timeline-value">
          <span><%= project.start_date ? new Date(project.start_date).toLocaleDateString() : 'N/A' %></span>
          <i class="uil uil-arrow-right text-muted"></i>
          <span><%= project.end_date ? new Date(project.end_date).toLocaleDateString() : 'Ongoing' %></span>
        </span>
      </div>
    </div>
  </div>

  <% if (project.description) { %>
    <div class="card mt-6">
      <div class="card-body">
        <h3 class="stat-panel-label mb-2">Project Overview</h3>
        <p class="project-overview-text"><%= project.description %></p>
      </div>
    </div>
  <% } %>


  <!-- Tasks Section -->
  <%
    const completedTasksCount = tasks ? tasks.filter(function(t) { return t.status === 'COMPLETED'; }).length : 0;
    const totalTasksCount = tasks ? tasks.length : 0;
    const taskCompletionPct = totalTasksCount > 0 ? Math.round((completedTasksCount / totalTasksCount) * 100) : 0;
    const allowTaskEdits = (typeof canModifyTasks !== 'undefined') ? canModifyTasks : true;
    const canManageProject = (typeof hasModuleAccess === 'function') ? hasModuleAccess('projects', 'manage') : true;
  %>
  <div class="project-layout-grid mt-6">
    <div class="card">
      <div class="card-header">
        <div>
          <h2 class="card-title">Tasks & Deliverables</h2>
          <span class="text-xs text-muted"><%= completedTasksCount %> of <%= totalTasksCount %> completed (<%= taskCompletionPct %>%)</span>
        </div>
        <div class="project-progress-bar-wrap">
          <div class="project-progress-track" title="<%= taskCompletionPct %>% completed">
            <div class="project-progress-fill" style="width: <%= taskCompletionPct %>%;"></div>
          </div>
          <span class="badge badge-subtle"><%= totalTasksCount %> Total</span>
        </div>
      </div>
      <div class="card-body-table">
        <% if (tasks && tasks.length > 0) { %>
          <div class="table-scroll-hint">
            <i class="uil uil-arrows-h"></i>
            <span>Swipe to view all</span>
          </div>
          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th style="width: 42px;">Done</th>
                  <th>Task</th>
                  <th>Assignee</th>
                  <th>Priority</th>
                  <th>Status</th>
                  <th class="text-right">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% tasks.forEach(function(t) { %>
                  <%
                    const isCompleted = t.status === 'COMPLETED';
                    const dueDateStr = t.due_date ? new Date(t.due_date).toISOString().split('T')[0] : '';
                    const todayStr = new Date().toISOString().split('T')[0];
                    const isOverdue = !isCompleted && Boolean(dueDateStr) && dueDateStr < todayStr;
                  %>
                  <tr class="<%= isCompleted ? 'task-row-completed' : '' %>">
                    <td>
                      <% if (allowTaskEdits) { %>
                        <form action="/projects/<%= project.id %>/tasks/<%= t.id %>/status" method="POST" style="display: inline-block; margin: 0;">
                          <input type="hidden" name="status" value="<%= isCompleted ? 'TODO' : 'COMPLETED' %>">
                          <button
                            type="submit"
                            class="task-complete-toggle <%= isCompleted ? 'is-completed' : '' %>"
                            title="<%= isCompleted ? 'Reopen task' : 'Mark task as complete' %>"
                            aria-label="<%= isCompleted ? 'Reopen task ' + t.title : 'Mark task ' + t.title + ' as complete' %>">
                            <i class="uil uil-check"></i>
                          </button>
                        </form>
                      <% } else { %>
                        <span class="badge <%= isCompleted ? 'badge-success' : 'badge-subtle' %>">
                          <i class="uil <%= isCompleted ? 'uil-check' : 'uil-clock' %>"></i>
                        </span>
                      <% } %>
                    </td>
                    <td>
                      <strong class="<%= isCompleted ? 'task-title-completed' : '' %>"><%= t.title %></strong>
                      <% if (t.description) { %>
                        <br><small class="text-tertiary"><%= t.description %></small>
                      <% } %>
                      <% if (t.due_date || t.estimated_hours != null || t.actual_hours != null) { %>
                        <div class="task-meta-pills">
                          <% if (t.due_date) { %>
                            <span class="task-meta-pill <%= isOverdue ? 'is-overdue' : '' %>">
                              <i class="uil uil-calendar-alt"></i>
                              <span>Due <%= new Date(t.due_date).toLocaleDateString() %><%= isOverdue ? ' (Overdue)' : '' %></span>
                            </span>
                          <% } %>
                          <% if (t.estimated_hours != null) { %>
                            <span class="task-meta-pill">
                              <i class="uil uil-clock"></i>
                              <span>Est: <%= parseFloat(t.estimated_hours) %>h</span>
                            </span>
                          <% } %>
                          <% if (t.actual_hours != null) { %>
                            <span class="task-meta-pill">
                              <i class="uil uil-history"></i>
                              <span>Actual: <%= parseFloat(t.actual_hours) %>h</span>
                            </span>
                          <% } %>
                        </div>
                      <% } %>
                    </td>
                    <td><%= t.first_name ? t.first_name + ' ' + t.last_name : 'Unassigned' %></td>
                    <td>
                      <% if (t.priority === 'URGENT') { %>
                        <span class="badge badge-danger">Urgent</span>
                      <% } else if (t.priority === 'HIGH') { %>
                        <span class="badge badge-warning">High</span>
                      <% } else if (t.priority === 'MEDIUM') { %>
                        <span class="badge badge-info">Medium</span>
                      <% } else { %>
                        <span class="badge badge-subtle">Low</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (allowTaskEdits) { %>
                        <form action="/projects/<%= project.id %>/tasks/<%= t.id %>/status" method="POST" class="task-status-form">
                          <select name="status" class="form-select task-status-select" aria-label="Status for <%= t.title %>">
                            <option value="TODO" <%= t.status === 'TODO' ? 'selected' : '' %>>To Do</option>
                            <option value="IN_PROGRESS" <%= t.status === 'IN_PROGRESS' ? 'selected' : '' %>>In Progress</option>
                            <option value="IN_REVIEW" <%= t.status === 'IN_REVIEW' ? 'selected' : '' %>>In Review</option>
                            <option value="COMPLETED" <%= t.status === 'COMPLETED' ? 'selected' : '' %>>Completed</option>
                            <option value="BLOCKED" <%= t.status === 'BLOCKED' ? 'selected' : '' %>>Blocked</option>
                          </select>
                        </form>
                      <% } else { %>
                        <% if (t.status === 'COMPLETED') { %>
                          <span class="badge badge-success"><span class="badge-dot"></span>Completed</span>
                        <% } else if (t.status === 'IN_PROGRESS') { %>
                          <span class="badge badge-info"><span class="badge-dot"></span>In Progress</span>
                        <% } else if (t.status === 'IN_REVIEW') { %>
                          <span class="badge badge-violet"><span class="badge-dot"></span>In Review</span>
                        <% } else if (t.status === 'BLOCKED') { %>
                          <span class="badge badge-danger"><span class="badge-dot"></span>Blocked</span>
                        <% } else { %>
                          <span class="badge badge-secondary">To Do</span>
                        <% } %>
                      <% } %>
                    </td>
                    <td class="text-right">
                      <div class="btn-group-sm">
                        <% if (allowTaskEdits) { %>
                          <button
                            type="button"
                            class="btn btn-xs btn-outline-primary btn-edit-task"
                            title="Edit Task"
                            data-edit-action="/projects/<%= project.id %>/tasks/<%= t.id %>/edit"
                            data-task-id="<%= t.id %>"
                            data-task-title="<%= t.title %>"
                            data-task-description="<%= t.description || '' %>"
                            data-task-assigned-to-id="<%= t.assigned_to_id || '' %>"
                            data-task-priority="<%= t.priority %>"
                            data-task-status="<%= t.status %>"
                            data-task-due-date="<%= dueDateStr %>"
                            data-task-estimated-hours="<%= t.estimated_hours != null ? t.estimated_hours : '' %>"
                            data-task-actual-hours="<%= t.actual_hours != null ? t.actual_hours : '' %>">
                            <i class="uil uil-edit"></i>
                          </button>
                        <% } %>
                        <% if (canManageProject) { %>
                          <form action="/projects/<%= project.id %>/tasks/<%= t.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this task? An audit log will be retained.');">
                            <button type="submit" class="btn btn-xs btn-outline-danger" title="Delete Task" style="padding: 4px 8px; font-size: 0.8rem; border-radius: 4px;">
                              <i class="uil uil-trash-alt"></i>
                            </button>
                          </form>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">
            <div class="empty-state-icon"><i class="uil uil-clipboard-notes"></i></div>
            <p class="empty-state-title">No tasks yet</p>
            <p class="empty-state-message">Add deliverables and milestones using the form on the right.</p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Quick Add Task Form -->
    <% if (allowTaskEdits) { %>
      <div class="card">
        <div class="card-header">
          <h2 class="card-title">Add New Task</h2>
        </div>
        <div class="card-body">
          <form action="/projects/<%= project.id %>/tasks" method="POST" class="form-stack">
            <div class="form-group">
              <label class="form-label" for="taskTitle">Task Title *</label>
              <input type="text" class="form-input" id="taskTitle" name="title" required placeholder="e.g. Conduct cabling tests">
            </div>

            <div class="form-group">
              <label class="form-label" for="assignedToId">Assign To</label>
              <select class="form-select" id="assignedToId" name="assignedToId">
                <option value="">-- Unassigned --</option>
                <% if (teamUsers && teamUsers.length > 0) { %>
                  <% teamUsers.forEach(function(u) { %>
                    <option value="<%= u.id %>"><%= u.first_name %> <%= u.last_name %> (<%= u.role %>)</option>
                  <% }); %>
                <% } %>
              </select>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="priority">Priority</label>
                <select class="form-select" id="priority" name="priority">
                  <option value="LOW">Low</option>
                  <option value="MEDIUM" selected>Medium</option>
                  <option value="HIGH">High</option>
                  <option value="URGENT">Urgent</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label" for="estimatedHours">Est. Hours</label>
                <input type="number" step="0.25" min="0" class="form-input" id="estimatedHours" name="estimatedHours" placeholder="e.g. 4">
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="dueDate">Due Date</label>
              <input type="date" class="form-input" id="dueDate" name="dueDate" placeholder="e.g. 2026-10-15">
            </div>

            <div class="form-group">
              <label class="form-label" for="taskDesc">Details / Notes</label>
              <textarea class="form-input" id="taskDesc" name="description" rows="3" placeholder="Brief technical or delivery notes..."></textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-block">
              <i class="uil uil-plus"></i>
              <span>Add Task</span>
            </button>
          </form>
        </div>
      </div>
    <% } %>
  </div>

  <!-- Project Documents Section -->
  <div class="project-layout-grid mt-6">
    <div class="card">
      <div class="card-header flex-between">
        <div>
          <h2 class="card-title">Project Documents & Files</h2>
          <span class="text-xs text-muted">Stored securely in cloud storage &bull; <%= (typeof documents !== 'undefined' && documents) ? documents.length : 0 %> files</span>
        </div>
        <span class="badge badge-subtle">
          <i class="uil uil-cloud"></i> Cloud Storage
        </span>
      </div>
      <div class="card-body-table">
        <% if (typeof documents !== 'undefined' && documents && documents.length > 0) { %>
          <div class="table-scroll-hint">
            <i class="uil uil-arrows-h"></i>
            <span>Swipe to view all</span>
          </div>
          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>Document Name</th>
                  <th>Uploaded By</th>
                  <th>Size</th>
                  <th>Date</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% documents.forEach(function(doc) { %>
                  <%
                    const bytes = doc.file_size || 0;
                    const sizeStr = bytes > 1048576 
                      ? (bytes / (1024 * 1024)).toFixed(1) + ' MB' 
                      : (bytes > 1024 ? (bytes / 1024).toFixed(0) + ' KB' : bytes + ' B');
                    const uploaderName = doc.first_name ? (doc.first_name + ' ' + (doc.last_name || '')).trim() : 'System';
                    const docDateStr = new Date(doc.created_at).toLocaleDateString();
                    const ft = (doc.file_type || '').toLowerCase();
                    const fnLower = (doc.name || doc.file_url || '').toLowerCase();
                    let docIcon = 'uil-file-alt';
                    if (ft.includes('pdf') || fnLower.endsWith('.pdf')) docIcon = 'uil-file-bookmark-alt';
                    else if (ft.startsWith('image/') || /\.(png|jpe?g|webp|gif|svg)$/i.test(fnLower)) docIcon = 'uil-image';
                    else if (ft.includes('spreadsheet') || ft.includes('excel') || ft.includes('csv') || /\.(xlsx?|csv)$/i.test(fnLower)) docIcon = 'uil-table';
                    else if (ft.includes('word') || /\.(docx?)$/i.test(fnLower)) docIcon = 'uil-file-edit-alt';
                    else if (ft.includes('zip') || fnLower.endsWith('.zip')) docIcon = 'uil-archive';
                  %>
                  <tr>
                    <td>
                      <div class="flex-align-center gap-2">
                        <i class="uil <%= docIcon %> text-primary" style="font-size: 1.25rem;"></i>
                        <div>
                          <button type="button" class="doc-preview-name-trigger" data-doc-id="<%= doc.id %>" title="Preview <%= doc.name %>">
                            <strong><%= doc.name %></strong>
                          </button>
                          <% if (doc.file_type) { %>
                            <br><small class="text-tertiary"><%= doc.file_type %></small>
                          <% } %>
                        </div>
                      </div>
                    </td>
                    <td><%= uploaderName %></td>
                    <td>
                      <span class="badge badge-subtle"><%= sizeStr %></span>
                    </td>
                    <td><%= docDateStr %></td>
                    <td>
                      <div class="table-actions">
                        <button
                          type="button"
                          class="btn btn-sm btn-primary btn-preview-doc"
                          title="Preview Document"
                          data-doc-id="<%= doc.id %>"
                          data-doc-name="<%= doc.name %>"
                          data-doc-type="<%= doc.file_type || '' %>"
                          data-doc-size="<%= sizeStr %>"
                          data-doc-date="<%= docDateStr %>"
                          data-doc-uploader="<%= uploaderName %>"
                          data-preview-url="/projects/<%= project.id %>/documents/<%= doc.id %>/preview"
                          data-preview-data-url="/projects/<%= project.id %>/documents/<%= doc.id %>/preview-data"
                          data-download-url="/projects/<%= project.id %>/documents/<%= doc.id %>/download">
                          <i class="uil uil-eye"></i>
                          <span>Preview</span>
                        </button>
                        <a href="/projects/<%= project.id %>/documents/<%= doc.id %>/download" class="btn btn-sm btn-secondary" title="Download Document">
                          <i class="uil uil-download-alt"></i>
                          <span>Download</span>
                        </a>
                        <% if (canManageProject) { %>
                          <form action="/projects/<%= project.id %>/documents/<%= doc.id %>/delete" method="POST" class="inline-block" onsubmit="return confirm('Are you sure you want to delete this document?');">
                            <button type="submit" class="btn btn-sm btn-danger" title="Delete file">
                              <i class="uil uil-trash-alt"></i>
                            </button>
                          </form>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state p-6">
            <div class="empty-state-icon"><i class="uil uil-cloud-upload"></i></div>
            <p class="empty-state-title">No documents uploaded yet</p>
            <p class="empty-state-message">Attach contracts, architectural blueprints, technical specs, and project deliverables.</p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Upload Document Form -->
    <% if (allowTaskEdits) { %>
      <div class="card">
        <div class="card-header">
          <h2 class="card-title">Upload Project Document</h2>
        </div>
        <div class="card-body">
          <form action="/projects/<%= project.id %>/documents" method="POST" enctype="multipart/form-data" class="form-stack">
            <div class="form-group">
              <label class="form-label" for="documentName">Document Title (Optional)</label>
              <input type="text" class="form-input" id="documentName" name="documentName" placeholder="e.g. Architectural Blueprint Rev 2">
              <small class="text-tertiary">Leave blank to use original filename</small>
            </div>

            <div class="form-group">
              <label class="form-label" for="projectDocFile">Select File *</label>
              <input type="file" class="form-input" id="projectDocFile" name="document" required accept=".pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.zip,.png,.jpg,.jpeg,.webp,.svg">
              <small class="text-tertiary">Max file size: 15 MB (PDF, Word, Excel, CSV, Images, CAD/Zip)</small>
            </div>

            <div class="bg-tertiary p-3 rounded mb-3 flex-align-center gap-2">
              <i class="uil uil-shield-check text-success" style="font-size: 1.25rem;"></i>
              <span class="text-xs text-secondary">Uploaded files are stored securely with high durability.</span>
            </div>

            <button type="submit" class="btn btn-primary btn-block">
              <i class="uil uil-cloud-upload"></i>
              <span>Upload Document</span>
            </button>
          </form>
        </div>
      </div>
    <% } %>
  </div>

  <!-- Assigned Team Members Section -->
  <div class="project-layout-grid mt-6">
    <div class="card">
      <div class="card-header flex-between">
        <div>
          <h2 class="card-title">Assigned Project Team</h2>
          <span class="text-xs text-muted"><%= (typeof teamMembers !== 'undefined' && teamMembers) ? teamMembers.length : 0 %> Members assigned to this project</span>
        </div>
        <span class="badge badge-subtle">
          <i class="uil uil-users-alt"></i> Workforce
        </span>
      </div>
      <div class="card-body-table">
        <% if (typeof teamMembers !== 'undefined' && teamMembers && teamMembers.length > 0) { %>
          <div class="table-scroll-hint">
            <i class="uil uil-arrows-h"></i>
            <span>Swipe to view all</span>
          </div>
          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>Team Member</th>
                  <th>Email</th>
                  <th>Project Role</th>
                  <th>Contact</th>
                  <% if (typeof hasModuleAccess === 'function' && hasModuleAccess('projects', 'manage')) { %>
                    <th class="text-right">Actions</th>
                  <% } %>
                </tr>
              </thead>
              <tbody>
                <% teamMembers.forEach(function(member) { %>
                  <tr>
                    <td>
                      <div class="flex-align-center gap-2">
                        <div class="avatar-circle">
                          <%= (member.first_name ? member.first_name.charAt(0) : '') + (member.last_name ? member.last_name.charAt(0) : '') %>
                        </div>
                        <div>
                          <strong><%= member.first_name %> <%= member.last_name %></strong>
                          <div class="text-xs text-muted"><%= member.role ? member.role.replace(/_/g, ' ') : 'Member' %></div>
                        </div>
                      </div>
                    </td>
                    <td><%= member.email %></td>
                    <td>
                      <span class="badge badge-info"><%= member.project_role || 'Contributor' %></span>
                      <% if (member.source === 'task') { %>
                        <span class="badge badge-subtle text-xs" title="Assigned via active project task">Task Lead</span>
                      <% } %>
                    </td>
                    <td><%= member.phone || '—' %></td>
                    <% if (typeof hasModuleAccess === 'function' && hasModuleAccess('projects', 'manage')) { %>
                      <td class="text-right">
                        <% if (member.source === 'member') { %>
                          <form action="/projects/<%= project.id %>/members/<%= member.user_id %>/delete" method="POST" class="inline-block" onsubmit="return confirm('Remove <%= member.first_name %> from this project?');">
                            <button type="submit" class="btn btn-xs btn-outline-danger" title="Remove from project">
                              <i class="uil uil-user-minus"></i>
                              <span>Remove</span>
                            </button>
                          </form>
                        <% } else { %>
                          <span class="text-xs text-muted">Via Task</span>
                        <% } %>
                      </td>
                    <% } %>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state p-6">
            <div class="empty-state-icon"><i class="uil uil-user-times"></i></div>
            <p class="empty-state-title">No team members assigned</p>
            <p class="empty-state-message">Add team members or assign them tasks to grant them access to this project.</p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Assign Member Form (if user can manage projects) -->
    <% if (typeof hasModuleAccess === 'function' && hasModuleAccess('projects', 'manage')) { %>
      <div class="card">
        <div class="card-header">
          <h2 class="card-title">Assign Team Member</h2>
        </div>
        <div class="card-body">
          <form action="/projects/<%= project.id %>/members" method="POST" class="form-stack">
            <div class="form-group">
              <label class="form-label" for="memberUserId">Select User *</label>
              <select class="form-select" id="memberUserId" name="userId" required>
                <option value="">-- Choose Member --</option>
                <% 
                  const usersToDisplay = (typeof availableUsers !== 'undefined' && availableUsers && availableUsers.length > 0)
                    ? availableUsers
                    : ((typeof teamUsers !== 'undefined' && teamUsers) ? teamUsers : []);
                %>
                <% if (usersToDisplay && usersToDisplay.length > 0) { %>
                  <% usersToDisplay.forEach(function(u) { %>
                    <option value="<%= u.id %>"><%= u.first_name %> <%= u.last_name %> (<%= u.role ? u.role.replace(/_/g, ' ') : '' %>)</option>
                  <% }); %>
                <% } else { %>
                  <option value="" disabled>No team members available</option>
                <% } %>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="projectRole">Project Role / Designation</label>
              <input type="text" class="form-input" id="projectRole" name="roleInProject" list="project-roles-list" placeholder="e.g. Team Leader, Lead Engineer, Contributor">
              <datalist id="project-roles-list">
                <option value="Team Leader">
                <option value="Project Lead">
                <option value="Lead Engineer">
                <option value="Senior Developer">
                <option value="Site Supervisor">
                <option value="Quality Assurance">
                <option value="Contributor">
              </datalist>
              <div class="flex gap-1 mt-2 flex-wrap">
                <button type="button" class="btn btn-xs btn-subtle" onclick="document.getElementById('projectRole').value='Team Leader';">Team Leader</button>
                <button type="button" class="btn btn-xs btn-subtle" onclick="document.getElementById('projectRole').value='Lead Engineer';">Lead Engineer</button>
                <button type="button" class="btn btn-xs btn-subtle" onclick="document.getElementById('projectRole').value='Contributor';">Contributor</button>
              </div>
            </div>

            <div class="bg-tertiary p-3 rounded mb-3 flex-align-center gap-2">
              <i class="uil uil-info-circle text-primary" style="font-size: 1.25rem;"></i>
              <span class="text-xs text-secondary">Assigning a user grants them full visibility into this project, its tasks, quotations, and invoices.</span>
            </div>

            <button type="submit" class="btn btn-primary btn-block">
              <i class="uil uil-user-plus"></i>
              <span>Assign to Project</span>
            </button>
          </form>
        </div>
      </div>
    <% } %>
  </div>

  <!-- Associated Financial Items (Invoices & Quotations) -->
  <%
    const canSeeInvoices = (typeof hasModuleAccess === 'function') ? hasModuleAccess('invoices') : true;
    const canSeeQuotations = (typeof hasModuleAccess === 'function') ? hasModuleAccess('quotations') : true;
  %>
  <% if (canSeeInvoices || canSeeQuotations) { %>
    <div class="project-layout-grid mt-6">
      <!-- Associated Invoices -->
      <% if (canSeeInvoices) { %>
        <div class="card">
          <div class="card-header flex-between">
            <div>
              <h2 class="card-title">Associated Invoices</h2>
              <span class="text-xs text-muted"><%= (typeof invoices !== 'undefined' && invoices) ? invoices.length : 0 %> billing records</span>
            </div>
            <% if (typeof hasModuleAccess === 'function' && hasModuleAccess('invoices', 'manage')) { %>
              <a href="/invoices/new?projectId=<%= project.id %>" class="btn btn-xs btn-primary">
                <i class="uil uil-plus"></i> New Invoice
              </a>
            <% } %>
          </div>
          <div class="card-body-table">
            <% if (typeof invoices !== 'undefined' && invoices && invoices.length > 0) { %>
              <div class="table-responsive">
                <table class="table">
                  <thead>
                    <tr>
                      <th>Invoice #</th>
                      <th>Amount</th>
                      <th>Status</th>
                      <th class="text-right">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% invoices.forEach(function(inv) { %>
                      <tr>
                        <td>
                          <strong><a href="/invoices/<%= inv.id %>"><%= inv.invoice_number %></a></strong>
                          <div class="text-xs text-muted"><%= new Date(inv.issue_date).toLocaleDateString() %></div>
                        </td>
                        <td><%= formatKES(parseFloat(inv.total_amount || 0)) %></td>
                        <td>
                          <% if (inv.status === 'PAID') { %>
                            <span class="badge badge-success">Paid</span>
                          <% } else if (inv.status === 'OVERDUE') { %>
                            <span class="badge badge-danger">Overdue</span>
                          <% } else { %>
                            <span class="badge badge-info"><%= inv.status %></span>
                          <% } %>
                        </td>
                        <td class="text-right">
                          <a href="/invoices/<%= inv.id %>" class="btn btn-xs btn-secondary" title="View Invoice">
                            <i class="uil uil-eye"></i>
                          </a>
                          <a href="/invoices/<%= inv.id %>/pdf" class="btn btn-xs btn-outline-secondary" title="Download PDF">
                            <i class="uil uil-download-alt"></i>
                          </a>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="empty-state p-4">
                <p class="empty-state-title text-sm">No invoices linked</p>
                <p class="empty-state-message text-xs">No invoices have been billed against this project yet.</p>
              </div>
            <% } %>
          </div>
        </div>
      <% } %>

      <!-- Associated Quotations -->
      <% if (canSeeQuotations) { %>
        <div class="card">
          <div class="card-header flex-between">
            <div>
              <h2 class="card-title">Associated Quotations</h2>
              <span class="text-xs text-muted"><%= (typeof quotations !== 'undefined' && quotations) ? quotations.length : 0 %> estimates & quotes</span>
            </div>
            <% if (typeof hasModuleAccess === 'function' && hasModuleAccess('quotations', 'manage')) { %>
              <a href="/quotations/new?projectId=<%= project.id %>" class="btn btn-xs btn-primary">
                <i class="uil uil-plus"></i> New Quote
              </a>
            <% } %>
          </div>
          <div class="card-body-table">
            <% if (typeof quotations !== 'undefined' && quotations && quotations.length > 0) { %>
              <div class="table-responsive">
                <table class="table">
                  <thead>
                    <tr>
                      <th>Quote #</th>
                      <th>Amount</th>
                      <th>Status</th>
                      <th class="text-right">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% quotations.forEach(function(q) { %>
                      <tr>
                        <td>
                          <strong><a href="/quotations/<%= q.id %>"><%= q.quotation_number %></a></strong>
                          <div class="text-xs text-muted"><%= new Date(q.created_at).toLocaleDateString() %></div>
                        </td>
                        <td><%= formatKES(parseFloat(q.total_amount || 0)) %></td>
                        <td>
                          <% if (q.status === 'ACCEPTED') { %>
                            <span class="badge badge-success">Accepted</span>
                          <% } else if (q.status === 'CONVERTED') { %>
                            <span class="badge badge-primary">Invoiced</span>
                          <% } else { %>
                            <span class="badge badge-info"><%= q.status %></span>
                          <% } %>
                        </td>
                        <td class="text-right">
                          <a href="/quotations/<%= q.id %>" class="btn btn-xs btn-secondary" title="View Quote">
                            <i class="uil uil-eye"></i>
                          </a>
                          <a href="/quotations/<%= q.id %>/pdf" class="btn btn-xs btn-outline-secondary" title="Download PDF">
                            <i class="uil uil-download-alt"></i>
                          </a>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="empty-state p-4">
                <p class="empty-state-title text-sm">No quotations linked</p>
                <p class="empty-state-message text-xs">No estimates or quotations have been created for this project.</p>
              </div>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>
  <% } %>
</div>

<!-- ═══════════════════════════════════════════════════════════════════
     Edit Task Modal
     ═══════════════════════════════════════════════════════════════════ -->
<div class="modal-overlay" id="modalEditTask" role="dialog" aria-modal="true" aria-labelledby="editTaskModalTitle">
  <div class="modal">
    <div class="modal-header">
      <div>
        <h3 class="modal-title" id="editTaskModalTitle">Edit Task</h3>
        <p class="text-xs text-muted m-0" id="editTaskModalSubtitle">Update task details, assignee, schedule, and completion status</p>
      </div>
      <button type="button" class="modal-close" data-close-modal="modalEditTask" aria-label="Close modal">
        <i class="uil uil-times" style="font-size: 1.25rem;"></i>
      </button>
    </div>
    <form id="editTaskForm" method="POST" action="">
      <!-- TODO(security): Add CSRF synchronizer token when CSRF middleware is enabled globally -->
      <div class="modal-body form-stack">
        <div class="form-group">
          <label class="form-label" for="editTaskTitle">Task Title *</label>
          <input type="text" class="form-input" id="editTaskTitle" name="title" required maxlength="255">
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="editTaskStatus">Status</label>
            <select class="form-select" id="editTaskStatus" name="status">
              <option value="TODO">To Do</option>
              <option value="IN_PROGRESS">In Progress</option>
              <option value="IN_REVIEW">In Review</option>
              <option value="COMPLETED">Completed</option>
              <option value="BLOCKED">Blocked</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="editTaskPriority">Priority</label>
            <select class="form-select" id="editTaskPriority" name="priority">
              <option value="LOW">Low</option>
              <option value="MEDIUM">Medium</option>
              <option value="HIGH">High</option>
              <option value="URGENT">Urgent</option>
            </select>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="editTaskAssignedToId">Assign To</label>
            <select class="form-select" id="editTaskAssignedToId" name="assignedToId">
              <option value="">-- Unassigned --</option>
              <% if (teamUsers && teamUsers.length > 0) { %>
                <% teamUsers.forEach(function(u) { %>
                  <option value="<%= u.id %>"><%= u.first_name %> <%= u.last_name %> (<%= u.role %>)</option>
                <% }); %>
              <% } %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="editTaskDueDate">Due Date</label>
            <input type="date" class="form-input" id="editTaskDueDate" name="dueDate" placeholder="Select due date">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="editTaskEstimatedHours">Estimated Hours</label>
            <input type="number" step="0.25" min="0" class="form-input" id="editTaskEstimatedHours" name="estimatedHours" placeholder="0">
          </div>
          <div class="form-group">
            <label class="form-label" for="editTaskActualHours">Actual Hours</label>
            <input type="number" step="0.25" min="0" class="form-input" id="editTaskActualHours" name="actualHours" placeholder="0">
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="editTaskDescription">Details / Notes</label>
          <textarea class="form-input" id="editTaskDescription" name="description" rows="3" placeholder="Brief technical or delivery notes..."></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-close-modal="modalEditTask">Cancel</button>
        <button type="submit" class="btn btn-primary">
          <i class="uil uil-check"></i>
          <span>Save Task</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════
     In-App Project File Preview Modal
     ═══════════════════════════════════════════════════════════════════ -->
<div class="modal-overlay" id="modalPreviewDocument" role="dialog" aria-modal="true" aria-labelledby="docPreviewTitle">
  <div class="modal doc-preview-modal">
    <div class="doc-preview-header">
      <div class="doc-preview-title-block">
        <h3 class="doc-preview-title" id="docPreviewTitle">Document Preview</h3>
        <div class="doc-preview-meta" id="docPreviewMeta"></div>
      </div>
      <div class="doc-preview-toolbar">
        <button type="button" class="btn btn-sm btn-secondary hidden" id="docPreviewPrevBtn" title="Previous file">
          <i class="uil uil-angle-left"></i>
        </button>
        <span class="doc-preview-counter hidden" id="docPreviewCounter"></span>
        <button type="button" class="btn btn-sm btn-secondary hidden" id="docPreviewNextBtn" title="Next file">
          <i class="uil uil-angle-right"></i>
        </button>

        <div class="doc-preview-zoom-group hidden" id="docPreviewZoomControls">
          <button type="button" class="btn btn-xs btn-ghost" id="docPreviewZoomOut" title="Zoom out">
            <i class="uil uil-search-minus"></i>
          </button>
          <span class="doc-preview-zoom-val" id="docPreviewZoomValue">100%</span>
          <button type="button" class="btn btn-xs btn-ghost" id="docPreviewZoomIn" title="Zoom in">
            <i class="uil uil-search-plus"></i>
          </button>
          <button type="button" class="btn btn-xs btn-ghost" id="docPreviewZoomReset" title="Reset zoom">Fit</button>
        </div>

        <button type="button" class="btn btn-sm btn-secondary hidden" id="docPreviewCopyBtn" title="Copy extracted text">
          <i class="uil uil-copy"></i>
          <span>Copy</span>
        </button>
        <a href="#" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-secondary hidden" id="docPreviewOpenTabBtn" title="Open in new tab">
          <i class="uil uil-external-link-alt"></i>
          <span>Open in Tab</span>
        </a>
        <a href="#" class="btn btn-sm btn-primary" id="docPreviewDownloadBtn" title="Download file">
          <i class="uil uil-download-alt"></i>
          <span>Download</span>
        </a>
        <button type="button" class="modal-close" data-close-modal="modalPreviewDocument" aria-label="Close preview">
          <i class="uil uil-times" style="font-size: 1.35rem;"></i>
        </button>
      </div>
    </div>
    <div class="doc-preview-body" id="docPreviewBody"></div>
  </div>
</div>

<script src="/js/project-detail.js?v=1.0"></script>
