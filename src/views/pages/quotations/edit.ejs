<!-- ═══════════════════════════════════════════════════════════════════
     Edit Quotation Form View
     Supports multi-row items & synchronization with progressed invoice
     ═══════════════════════════════════════════════════════════════════ -->

<div class="quotations-edit-page">
  <div class="page-header">
    <div class="page-title-group">
      <a href="/quotations/<%= quotation.id %>" class="btn btn-sm btn-secondary mb-2">
        <i class="uil uil-arrow-left"></i>
        <span>Back to Quotation</span>
      </a>

      <h1 class="page-title">Edit Quotation <%= quotation.quotation_number %></h1>
      <p class="page-subtitle">Update estimate details, scope items, pricing, and client terms.</p>
    </div>
    <div class="page-actions">
      <a href="/quotations/<%= quotation.id %>" class="btn btn-secondary">
        <i class="uil uil-times"></i>
        <span>Cancel</span>
      </a>
    </div>
  </div>

  <% if (typeof linkedInvoice !== 'undefined' && linkedInvoice) { %>
    <div class="alert alert-info mb-4" style="background: rgba(37, 99, 235, 0.08); border: 1px solid rgba(37, 99, 235, 0.25); border-left: 4px solid var(--primary); padding: 14px 18px; border-radius: 8px;">
      <div class="flex-align-center gap-3">
        <i class="uil uil-sync text-primary" style="font-size: 1.4rem;"></i>
        <div>
          <strong style="color: var(--primary);">Synchronized with Invoice <%= linkedInvoice.invoice_number %></strong>
          <div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 2px;">
            This quotation has progressed to an active invoice. Any changes saved to line items, totals, or terms will automatically update <strong>Invoice <%= linkedInvoice.invoice_number %></strong>.
          </div>
        </div>
      </div>
    </div>
  <% } %>

  <div class="card max-w-wide">
    <div class="card-body">
      <form action="/quotations/<%= quotation.id %>/edit" method="POST" class="form-stack">
        <div class="form-row-3">
          <div class="form-group">
            <label class="form-label" for="quotationNumber">Quotation Number</label>
            <input type="text" class="form-input" id="quotationNumber" value="<%= quotation.quotation_number %>" readonly disabled style="background: var(--bg-tertiary);">
          </div>
          <div class="form-group">
            <label class="form-label" for="clientId">Client *</label>
            <select class="form-select" id="clientId" name="clientId" required>
              <option value="">-- Select Client --</option>
              <% if (clients && clients.length > 0) { %>
                <% clients.forEach(function(c) { %>
                  <option value="<%= c.id %>" <%= quotation.client_id === c.id ? 'selected' : '' %>>
                    <%= c.name %> (<%= c.kra_pin || 'No PIN' %>)
                  </option>
                <% }); %>
              <% } %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="projectId">Associated Project</label>
            <select class="form-select" id="projectId" name="projectId">
              <option value="">-- None / General --</option>
              <% if (projects && projects.length > 0) { %>
                <% projects.forEach(function(p) { %>
                  <option value="<%= p.id %>" <%= quotation.project_id === p.id ? 'selected' : '' %>>
                    <%= p.code %> - <%= p.name %>
                  </option>
                <% }); %>
              <% } %>
            </select>
          </div>
        </div>

        <div class="form-row-2-1">
          <div class="form-group">
            <label class="form-label" for="title">Quotation Title/Subject *</label>
            <input type="text" class="form-input" id="title" name="title" value="<%= quotation.title || '' %>" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="validUntil">Valid Until Date *</label>
            <% const validUntilFormatted = quotation.valid_until ? new Date(quotation.valid_until).toISOString().split('T')[0] : ''; %>
            <input type="date" class="form-input" id="validUntil" name="validUntil" value="<%= validUntilFormatted %>" required>
          </div>
        </div>

        <div class="mt-4 mb-2 flex items-center justify-between">
          <h3 class="font-semibold text-primary">Quotation Line Items</h3>
          <button type="button" class="btn btn-sm btn-secondary" id="btn-add-line-item">
            <i class="uil uil-plus"></i>
            <span>Add Item</span>
          </button>
        </div>

        <div id="line-items-container" class="line-item-builder">
          <% if (items && items.length > 0) { %>
            <% items.forEach(function(item, idx) { %>
              <div class="line-item-row">
                <div class="line-item-grid">
                  <div class="form-group">
                    <label class="form-label">Item / Description *</label>
                    <input type="text" class="form-input" name="itemDescriptions" required placeholder="Service or equipment description" value="<%= item.description %>">
                  </div>
                  <div class="form-group">
                    <label class="form-label">Quantity *</label>
                    <input type="number" step="any" min="1" class="form-input" name="itemQuantities" value="<%= item.quantity %>" required>
                  </div>
                  <div class="form-group">
                    <label class="form-label">Unit Price (KES) *</label>
                    <input type="number" step="any" min="0" class="form-input" name="itemUnitPrices" required placeholder="0.00" value="<%= item.unit_price %>">
                  </div>
                  <div class="line-item-remove-wrapper">
                    <button type="button" class="btn btn-sm btn-ghost btn-remove-item" aria-label="Remove item" title="Remove item">
                      <i class="uil uil-trash-alt"></i>
                    </button>
                  </div>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <div class="line-item-row">
              <div class="line-item-grid">
                <div class="form-group">
                  <label class="form-label">Item / Description *</label>
                  <input type="text" class="form-input" name="itemDescriptions" required placeholder="Service or equipment description">
                </div>
                <div class="form-group">
                  <label class="form-label">Quantity *</label>
                  <input type="number" step="1" min="1" class="form-input" name="itemQuantities" value="1" required>
                </div>
                <div class="form-group">
                  <label class="form-label">Unit Price (KES) *</label>
                  <input type="number" step="any" min="0" class="form-input" name="itemUnitPrices" required placeholder="0.00">
                </div>
                <div class="line-item-remove-wrapper">
                  <button type="button" class="btn btn-sm btn-ghost btn-remove-item" aria-label="Remove item" title="Remove item">
                    <i class="uil uil-trash-alt"></i>
                  </button>
                </div>
              </div>
            </div>
          <% } %>
        </div>

        <!-- VAT Option Box -->
        <% const hasVat = parseFloat(quotation.tax_amount || 0) > 0; %>
        <div class="card p-4 mb-4 bg-surface-subtle vat-option-card" style="border: 1px solid var(--border-color); border-radius: 8px; background: rgba(79, 70, 229, 0.04); margin-top: 14px;">
          <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px;">
            <div style="display: flex; align-items: flex-start; gap: 12px;">
              <div style="margin-top: 2px;">
                <input type="checkbox" id="includeVat" name="includeVat" value="true" class="form-check-input" <%= hasVat ? 'checked' : '' %> style="width: 20px; height: 20px; accent-color: var(--primary); cursor: pointer;">
              </div>
              <div>
                <label for="includeVat" style="font-weight: 700; font-size: 0.95rem; cursor: pointer; color: var(--text-primary); display: block; margin-bottom: 2px;">
                  Apply Kenya Value Added Tax (VAT 16%)
                </label>
                <p class="text-xs text-muted" style="margin: 0;">
                  Uncheck this option to make this quotation 0% Tax Exempt.
                </p>
              </div>
            </div>
            <div id="vat-mode-badge">
              <span class="badge <%= hasVat ? 'badge-success' : 'badge-subtle' %>" style="font-weight: 700; font-size: 0.8rem; padding: 4px 10px;">
                <i class="uil <%= hasVat ? 'uil-check-circle' : 'uil-ban' %> mr-1"></i> <%= hasVat ? 'VAT Included (16%)' : 'No VAT (0% Exempt)' %>
              </span>
            </div>
          </div>
        </div>

        <!-- Real-Time Calculation Preview -->
        <div class="invoice-live-summary">
          <div class="live-summary-row">
            <span>Subtotal (Net):</span>
            <strong id="live-subtotal"><%= formatKES(parseFloat(quotation.subtotal || 0)) %></strong>
          </div>
          <div class="live-summary-row" id="live-vat-row">
            <span id="live-vat-label"><%= hasVat ? 'VAT (16% Standard):' : 'VAT (0% Exempt / Zero-Rated):' %></span>
            <strong id="live-vat"><%= hasVat ? formatKES(parseFloat(quotation.tax_amount || 0)) : 'KES 0.00 (Exempt / 0%)' %></strong>
          </div>
          <div class="live-summary-row live-summary-grand">
            <span>Grand Total:</span>
            <strong class="text-primary-color" id="live-grand-total"><%= formatKES(parseFloat(quotation.total_amount || 0)) %></strong>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="notes">Notes to Client</label>
            <textarea class="form-input" id="notes" name="notes" rows="2" placeholder="Any special remarks or delivery schedule..."><%= quotation.notes || '' %></textarea>
          </div>
          <div class="form-group">
            <label class="form-label" for="terms">Terms & Conditions</label>
            <textarea class="form-input" id="terms" name="terms" rows="2"><%= quotation.terms || 'Valid for 30 days. 50% deposit required upon commencement.' %></textarea>
          </div>
        </div>

        <div class="form-actions mt-6" style="display: flex; justify-content: flex-end; gap: 10px; border-top: 1px solid var(--border-color); padding-top: 20px;">
          <a href="/quotations/<%= quotation.id %>" class="btn btn-secondary">Cancel</a>
          <button type="submit" class="btn btn-primary" id="btn-save-quotation">
            <i class="uil uil-save"></i>
            <span><%= (typeof linkedInvoice !== 'undefined' && linkedInvoice) ? 'Save & Sync to Invoice' : 'Save Changes' %></span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
