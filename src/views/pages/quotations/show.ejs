<!-- ═══════════════════════════════════════════════════════════════════
     Quotation Details & Multi-Template Print View
     ═══════════════════════════════════════════════════════════════════ -->

<div class="quotation-detail-page">
  <div class="page-header">
    <div class="page-title-group">
      <a href="/quotations" class="btn btn-sm btn-secondary mb-2">
        <i class="uil uil-arrow-left"></i>
        <span>Back to Quotations</span>
      </a>
      <h1 class="page-title">Quotation <%= quotation.quotation_number %></h1>
      <p class="page-subtitle"><%= quotation.title || 'Official Commercial Estimate' %> &bull; Client: <strong><%= quotation.client_name || 'Valued Client' %></strong></p>
    </div>
    <div class="page-actions">
      <button type="button" class="btn btn-secondary" id="btn-print-quotation" data-action="print">
        <i class="uil uil-print"></i>
        <span>Print Quotation</span>
      </button>

      <% if (quotation.status !== 'CONVERTED') { %>
        <form action="/quotations/<%= quotation.id %>/convert" method="POST" class="inline-block">
          <button type="submit" class="btn btn-primary" id="btn-convert-invoice">
            <i class="uil uil-file-check-alt"></i>
            <span>Convert to Invoice</span>
          </button>
        </form>
      <% } else { %>
        <a href="/invoices/<%= quotation.converted_invoice_id %>" class="btn btn-primary">
          <i class="uil uil-receipt"></i>
          <span>View Converted Invoice</span>
        </a>
      <% } %>
    </div>
  </div>

  <!-- Document Customization Toolbar -->
  <div class="doc-customizer-bar">
    <div class="doc-customizer-section">
      <span class="doc-customizer-label">Design Template:</span>
      <div class="template-selector-group">
        <button type="button" class="template-btn active" data-template="modern">
          <i class="uil uil-layer-group"></i>
          <span>Modern</span>
        </button>
        <button type="button" class="template-btn" data-template="corporate">
          <i class="uil uil-building"></i>
          <span>Corporate</span>
        </button>
        <button type="button" class="template-btn" data-template="classic">
          <i class="uil uil-file-alt"></i>
          <span>Classic</span>
        </button>
        <button type="button" class="template-btn" data-template="creative">
          <i class="uil uil-palette"></i>
          <span>Creative</span>
        </button>
      </div>
    </div>

    <div class="doc-customizer-section">
      <span class="doc-customizer-label">Brand Color:</span>
      <div class="color-swatches-group">
        <button type="button" class="color-swatch active" data-color="#4F46E5" title="Indigo" aria-label="Indigo"></button>
        <button type="button" class="color-swatch" data-color="#059669" title="Emerald" aria-label="Emerald"></button>
        <button type="button" class="color-swatch" data-color="#2563EB" title="Sapphire" aria-label="Sapphire"></button>
        <button type="button" class="color-swatch" data-color="#DC2626" title="Ruby" aria-label="Ruby"></button>
        <button type="button" class="color-swatch" data-color="#D97706" title="Amber" aria-label="Amber"></button>
        <button type="button" class="color-swatch" data-color="#475569" title="Slate" aria-label="Slate"></button>
        <div class="color-picker-wrapper" title="Pick Custom Color">
          <input type="color" class="color-picker-input" value="#4F46E5" aria-label="Custom brand color">
        </div>
      </div>
    </div>
  </div>

  <!-- Quotation Sheet -->
  <div class="quotation-sheet document-sheet template-modern" 
       data-default-template="<%= (typeof tenant !== 'undefined' && tenant && tenant.invoiceTemplate) ? tenant.invoiceTemplate : 'modern' %>"
       data-default-color="<%= (typeof quotation !== 'undefined' && quotation.tenant_primary_color) ? quotation.tenant_primary_color : '#4F46E5' %>">
    
    <!-- Header Row -->
    <div class="invoice-header-row quotation-header-row">
      <div class="invoice-brand-block quotation-brand-block">
        <h2><%= quotation.tenant_name || ((typeof tenant !== 'undefined' && tenant) ? tenant.name : appName) %></h2>
        <div>
          <p><%= quotation.tenant_address || 'Nairobi, Kenya' %></p>
          <p>Email: <%= quotation.tenant_email || 'info@company.co.ke' %></p>
          <p>Phone: <%= quotation.tenant_phone || '+254 700 000 000' %></p>
          <p><strong>KRA PIN:</strong> <%= quotation.tenant_kra_pin || 'P000000000X' %></p>
        </div>
      </div>
      <div class="invoice-meta-block quotation-meta-block">
        <span class="badge <%= quotation.status === 'CONVERTED' ? 'badge-success' : (quotation.status === 'SENT' ? 'badge-info' : (quotation.status === 'REJECTED' ? 'badge-danger' : 'badge-subtle')) %>">
          <span class="badge-dot"></span>
          <%= quotation.status %>
        </span>
        <h3><%= quotation.quotation_number %></h3>
        <p>Issue Date: <%= new Date(quotation.issue_date || quotation.created_at).toLocaleDateString('en-KE', { year: 'numeric', month: 'short', day: 'numeric' }) %></p>
        <p>Valid Until: <%= new Date(quotation.valid_until).toLocaleDateString('en-KE', { year: 'numeric', month: 'short', day: 'numeric' }) %></p>
        <% if (quotation.project_code) { %>
          <p>Project: <strong><%= quotation.project_code %></strong></p>
        <% } %>
      </div>
    </div>

    <!-- Client / Prepared For -->
    <div class="invoice-parties-grid quotation-parties-grid">
      <div class="invoice-party-col quotation-party-col">
        <h4 class="invoice-party-heading">Estimate Prepared For:</h4>
        <h3 class="invoice-party-name"><%= quotation.client_name || 'Valued Client' %></h3>
        <div class="invoice-party-details">
          <% if (quotation.client_address) { %><p><%= quotation.client_address %></p><% } %>
          <% if (quotation.client_city) { %><p><%= quotation.client_city %>, Kenya</p><% } %>
          <% if (quotation.client_email) { %><p>Email: <%= quotation.client_email %></p><% } %>
          <% if (quotation.client_phone) { %><p>Phone: <%= quotation.client_phone %></p><% } %>
          <% if (quotation.client_kra_pin) { %><p><strong>PIN:</strong> <%= quotation.client_kra_pin %></p><% } %>
        </div>
      </div>
    </div>

    <!-- Items Table -->
    <div class="invoice-table-wrapper quotation-table-wrapper">
      <table class="invoice-table quotation-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Item & Service Description</th>
            <th class="text-right">Qty</th>
            <th class="text-right">Unit Price</th>
            <th class="text-right">Tax Rate</th>
            <th class="text-right">Total (KES)</th>
          </tr>
        </thead>
        <tbody>
          <% if (items && items.length > 0) { %>
            <% items.forEach(function(item, idx) { %>
              <tr>
                <td><%= idx + 1 %></td>
                <td>
                  <strong><%= item.description %></strong>
                </td>
                <td class="text-right"><%= item.quantity %></td>
                <td class="text-right"><%= formatKES(parseFloat(item.unit_price)) %></td>
                <td class="text-right"><span class="badge badge-subtle">16% VAT</span></td>
                <td class="text-right font-bold"><%= formatKES(parseFloat(item.line_total || (item.quantity * item.unit_price * 1.16))) %></td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td>1</td>
              <td><strong>General Professional Services & Deliverables</strong></td>
              <td class="text-right">1</td>
              <td class="text-right"><%= formatKES(parseFloat(quotation.subtotal)) %></td>
              <td class="text-right"><span class="badge badge-subtle">16% VAT</span></td>
              <td class="text-right font-bold"><%= formatKES(parseFloat(quotation.total_amount)) %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Totals Area -->
    <div class="invoice-totals-wrapper quotation-totals-wrapper">
      <div class="invoice-totals-box quotation-totals-box">
        <div class="invoice-total-line">
          <span>Subtotal (Net):</span>
          <span><%= formatKES(parseFloat(quotation.subtotal)) %></span>
        </div>
        <div class="invoice-total-line">
          <span>VAT (16% Standard Rate):</span>
          <span><%= formatKES(parseFloat(quotation.tax_amount)) %></span>
        </div>
        <% if (parseFloat(quotation.discount_amount) > 0) { %>
          <div class="invoice-total-line">
            <span>Special Discount:</span>
            <span>- <%= formatKES(parseFloat(quotation.discount_amount)) %></span>
          </div>
        <% } %>
        <div class="invoice-total-line invoice-total-line-grand quotation-total-line-grand">
          <span>Estimated Total:</span>
          <span><%= formatKES(parseFloat(quotation.total_amount)) %></span>
        </div>
      </div>
    </div>

    <!-- Notes & Terms -->
    <% if (quotation.notes || quotation.terms) { %>
      <div class="invoice-notes-terms quotation-notes-terms">
        <% if (quotation.notes) { %>
          <p class="mb-1"><strong>Scope Notes:</strong> <%= quotation.notes %></p>
        <% } %>
        <% if (quotation.terms) { %>
          <p><strong>Quotation Terms & Validity:</strong> <%= quotation.terms %></p>
        <% } %>
      </div>
    <% } %>
  </div>
</div>
