<!-- ═══════════════════════════════════════════════════════════════════
     Organization & System Settings View
     ═══════════════════════════════════════════════════════════════════ -->

<div class="settings-page">
  <div class="page-header">
    <div class="page-title-group">
      <h1 class="page-title">Company & System Settings</h1>
      <p class="page-subtitle">Configure organization profile, KRA eTIMS credentials, invoice formats, and Safaricom Daraja M-Pesa APIs.</p>
    </div>
  </div>

  <form action="/settings" method="POST" class="form-stack">
    <!-- General Profile -->
    <div class="card mb-6">
      <div class="card-header">
        <h3 class="card-title">
          <i class="uil uil-building text-primary"></i>
          <span>1. Company Identity & Contact</span>
        </h3>
        <p class="text-xs text-muted">Primary entity details shown on invoices and client communications</p>
      </div>
      <div class="card-body">
        <div class="form-row mb-4">
          <div class="form-group">
            <label for="name" class="form-label">Legal Business Name *</label>
            <input type="text" id="name" name="name" class="form-input" value="<%= tenant.name %>" required>
          </div>
          <div class="form-group">
            <label for="phone" class="form-label">Official Phone Number</label>
            <input type="text" id="phone" name="phone" class="form-input" value="<%= tenant.phone || '' %>">
          </div>
        </div>

        <div class="form-row-2-1">
          <div class="form-group">
            <label for="address" class="form-label">Physical / Postal Address</label>
            <input type="text" id="address" name="address" class="form-input" value="<%= tenant.address || '' %>">
          </div>
          <div class="form-group">
            <label for="city" class="form-label">City</label>
            <input type="text" id="city" name="city" class="form-input" value="<%= tenant.city || '' %>">
          </div>
        </div>
      </div>
    </div>

    <!-- KRA & eTIMS -->
    <div class="card mb-6">
      <div class="card-header">
        <h3 class="card-title">
          <i class="uil uil-shield-check text-primary"></i>
          <span>2. KRA & eTIMS Tax Compliance</span>
        </h3>
        <p class="text-xs text-muted">Tax registration identifiers for automated fiscal compliance</p>
      </div>
      <div class="card-body">
        <div class="form-row">
          <div class="form-group">
            <label for="kraPin" class="form-label">Entity KRA PIN</label>
            <input type="text" id="kraPin" name="kraPin" class="form-input" value="<%= tenant.kraPin || '' %>" placeholder="e.g. P051234567Z">
          </div>
          <div class="form-group align-end">
            <label class="form-check">
              <input type="checkbox" id="vatRegistered" name="vatRegistered" class="form-check-input" value="true" <%= tenant.vatRegistered ? 'checked' : '' %>>
              <span class="form-check-label">
                <strong>VAT Registered Entity</strong><br>
                <small class="text-xs text-muted">Automatically charge 16% VAT standard rate on invoice line items</small>
              </span>
            </label>
          </div>
        </div>
      </div>
    </div>

    <!-- Invoicing & Billing -->
    <div class="card mb-6">
      <div class="card-header">
        <h3 class="card-title">
          <i class="uil uil-receipt text-primary"></i>
          <span>3. Invoicing & Bank Details</span>
        </h3>
        <p class="text-xs text-muted">Prefixes, default payment terms, and remittance instructions</p>
      </div>
      <div class="card-body">
        <div class="form-row mb-4">
          <div class="form-group">
            <label for="invoicePrefix" class="form-label">Invoice Number Prefix</label>
            <input type="text" id="invoicePrefix" name="invoicePrefix" class="form-input" value="<%= tenant.invoicePrefix || 'INV' %>">
          </div>
          <div class="form-group">
            <label for="quotePrefix" class="form-label">Quotation Number Prefix</label>
            <input type="text" id="quotePrefix" name="quotePrefix" class="form-input" value="<%= tenant.quotePrefix || 'QUO' %>">
          </div>
        </div>

        <div class="form-row mb-4">
          <div class="form-group">
            <label for="invoiceTemplate" class="form-label">Default Document Template</label>
            <select id="invoiceTemplate" name="invoiceTemplate" class="form-select">
              <option value="modern" <%= (tenant.invoiceTemplate || 'modern') === 'modern' ? 'selected' : '' %>>Modern Minimalist (Clean Standard)</option>
              <option value="corporate" <%= tenant.invoiceTemplate === 'corporate' ? 'selected' : '' %>>Corporate Slate (Branded Header Banner)</option>
              <option value="classic" <%= tenant.invoiceTemplate === 'classic' ? 'selected' : '' %>>Classic Formal (Double Framed Border)</option>
              <option value="creative" <%= tenant.invoiceTemplate === 'creative' ? 'selected' : '' %>>Creative Studio (Left Accent Bar & Rounded Badges)</option>
            </select>
            <p class="form-hint">Selected style is preloaded for quotations and invoices.</p>
          </div>
          <div class="form-group">
            <label for="primaryColor" class="form-label">Brand Accent Color</label>
            <div class="color-input-group">
              <input type="color" id="primaryColor" name="primaryColor" class="form-color-picker" value="<%= tenant.primaryColor || '#4F46E5' %>">
              <span class="color-hex-label" id="primaryColorLabel"><%= tenant.primaryColor || '#4F46E5' %></span>
            </div>
            <p class="form-hint">Used for invoice/quotation borders, buttons, and headers.</p>
          </div>
        </div>

        <div class="form-group mb-4">
          <label for="paymentTerms" class="form-label">Default Payment Terms</label>
          <input type="text" id="paymentTerms" name="paymentTerms" class="form-input" value="<%= tenant.paymentTerms || 'Payment due within 30 days from invoice issue date.' %>">
        </div>

        <div class="form-group mb-4">
          <label for="bankDetails" class="form-label">Bank Settlement Account Details</label>
          <textarea id="bankDetails" name="bankDetails" class="form-input" rows="2"><%= tenant.bankDetails || '' %></textarea>
        </div>

        <div class="form-group">
          <label for="invoiceNotes" class="form-label">Standard Footer Notes</label>
          <textarea id="invoiceNotes" name="invoiceNotes" class="form-input" rows="2"><%= tenant.invoiceNotes || '' %></textarea>
        </div>
      </div>
    </div>

    <!-- M-Pesa Daraja Configuration -->
    <div class="card mb-6">
      <div class="card-header">
        <h3 class="card-title">
          <i class="uil uil-mobile-android text-primary"></i>
          <span>4. Safaricom M-Pesa Daraja Gateway</span>
        </h3>
        <p class="text-xs text-muted">STK Push and automated instant payment confirmation</p>
      </div>
      <div class="card-body">
        <div class="form-row-3">
          <div class="form-group">
            <label for="darajaShortcode" class="form-label">Business Shortcode / Till</label>
            <input type="text" id="darajaShortcode" name="darajaShortcode" class="form-input" value="<%= tenant.darajaShortcode || '' %>" placeholder="e.g. 174379">
          </div>
          <div class="form-group">
            <label for="darajaShortcodeType" class="form-label">Shortcode Type</label>
            <select id="darajaShortcodeType" name="darajaShortcodeType" class="form-select">
              <option value="PAYBILL" <%= tenant.darajaShortcodeType === 'PAYBILL' ? 'selected' : '' %>>Paybill</option>
              <option value="TILL" <%= tenant.darajaShortcodeType === 'TILL' ? 'selected' : '' %>>Buy Goods (Till)</option>
            </select>
          </div>
          <div class="form-group">
            <label for="darajaEnvironment" class="form-label">Environment</label>
            <select id="darajaEnvironment" name="darajaEnvironment" class="form-select">
              <option value="sandbox" <%= tenant.darajaEnvironment === 'sandbox' ? 'selected' : '' %>>Sandbox (Testing)</option>
              <option value="production" <%= tenant.darajaEnvironment === 'production' ? 'selected' : '' %>>Production (Live)</option>
            </select>
          </div>
        </div>
      </div>
    </div>

    <!-- Save Button -->
    <div class="form-actions mb-8">
      <button type="submit" class="btn btn-primary" id="btn-save-settings">
        <i class="uil uil-save"></i>
        <span>Save All Settings</span>
      </button>
    </div>
  </form>
</div>
