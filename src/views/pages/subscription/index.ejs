<!-- ═══════════════════════════════════════════════════════════════════
     Tenant Subscription & Billing Management Dashboard
     ═══════════════════════════════════════════════════════════════════ -->

<div class="subscription-page">
  <!-- Page Header -->
  <div class="page-header flex-between mb-6">
    <div class="page-title-group">
      <div class="flex-align-center gap-3">
        <h1 class="page-title">Subscription & Billing</h1>
        <% if (subscriptionExempt) { %>
          <span class="badge badge-success">
            <i class="uil uil-award"></i> Fee Whitelisted (Exempt)
          </span>
        <% } else if (isCancelled) { %>
          <span class="badge badge-danger">
            <i class="uil uil-ban"></i> Subscription Cancelled
          </span>
        <% } else if (isExpired) { %>
          <span class="badge badge-danger">
            <i class="uil uil-exclamation-triangle"></i> Expired
          </span>
        <% } else if (isExpiringSoon) { %>
          <span class="badge badge-warning">
            <i class="uil uil-clock"></i> Expiring Soon (<%= daysRemaining %>d left)
          </span>
        <% } else { %>
          <span class="badge badge-success">
            <i class="uil uil-check-circle"></i> Active
          </span>
        <% } %>
      </div>
      <p class="page-subtitle">Manage your organization's subscription package, isolated storage quotas, and renewal billing invoices.</p>
    </div>

    <div class="header-actions" style="display: flex; align-items: center; gap: 10px;">
      <% if (subscriptionExempt) { %>
        <span class="badge badge-subtle" style="padding: 8px 14px; font-size: 0.85rem;">
          <i class="uil uil-shield-check text-success"></i> Whitelisted by Administrator
        </span>
      <% } else if (isCancelled || isExpired) { %>
        <a href="/subscription/pay" class="btn btn-primary" id="btn-renew-top">
          <i class="uil uil-sync"></i>
          <span><%= isCancelled ? 'Reactivate Subscription' : 'Settle Renewal & Reactivate' %></span>
        </a>
      <% } else { %>
        <a href="/subscription/pay" class="btn btn-secondary" id="btn-extend-top">
          <i class="uil uil-sync"></i>
          <span>Extend Subscription</span>
        </a>
        <button type="button" class="btn btn-outline-danger" id="btn-cancel-subscription" onclick="openCancelModal()">
          <i class="uil uil-times-circle"></i>
          <span>Cancel Subscription</span>
        </button>
      <% } %>
    </div>
  </div>

  <!-- Subscription Status Alerts -->
  <% if (subscriptionExempt) { %>
    <div class="alert alert-success mb-6" style="border-left: 4px solid var(--success); padding: 18px 22px; border-radius: var(--radius-md); background: #ecfdf5;">
      <div class="flex-between">
        <div class="flex-align-center gap-3">
          <i class="uil uil-shield-check text-success" style="font-size: 2rem;"></i>
          <div>
            <h3 style="font-weight: 700; color: #065f46; margin: 0 0 4px 0; font-size: 1.05rem;">
              Complimentary Platform Access &bull; Monthly Fee Whitelisted
            </h3>
            <p style="margin: 0; color: #047857; font-size: 0.9rem;">
              Your organization account is whitelisted by the platform administrator. You are exempt from recurring monthly subscription fees and retain unrestricted platform functionality.
            </p>
          </div>
        </div>
      </div>
    </div>
  <% } else if (isCancelled) { %>
    <div class="alert alert-danger mb-6" style="border-left: 4px solid var(--danger); padding: 18px 22px; border-radius: var(--radius-md); background: #fef2f2;">
      <div class="flex-between">
        <div class="flex-align-center gap-3">
          <i class="uil uil-ban text-danger" style="font-size: 2rem;"></i>
          <div>
            <h3 style="font-weight: 700; color: #991b1b; margin: 0 0 4px 0; font-size: 1.05rem;">
              Subscription Cancelled — Account Restricted
            </h3>
            <p style="margin: 0; color: #7f1d1d; font-size: 0.9rem;">
              Your organization's subscription has been cancelled. Creating new transactions (invoices, quotations, expenses) and printing or downloading invoices and quotations is restricted until renewed.
            </p>
          </div>
        </div>
        <a href="/subscription/pay" class="btn btn-danger" style="white-space: nowrap;">
          <i class="uil uil-sync"></i> Renew & Reactivate
        </a>
      </div>
    </div>
  <% } else if (isExpired) { %>
    <div class="alert alert-danger mb-6" style="border-left: 4px solid var(--danger); padding: 18px 22px; border-radius: var(--radius-md); background: #fef2f2;">
      <div class="flex-between">
        <div class="flex-align-center gap-3">
          <i class="uil uil-exclamation-octagon text-danger" style="font-size: 2rem;"></i>
          <div>
            <h3 style="font-weight: 700; color: #991b1b; margin: 0 0 4px 0; font-size: 1.05rem;">
              Subscription Expired — Workspace Access Restricted
            </h3>
            <p style="margin: 0; color: #7f1d1d; font-size: 0.9rem;">
              Your subscription reached its renewal date. To continue uninterrupted project execution and invoicing, please settle your renewal invoice below.
            </p>
          </div>
        </div>
        <a href="/subscription/pay" class="btn btn-danger" style="white-space: nowrap;">
          <i class="uil uil-lock-open-alt"></i> Settle & Unlock Workspace
        </a>
      </div>
    </div>
  <% } else if (isExpiringSoon) { %>
    <div class="alert alert-warning mb-6" style="border-left: 4px solid #f59e0b; padding: 18px 22px; border-radius: var(--radius-md); background: #fffbeb;">
      <div class="flex-between">
        <div class="flex-align-center gap-3">
          <i class="uil uil-clock-three text-warning" style="font-size: 2rem;"></i>
          <div>
            <h3 style="font-weight: 700; color: #92400e; margin: 0 0 4px 0; font-size: 1.05rem;">
              <%= daysRemaining === 1 ? 'Subscription Expires Tomorrow / Today!' : `Subscription Expires in ${daysRemaining} Days` %>
            </h3>
            <p style="margin: 0; color: #78350f; font-size: 0.9rem;">
              You will receive daily email reminders during the final 3 days. Renew now via M-Pesa or Card to avoid automatic deactivation.
            </p>
          </div>
        </div>
        <a href="/subscription/pay" class="btn btn-primary" style="white-space: nowrap; background: #d97706; border-color: #d97706;">
          <i class="uil uil-credit-card"></i> Settle Early Renewal
        </a>
      </div>
    </div>
  <% } %>

  <!-- Overview Summary Grid -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-bottom: 24px;">
    <!-- Active Package Details -->
    <div class="card">
      <div class="card-header flex-between">
        <h3 class="card-title">
          <i class="uil uil-layer-group text-primary"></i>
          <span>Active Package</span>
        </h3>
        <% if (subscription) { %>
          <span class="badge badge-subtle"><%= subscription.plan_tier %></span>
        <% } %>
      </div>
      <div class="card-body">
        <% if (subscription) { %>
          <div style="margin-bottom: 16px;">
            <div style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary);"><%= subscription.plan_name %></div>
            <div style="font-size: 1.15rem; font-weight: 700; color: var(--primary); margin-top: 4px;">
              <%= formatKES(subscription.plan_price) %> 
              <span style="font-size: 0.85rem; font-weight: 500; color: var(--text-muted);">/ <%= subscription.plan_frequency ? subscription.plan_frequency.toLowerCase() : 'billing period' %></span>
            </div>
          </div>

          <div style="display: flex; flex-direction: column; gap: 8px; font-size: 0.88rem; border-top: 1px solid var(--border-color); padding-top: 12px;">
            <div class="flex-between">
              <span class="text-muted">Status:</span>
              <strong><%= subscription.subscription_status %></strong>
            </div>
            <div class="flex-between">
              <span class="text-muted">Fee Exemption:</span>
              <span><%= subscriptionExempt ? 'Whitelisted (Active)' : 'Standard' %></span>
            </div>
            <div class="flex-between">
              <span class="text-muted">Auto-Renew:</span>
              <span><%= subscription.auto_renew ? 'Enabled' : 'Disabled' %></span>
            </div>
            <% if (subscription.mpesa_receipt_no) { %>
              <div class="flex-between">
                <span class="text-muted">Last Reference:</span>
                <span style="font-family: monospace; font-size: 0.82rem;"><%= subscription.mpesa_receipt_no %></span>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <p class="text-muted">No active subscription found. Please select a plan below.</p>
        <% } %>
      </div>
    </div>

    <!-- Billing Period & Countdown -->
    <div class="card">
      <div class="card-header flex-between">
        <h3 class="card-title">
          <i class="uil uil-calendar-alt text-primary"></i>
          <span>Billing Period</span>
        </h3>
        <% if (subscriptionExempt) { %>
          <span class="badge badge-success">Whitelisted</span>
        <% } else { %>
          <span class="badge <%= isCancelled ? 'badge-danger' : (isExpired ? 'badge-danger' : (isExpiringSoon ? 'badge-warning' : 'badge-success')) %>">
            <%= isCancelled ? 'Cancelled' : (isExpired ? 'Lapsed' : `${daysRemaining} Days Left`) %>
          </span>
        <% } %>
      </div>
      <div class="card-body">
        <% if (subscription && subscription.current_period_end) { %>
          <div style="margin-bottom: 16px;">
            <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 4px;">
              <%= subscriptionExempt ? 'Account Status:' : 'Expires / Renews On:' %>
            </div>
            <div class="<%= (isCancelled || isExpired) ? 'text-danger' : '' %>" style="font-size: 1.25rem; font-weight: 700;">
              <% if (subscriptionExempt) { %>
                Indefinite (Whitelisted)
              <% } else { %>
                <%= new Date(subscription.current_period_end).toLocaleDateString('en-KE', { dateStyle: 'full' }) %>
              <% } %>
            </div>
            <div style="font-size: 0.82rem; color: var(--text-muted); margin-top: 2px;">
              Period Started: <%= new Date(subscription.current_period_start).toLocaleDateString() %>
            </div>
          </div>

          <!-- Progress Bar of Time -->
          <div style="background: var(--bg-tertiary, #f1f5f9); border-radius: 999px; height: 8px; overflow: hidden; margin: 12px 0 6px 0;">
            <% 
              let progressPercent = 0;
              if (subscription.current_period_start && subscription.current_period_end) {
                const totalDuration = new Date(subscription.current_period_end).getTime() - new Date(subscription.current_period_start).getTime();
                const elapsed = Date.now() - new Date(subscription.current_period_start).getTime();
                progressPercent = Math.min(100, Math.max(0, Math.round((elapsed / totalDuration) * 100)));
              }
              const cycleFillWidth = subscriptionExempt ? 100 : progressPercent;
              const cycleBarClass = (isCancelled || isExpired) ? 'bg-danger' : (isExpiringSoon ? 'bg-warning' : 'bg-primary');
            %>
            <div class="<%= cycleBarClass %>" style="width: <%= cycleFillWidth %>%; height: 100%;"></div>
          </div>
          <div class="flex-between text-xs text-muted">
            <span>Cycle progress: <%= subscriptionExempt ? '100%' : `${progressPercent}%` %></span>
            <span><%= subscriptionExempt ? 'Never expires' : (isCancelled ? 'Cancelled' : (isExpired ? 'Expired' : `${daysRemaining} days remaining`)) %></span>
          </div>
        <% } else { %>
          <p class="text-muted">Subscription dates pending activation.</p>
        <% } %>
      </div>
    </div>

    <!-- Quotas & Resource Utilization -->
    <div class="card">
      <div class="card-header flex-between">
        <h3 class="card-title">
          <i class="uil uil-tachometer-fast-alt text-primary"></i>
          <span>Resource Limits</span>
        </h3>
        <span class="text-xs text-muted">Workspace Limits</span>
      </div>
      <div class="card-body" style="display: flex; flex-direction: column; gap: 14px;">
        <!-- Users -->
        <div>
          <div class="flex-between text-xs" style="margin-bottom: 4px;">
            <span class="text-muted"><i class="uil uil-users-alt"></i> Team Members:</span>
            <strong><%= usage.usersCount %> / <%= subscription ? subscription.max_users : 0 %></strong>
          </div>
          <% const userPct = subscription && subscription.max_users ? Math.min(100, Math.round((usage.usersCount / subscription.max_users) * 100)) : 0; %>
          <div style="background: var(--bg-tertiary, #f1f5f9); border-radius: 999px; height: 6px; overflow: hidden;">
            <div class="<%= userPct >= 90 ? 'bg-danger' : 'bg-primary' %>" style="width: <%= userPct %>%; height: 100%;"></div>
          </div>
        </div>

        <!-- Projects -->
        <div>
          <div class="flex-between text-xs" style="margin-bottom: 4px;">
            <span class="text-muted"><i class="uil uil-folder"></i> Active Projects:</span>
            <strong><%= usage.projectsCount %> / <%= subscription ? subscription.max_projects : 0 %></strong>
          </div>
          <% const projPct = subscription && subscription.max_projects ? Math.min(100, Math.round((usage.projectsCount / subscription.max_projects) * 100)) : 0; %>
          <div style="background: var(--bg-tertiary, #f1f5f9); border-radius: 999px; height: 6px; overflow: hidden;">
            <div class="<%= projPct >= 90 ? 'bg-danger' : 'bg-primary' %>" style="width: <%= projPct %>%; height: 100%;"></div>
          </div>
        </div>

        <!-- Storage Summary -->
        <div>
          <div class="flex-between text-xs" style="margin-bottom: 4px;">
            <span class="text-muted"><i class="uil uil-hard-drive"></i> Allocated Storage:</span>
            <strong><%= storageMetrics.usedMb %> MB / <%= storageMetrics.allocatedMb %> MB</strong>
          </div>
          <% const summaryStorageClass = storageMetrics.percentUsed >= 90 ? 'bg-danger' : (storageMetrics.percentUsed >= 75 ? 'bg-warning' : 'bg-primary'); %>
          <div style="background: var(--bg-tertiary, #f1f5f9); border-radius: 999px; height: 6px; overflow: hidden;">
            <div class="<%= summaryStorageClass %>" style="width: <%= storageMetrics.percentUsed %>%; height: 100%;"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Storage & Quota Monitoring Card -->
  <div class="card mb-6" style="border: 1px solid var(--border-color); overflow: hidden;">
    <div class="card-header flex-between">
      <div class="flex-align-center gap-2">
        <i class="uil uil-hard-drive text-primary" style="font-size: 1.3rem;"></i>
        <div>
          <h3 class="card-title" style="font-size: 1.05rem;">Storage & Cloud Quota Monitoring</h3>
          <p class="text-xs text-muted">Real-time tracking of file storage consumed against your subscription plan quota</p>
        </div>
      </div>
      <div class="flex-align-center gap-2">
        <% if (storageMetrics.isOverQuota) { %>
          <span class="badge badge-danger">
            <i class="uil uil-exclamation-triangle"></i> Quota Exceeded
          </span>
        <% } else if (storageMetrics.percentUsed >= 80) { %>
          <span class="badge badge-warning">
            <i class="uil uil-info-circle"></i> Approaching Limit (<%= storageMetrics.percentUsed %>%)
          </span>
        <% } else { %>
          <span class="badge badge-success">
            <i class="uil uil-check-circle"></i> Quota Healthy
          </span>
        <% } %>
      </div>
    </div>
    <div class="card-body" style="padding: 24px;">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; align-items: center;">
        <!-- Left: Storage Metrics & Progress -->
        <div>
          <div style="display: flex; align-items: baseline; gap: 8px; margin-bottom: 6px;">
            <span style="font-size: 2.2rem; font-weight: 800; color: var(--text-primary);"><%= storageMetrics.usedMb %></span>
            <span style="font-size: 1.1rem; color: var(--text-muted); font-weight: 600;">/ <%= storageMetrics.allocatedMb %> MB Allocated</span>
          </div>
          <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 12px;">
            <strong><%= storageMetrics.percentUsed %>%</strong> of your subscription quota consumed &bull; <strong><%= storageMetrics.remainingMb %> MB</strong> available.
          </p>

          <% const storageFillClass = storageMetrics.isOverQuota ? 'bg-danger' : (storageMetrics.percentUsed >= 80 ? 'bg-warning' : 'bg-primary'); %>
          <div style="background: var(--bg-tertiary, #f1f5f9); border-radius: 999px; height: 10px; overflow: hidden; margin-bottom: 16px;">
            <div class="<%= storageFillClass %>" style="width: <%= storageMetrics.percentUsed %>%; height: 100%;"></div>
          </div>

          <div style="display: flex; gap: 16px; font-size: 0.82rem; color: var(--text-muted);">
            <div class="flex-align-center gap-1">
              <i class="uil uil-file-alt text-primary"></i>
              <span><strong><%= storageMetrics.documentCount %></strong> Uploaded Files & Assets</span>
            </div>
            <div class="flex-align-center gap-1">
              <i class="uil uil-shield-check text-success"></i>
              <span>Encrypted & Isolated</span>
            </div>
          </div>
        </div>

        <!-- Right: Client-facing High-Level Stat Tiles -->
        <div class="storage-stat-grid">
          <div class="storage-stat-tile">
            <span class="storage-stat-label">Allocated Quota</span>
            <span class="storage-stat-value"><%= storageMetrics.allocatedMb %> MB</span>
          </div>
          <div class="storage-stat-tile">
            <span class="storage-stat-label">Used Space</span>
            <span class="storage-stat-value" style="color: var(--primary);"><%= storageMetrics.usedMb %> MB</span>
          </div>
          <div class="storage-stat-tile">
            <span class="storage-stat-label">Free Space</span>
            <span class="storage-stat-value" style="color: var(--success);"><%= storageMetrics.remainingMb %> MB</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Available Subscription Plans Section -->
  <div class="card mb-6">
    <div class="card-header flex-between">
      <div>
        <h2 class="card-title">Available Subscription Packages</h2>
        <p class="text-xs text-muted">Upgrade or switch plans as your project management and organizational requirements scale.</p>
      </div>
      <span class="badge badge-subtle">
        <i class="uil uil-sliders-v"></i> Change Package Anytime
      </span>
    </div>
    <div class="card-body">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
        <% availablePlans.forEach(function(plan) { %>
          <% const isCurrentPlan = subscription && subscription.plan_id === plan.id; %>
          <div class="<%= isCurrentPlan ? 'plan-card-active' : 'plan-card-standard' %>" style="border-radius: var(--radius-lg, 12px); padding: 24px; position: relative; display: flex; flex-direction: column; justify-content: space-between; background: var(--bg-secondary, #ffffff);">
            <% if (isCurrentPlan) { %>
              <div style="position: absolute; top: -12px; right: 20px; background: var(--primary); color: white; padding: 2px 12px; border-radius: 999px; font-size: 0.72rem; font-weight: 700; text-transform: uppercase;">
                Current Plan
              </div>
            <% } %>

            <div>
              <div class="flex-between mb-2">
                <h3 style="margin: 0; font-size: 1.25rem; font-weight: 700;"><%= plan.name %></h3>
                <span class="badge badge-subtle"><%= plan.tier %></span>
              </div>

              <div style="font-size: 1.75rem; font-weight: 800; color: var(--primary); margin-bottom: 8px;">
                <%= formatKES(plan.price) %>
                <span style="font-size: 0.85rem; font-weight: 500; color: var(--text-muted);">/ <%= plan.frequency ? plan.frequency.toLowerCase() : 'period' %></span>
              </div>

              <% if (plan.description) { %>
                <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 16px; line-height: 1.4;"><%= plan.description %></p>
              <% } %>

              <div style="border-top: 1px solid var(--border-color); padding-top: 16px; margin-top: 12px; display: flex; flex-direction: column; gap: 10px; font-size: 0.85rem;">
                <div class="flex-align-center gap-2">
                  <i class="uil uil-check-circle text-success"></i>
                  <span>Up to <strong><%= plan.maxUsers %></strong> Team Users</span>
                </div>
                <div class="flex-align-center gap-2">
                  <i class="uil uil-check-circle text-success"></i>
                  <span>Up to <strong><%= plan.maxProjects %></strong> Active Projects</span>
                </div>
                <div class="flex-align-center gap-2">
                  <i class="uil uil-check-circle text-success"></i>
                  <span><strong><%= plan.maxStorageMb %> MB</strong> Dedicated Cloud & Local Storage</span>
                </div>
                <div class="flex-align-center gap-2">
                  <i class="uil uil-check-circle text-success"></i>
                  <span>KRA eTIMS & Invoicing Compliant</span>
                </div>
                <div class="flex-align-center gap-2">
                  <i class="uil uil-check-circle text-success"></i>
                  <span>M-Pesa STK & Online Client Portal</span>
                </div>
              </div>
            </div>

            <div style="margin-top: 24px;">
              <% if (isCurrentPlan) { %>
                <a href="/subscription/pay" class="btn btn-block btn-outline" style="font-weight: 700;">
                  <i class="uil uil-sync"></i> Renew / Extend
                </a>
              <% } else { %>
                <form action="/subscription/change-plan" method="POST">
                  <input type="hidden" name="planId" value="<%= plan.id %>">
                  <button type="submit" class="btn btn-block btn-primary">
                    <i class="uil uil-arrow-circle-right"></i> Switch to <%= plan.name %>
                  </button>
                </form>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </div>

  <!-- Subscription Billing & Invoices History Table -->
  <div class="card mb-6">
    <div class="card-header flex-between">
      <div>
        <h2 class="card-title">Billing & Invoices History</h2>
        <span class="text-xs text-muted">All subscription renewal invoices and verification references</span>
      </div>
      <span class="badge badge-subtle">
        <%= invoices ? invoices.length : 0 %> Record(s)
      </span>
    </div>
    <div class="card-body-table">
      <% if (invoices && invoices.length > 0) { %>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Invoice Number</th>
                <th>Plan Tier</th>
                <th>Period</th>
                <th>Due Date</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Payment Reference</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% invoices.forEach(function(inv) { %>
                <tr>
                  <td>
                    <strong><%= inv.invoice_number %></strong>
                    <br><small class="text-muted"><%= new Date(inv.created_at).toLocaleDateString() %></small>
                  </td>
                  <td>
                    <span class="badge badge-subtle"><%= inv.plan_name || 'Standard' %></span>
                  </td>
                  <td>
                    <small>
                      <%= new Date(inv.billing_period_start).toLocaleDateString() %> &rarr;
                      <%= new Date(inv.billing_period_end).toLocaleDateString() %>
                    </small>
                  </td>
                  <td><%= new Date(inv.due_date).toLocaleDateString() %></td>
                  <td>
                    <strong style="font-size: 0.95rem; color: var(--primary);">
                      <%= formatKES(inv.total_amount) %>
                    </strong>
                  </td>
                  <td>
                    <% if (inv.status === 'PAID') { %>
                      <span class="badge badge-success">
                        <i class="uil uil-check-circle"></i> PAID
                      </span>
                    <% } else { %>
                      <span class="badge badge-danger">
                        <i class="uil uil-clock"></i> UNPAID
                      </span>
                    <% } %>
                  </td>
                  <td>
                    <% if (inv.payment_reference) { %>
                      <span style="font-family: monospace; font-size: 0.82rem; font-weight: 700; color: var(--success);">
                        <%= inv.payment_reference %>
                      </span>
                      <% if (inv.payment_method) { %>
                        <br><small class="text-muted"><%= inv.payment_method %></small>
                      <% } %>
                    <% } else { %>
                      <span class="text-muted">—</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (inv.status === 'UNPAID') { %>
                      <a href="/subscription/pay" class="btn btn-sm btn-primary">
                        <i class="uil uil-credit-card"></i> Pay Now
                      </a>
                    <% } else { %>
                      <button type="button" class="btn btn-sm btn-secondary" onclick="window.print()" title="Print Receipt">
                        <i class="uil uil-print"></i> Receipt
                      </button>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state p-6">
          <div class="empty-state-icon"><i class="uil uil-receipt"></i></div>
          <p class="empty-state-title">No billing invoices issued yet</p>
          <p class="empty-state-message">Subscription invoices will automatically appear here as billing periods renew.</p>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Dedicated Platform Customer Support Banner -->
  <div class="support-banner-card">
    <div class="support-banner-body">
      <div class="flex-align-center gap-3">
        <div class="support-banner-icon">
          <i class="uil uil-headset"></i>
        </div>
        <div>
          <h4 class="support-banner-title">Need Subscription or Technical Support?</h4>
          <p class="support-banner-desc">
            Our support engineers are available to assist with custom storage quota expansions, billing reconciliation, and integrations.
          </p>
        </div>
      </div>
      <div class="flex-align-center gap-2">
        <a href="mailto:support@freestylecodetechnologies.com" class="support-email-btn">
          <i class="uil uil-envelope-alt"></i>
          <span>support@freestylecodetechnologies.com</span>
        </a>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════
     Cancel Subscription Confirmation Modal
     ═══════════════════════════════════════════════════════════════════ -->
<div id="modalCancelSubscription" class="modal-backdrop" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.65); backdrop-filter: blur(4px); z-index: 1050; align-items: center; justify-content: center; padding: 20px;">
  <div class="card" style="width: 100%; max-width: 500px; margin: auto; box-shadow: var(--shadow-xl); border: 1px solid var(--border-color);">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding: 18px 22px;">
      <h3 class="card-title text-danger" style="margin: 0; display: flex; align-items: center; gap: 8px;">
        <i class="uil uil-exclamation-triangle text-danger"></i>
        <span>Cancel Organization Subscription</span>
      </h3>
      <button type="button" class="btn btn-sm btn-subtle" onclick="closeCancelModal()" style="border: none; background: transparent; font-size: 1.2rem; cursor: pointer;">
        <i class="uil uil-times"></i>
      </button>
    </div>

    <form action="/subscription/cancel" method="POST" style="padding: 22px;">
      <p style="margin-bottom: 14px; font-size: 0.92rem; color: var(--text-secondary); line-height: 1.5;">
        Are you sure you want to cancel your organization's subscription?
      </p>

      <div class="alert alert-warning mb-4" style="font-size: 0.85rem; padding: 14px; border-radius: 8px; background: #fffbeb; border: 1px solid #fde68a; color: #92400e;">
        <strong>Important Business Restrictions:</strong> Once cancelled:
        <ul style="margin: 8px 0 0 18px; padding: 0; display: flex; flex-direction: column; gap: 4px;">
          <li>You cannot create new transactions (invoices, quotations, expenses).</li>
          <li>You cannot download or print existing invoices and quotations.</li>
          <li>All your files and records remain safely stored in your dedicated folder.</li>
          <li>You can reactivate your account at any time by paying your renewal.</li>
        </ul>
      </div>

      <div class="form-group mb-4">
        <label for="cancellationReason" class="form-label">Reason for Cancellation (Optional)</label>
        <textarea id="cancellationReason" name="reason" class="form-textarea" rows="2" placeholder="Tell us how we can improve our services..."></textarea>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px; border-top: 1px solid var(--border-color); padding-top: 16px;">
        <button type="button" class="btn btn-secondary" onclick="closeCancelModal()">Keep My Subscription</button>
        <button type="submit" class="btn btn-danger">
          <i class="uil uil-ban"></i>
          <span>Confirm Cancellation</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function openCancelModal() {
    const modal = document.getElementById('modalCancelSubscription');
    if (modal) modal.style.display = 'flex';
  }
  function closeCancelModal() {
    const modal = document.getElementById('modalCancelSubscription');
    if (modal) modal.style.display = 'none';
  }
  window.addEventListener('click', function(e) {
    const modal = document.getElementById('modalCancelSubscription');
    if (modal && e.target === modal) closeCancelModal();
  });
</script>
