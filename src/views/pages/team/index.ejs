<!-- ═══════════════════════════════════════════════════════════════════
     Team Directory View
     ═══════════════════════════════════════════════════════════════════ -->

<div class="team-page">
  <div class="page-header">
    <div class="page-title-group">
      <h1 class="page-title">Team & Workforce</h1>
      <p class="page-subtitle">Manage project team members, assign RBAC access roles, and track hourly rates.</p>
    </div>
    <div class="page-actions">
      <a href="/team/new" class="btn btn-primary" id="btn-add-member">
        <i class="uil uil-plus"></i>
        <span>Add Member</span>
      </a>
    </div>
  </div>

  <!-- Search & Date Filter Section -->
  <div class="search-filter-section">
    <form action="/team" method="GET" class="filter-form">
      <div class="search-input-wrapper">
        <i class="uil uil-search"></i>
        <input type="text" name="q" class="form-input" placeholder="Search team member name, email, phone, or role..." value="<%= (typeof filters !== 'undefined' && filters.search) ? filters.search : '' %>">
      </div>

      <div class="date-filter-group">
        <div class="date-filter-item">
          <span>From:</span>
          <input type="date" name="startDate" class="form-input" placeholder="e.g. 2026-09-01" value="<%= (typeof filters !== 'undefined' && filters.startDate) ? filters.startDate : '' %>">
        </div>
        <div class="date-filter-item">
          <span>To:</span>
          <input type="date" name="endDate" class="form-input" placeholder="e.g. 2026-09-30" value="<%= (typeof filters !== 'undefined' && filters.endDate) ? filters.endDate : '' %>">
        </div>
      </div>

      <div class="filter-status-wrapper">
        <select name="role" class="form-select form-select-sm">
          <option value="">All Roles</option>
          <option value="TENANT_OWNER" <%= (typeof filters !== 'undefined' && filters.role === 'TENANT_OWNER') ? 'selected' : '' %>>Tenant Owner</option>
          <option value="PROJECT_MANAGER" <%= (typeof filters !== 'undefined' && filters.role === 'PROJECT_MANAGER') ? 'selected' : '' %>>Project Manager</option>
          <option value="ACCOUNTANT" <%= (typeof filters !== 'undefined' && filters.role === 'ACCOUNTANT') ? 'selected' : '' %>>Accountant</option>
          <option value="TEAM_MEMBER" <%= (typeof filters !== 'undefined' && filters.role === 'TEAM_MEMBER') ? 'selected' : '' %>>Team Member</option>
          <option value="CLIENT_VIEWER" <%= (typeof filters !== 'undefined' && filters.role === 'CLIENT_VIEWER') ? 'selected' : '' %>>Client Viewer</option>
        </select>
      </div>

      <div class="filter-actions">
        <button type="submit" class="btn btn-sm btn-primary">
          <i class="uil uil-filter"></i>
          <span>Filter</span>
        </button>
        <% if (typeof filters !== 'undefined' && (filters.search || filters.startDate || filters.endDate || filters.role)) { %>
          <a href="/team" class="btn btn-sm btn-secondary" title="Clear all filters">
            <i class="uil uil-times"></i>
            <span>Clear</span>
          </a>
        <% } %>
      </div>
    </form>
  </div>

  <div class="card mb-6">
    <div class="card-header">
      <div class="card-title-group">
        <div class="card-title-icon">
          <i class="uil uil-users-alt"></i>
        </div>
        <div>
          <div class="flex-align-center gap-2">
            <h2 class="card-title">Active Team Members</h2>
            <span class="badge badge-subtle"><%= members ? members.length : 0 %> Members</span>
          </div>
          <p class="card-subtitle">All registered staff, specialists, engineers, and project leads</p>
        </div>
      </div>
      <div class="flex-align-center gap-2">
        <button class="btn btn-sm btn-primary" id="btn-open-invite-modal">
          <i class="uil uil-user-plus"></i>
          <span>Invite Member</span>
        </button>
      </div>
    </div>
    <div class="card-body-table">
      <div class="table-scroll-hint">Swipe horizontally to view all columns &rarr;</div>
      <% if (members && members.length > 0) { %>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Member</th>
                <th>Email</th>
                <th>Role</th>
                <th>Project Scope</th>
                <th>Phone</th>
                <th>Hourly Rate</th>
                <th>M-Pesa</th>
                <th>Status</th>
                <th class="text-right" style="min-width: 130px;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% members.forEach(function(m) { %>
                <tr>
                  <td>
                    <div class="flex-align-center gap-3">
                      <div class="avatar-circle">
                        <%= m.first_name.charAt(0) + m.last_name.charAt(0) %>
                      </div>
                      <div>
                        <strong><%= m.first_name %> <%= m.last_name %></strong>
                        <% if (m.tenant_name) { %>
                          <div class="text-xs text-muted"><%= m.tenant_name %></div>
                        <% } %>
                      </div>
                    </div>
                  </td>
                  <td><%= m.email %></td>
                  <td>
                    <% if (m.role === 'SUPER_ADMIN' || m.role === 'TENANT_OWNER') { %>
                      <span class="badge badge-primary"><%= m.role.replace(/_/g, ' ') %></span>
                    <% } else if (m.role === 'PROJECT_MANAGER') { %>
                      <span class="badge badge-info">Project Manager</span>
                    <% } else if (m.role === 'ACCOUNTANT') { %>
                      <span class="badge badge-warning">Accountant</span>
                    <% } else { %>
                      <span class="badge badge-subtle"><%= m.role.replace(/_/g, ' ') %></span>
                    <% } %>
                  </td>
                  <td>
                    <% if (m.project_scope === 'ASSIGNED') { %>
                      <span class="badge badge-warning" title="Strictly restricted to assigned projects and associated items">
                        <i class="uil uil-lock-alt"></i> Assigned
                      </span>
                    <% } else { %>
                      <span class="badge badge-subtle" title="Can view all organization projects">
                        <i class="uil uil-globe"></i> All Projects
                      </span>
                    <% } %>
                  </td>
                  <td><%= m.phone || '—' %></td>
                  <td><%= m.hourly_rate ? formatKES(parseFloat(m.hourly_rate)) + '/hr' : '—' %></td>
                  <td><%= m.mpesa_number || '—' %></td>
                  <td>
                    <% if (m.is_active) { %>
                      <span class="badge badge-success"><span class="badge-dot"></span>Active</span>
                    <% } else { %>
                      <span class="badge badge-danger">Inactive</span>
                    <% } %>
                  </td>
                  <td class="text-right">
                    <div class="table-actions-group flex-align-center justify-end gap-1">
                      <a href="/team/<%= m.id %>/edit" class="btn btn-xs btn-outline-primary" title="Configure permissions & details">
                        <i class="uil uil-edit"></i>
                        <span>Edit</span>
                      </a>
                      <form action="/team/<%= m.id %>/toggle-status" method="POST" style="display: inline-block; margin: 0;">
                        <% if (m.is_active) { %>
                          <button type="submit" class="btn btn-xs btn-outline-danger" title="Deactivate account" onclick="return confirm('Deactivate <%= m.first_name %> <%= m.last_name %>? They will no longer be able to log in.')">
                            <i class="uil uil-user-times"></i>
                          </button>
                        <% } else { %>
                          <button type="submit" class="btn btn-xs btn-outline-success" title="Activate account" onclick="return confirm('Re-activate <%= m.first_name %> <%= m.last_name %>?')">
                            <i class="uil uil-user-check"></i>
                          </button>
                        <% } %>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <% if (typeof pagination !== 'undefined' && pagination) { %>
          <%- include('../../partials/pagination') %>
        <% } %>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-state-icon">
            <i class="uil uil-users-alt"></i>
          </div>
          <h4 class="empty-state-title">No team members found</h4>
          <p class="empty-state-text">Click "Add Member" above to onboard employees or contractors.</p>
        </div>
      <% } %>
    </div>
  </div>

  <% if (payouts && payouts.length > 0) { %>
    <div class="card">
      <div class="card-header card-header-flex">
        <div>
          <h3 class="card-title">Disbursement & Wage History</h3>
          <p class="text-xs text-muted">Recent mobile money wages and reimbursements</p>
        </div>
        <span class="badge badge-subtle"><%= payouts.length %> Payouts</span>
      </div>
      <div class="card-body-table">
        <div class="table-scroll-hint">Swipe horizontally to view all columns &rarr;</div>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Member</th>
                <th>Disbursement Type</th>
                <th>M-Pesa Number</th>
                <th>Date</th>
                <th>Amount</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% payouts.forEach(function(p) { %>
                <tr>
                  <td><strong><%= p.first_name %> <%= p.last_name %></strong></td>
                  <td><span class="badge badge-subtle"><%= p.payout_type %></span></td>
                  <td><%= p.mpesa_number || p.mpesa_recipient_number || '—' %></td>
                  <td><%= new Date(p.payout_date).toLocaleDateString() %></td>
                  <td class="font-bold"><%= formatKES(parseFloat(p.amount)) %></td>
                  <td><span class="badge badge-success"><%= p.status %></span></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% } %>
</div>
